# deploy/.env -> symlink to /var/www/banjaramatch-shared/env/deploy.env (600, never committed)
# Read as data by webhook-listener.js, notify.sh, backup.sh; never sourced.
# GitHub webhook secret; node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
# listener binds 127.0.0.1:4003 (nginx www /deploy-webhook)
WEBHOOK_PORT=4003
# nightly backups kept under SHARED/backups
BACKUP_RETENTION_DAYS=14
# mongo archive size floor (the DB dumps to ~370 KB gzipped today)
BACKUP_MIN_BYTES=262144
# optional: deploy/backup/uptime alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: alerts by email via the API's SMTP_* (notify-mail.js)
ALERT_EMAIL=
# optional: remote:bucket/path for an off-box copy of the backups
RCLONE_REMOTE=
