<%
var mdTabs = [
  ['castes', 'Castes'], ['gotras', 'Gotras'], ['clans', 'Clans'], ['surname-titles', 'Surname titles'],
  ['professions', 'Professions'], ['qualifications', 'Qualifications'], ['income-ranges', 'Income ranges'],
  ['interests', 'Interests'], ['report-reasons', 'Report reasons'], ['about-options', 'About options'],
  ['icebreaker-questions', 'Ice breaker']
];
%>
<div class="page-master-data">
  <div class="tabs" role="tablist" aria-label="Master data lists" data-tabs>
    <% mdTabs.forEach(function (tab, i) { %>
      <button class="tab<%= i === 0 ? ' is-active' : '' %>" role="tab" type="button" id="tab-<%= tab[0] %>" aria-selected="<%= i === 0 ? 'true' : 'false' %>" aria-controls="panel-<%= tab[0] %>" data-tab="<%= tab[0] %>"<% if (i !== 0) { %> tabindex="-1"<% } %>><%= tab[1] %></button>
    <% }); %>
  </div>

  <section class="card">
    <div class="card__header card__header--stack">
      <div class="page-head mb-0">
        <p class="page-head__text" data-tab-help>These lists feed the sign-up and profile forms in the app and on the website. An item that members already use cannot be deleted.</p>
        <div class="card__actions">
          <button type="button" class="btn btn--secondary" data-action="ai-suggest" hidden>Suggest clans with AI</button>
          <button type="button" class="btn btn--secondary" data-action="seed-icebreaker" hidden>Seed default questions</button>
          <button type="button" class="btn btn--primary" data-action="create">Add item</button>
        </div>
      </div>
      <form class="filters" id="md-filters" role="search" autocomplete="off">
        <div class="filters__search">
          <label class="sr-only" for="md-search">Search this list</label>
          <span class="filters__search-icon" aria-hidden="true"><%- icon('search', { size: 16 }) %></span>
          <input class="form-control" type="search" id="md-search" name="search" placeholder="Search this list" maxlength="80">
        </div>
        <div class="filters__item" data-gotra-only hidden>
          <label class="form-label form-label--sm" for="md-clan">Clan</label>
          <select class="form-select" id="md-clan" name="clan">
            <option value="">Any clan</option>
            <option value="none">No clan assigned</option>
          </select>
        </div>
      </form>
    </div>
    <div class="card__body card__body--flush">
      <% mdTabs.forEach(function (tab, i) { %>
        <div id="panel-<%= tab[0] %>" role="tabpanel" aria-labelledby="tab-<%= tab[0] %>" data-panel="<%= tab[0] %>"<% if (i !== 0) { %> hidden<% } %>>
          <div data-table-mount data-md-mount="<%= tab[0] %>"></div>
        </div>
      <% }); %>
    </div>
  </section>
</div>
