<section class="stats-grid" aria-label="Blog counts">
  <div class="stat"><div class="stat__icon stat__icon--primary"><%- icon('file-text') %></div><div><div class="stat__value" data-stat="totalBlogs">&ndash;</div><div class="stat__label">Total posts</div></div></div>
  <div class="stat"><div class="stat__icon stat__icon--success"><%- icon('check-circle') %></div><div><div class="stat__value" data-stat="publishedBlogs">&ndash;</div><div class="stat__label">Published</div></div></div>
  <div class="stat"><div class="stat__icon stat__icon--warning"><%- icon('edit') %></div><div><div class="stat__value" data-stat="draftBlogs">&ndash;</div><div class="stat__label">Drafts</div></div></div>
  <div class="stat"><div class="stat__icon stat__icon--neutral"><%- icon('slash') %></div><div><div class="stat__value" data-stat="archivedBlogs">&ndash;</div><div class="stat__label">Archived</div></div></div>
  <div class="stat"><div class="stat__icon stat__icon--info"><%- icon('eye') %></div><div><div class="stat__value" data-stat="totalViews">&ndash;</div><div class="stat__label">Total views</div></div></div>
</section>

<section class="card">
  <div class="card__header card__header--stack">
    <div class="page-head mb-0">
      <p class="page-head__text">Published posts are live at <span class="mono">/blogs/&lt;category&gt;/&lt;slug&gt;</span> on the website. A post's URL never changes after it is created.</p>
      <a class="btn btn--primary" href="/blogs/new">New post</a>
    </div>
    <%- include('../partials/table-toolbar', {
      id: 'blog-filters',
      search: { name: 'search', placeholder: 'Search title or description' },
      filters: [
        { name: 'status', label: 'Status', options: [
          { value: '', label: 'Any status' }, { value: 'published', label: 'Published' }, { value: 'draft', label: 'Draft' }, { value: 'archived', label: 'Archived' }
        ] },
        { name: 'category', label: 'Category', options: [
          { value: '', label: 'Any category' }, { value: 'Wedding', label: 'Wedding' }, { value: 'Relationship', label: 'Relationship' }, { value: 'Culture', label: 'Culture' }, { value: 'Tradition', label: 'Tradition' }, { value: 'Tips', label: 'Tips' }, { value: 'Events', label: 'Events' }, { value: 'Decoration', label: 'Decoration' }, { value: 'Stories', label: 'Stories' }, { value: 'Community', label: 'Community' }, { value: 'General', label: 'General' }
        ] },
        { name: 'sort', label: 'Sort', options: [
          { value: 'createdAt:desc', label: 'Newest first' }, { value: 'updatedAt:desc', label: 'Recently updated' }, { value: 'publishedAt:desc', label: 'Recently published' }, { value: 'views:desc', label: 'Most viewed' }, { value: 'title:asc', label: 'Title A–Z' }
        ] }
      ]
    }) %>
  </div>
  <div class="card__body card__body--flush">
    <div id="blogs-table" data-table-mount></div>
  </div>
</section>
