<div class="page-faqs">
  <section class="card">
    <div class="card__header card__header--stack">
      <div class="page-head mb-0">
        <p class="page-head__text">Questions and answers shown on the website's FAQ page (and its FAQ rich result) and in the app's FAQ screen. Write answers that are true today: no invented numbers or promises. Order inside a category is the order members see.</p>
        <div class="card__actions">
          <button type="button" class="btn btn--secondary" data-action="add-category">Add category</button>
          <button type="button" class="btn btn--primary" data-action="add-faq">Add FAQ</button>
        </div>
      </div>
    </div>
  </section>
  <div id="faq-groups" aria-live="polite" aria-busy="true"></div>
</div>
