<%
// Filter toolbar bound by core/filters.js (URL-synced).
// locals: id (String), search ({ name, placeholder } | false),
//         filters ([{ name, label, options: [{ value, label }], value? }]),
//         clear (Boolean, default true), actions (ignored; put buttons after the include)
var tbId = String(typeof id === 'string' ? id : 'filters');
var tbSearch = typeof search === 'undefined' ? { name: 'search', placeholder: 'Search' } : search;
var tbFilters = Array.isArray(filters) ? filters : [];
var tbClear = typeof clear === 'undefined' ? true : !!clear;
%>
<form class="filters" id="<%= tbId %>" data-filters role="search" autocomplete="off">
  <% if (tbSearch) { %>
    <div class="filters__search">
      <label class="sr-only" for="<%= tbId %>-search"><%= tbSearch.placeholder || 'Search' %></label>
      <span class="filters__search-icon" aria-hidden="true"><%- icon('search', { size: 16 }) %></span>
      <input class="form-control" type="search" id="<%= tbId %>-search" name="<%= tbSearch.name || 'search' %>" placeholder="<%= tbSearch.placeholder || 'Search' %>" maxlength="120">
    </div>
  <% } %>
  <% tbFilters.forEach(function (f) { %>
    <div class="filters__item">
      <label class="form-label form-label--sm" for="<%= tbId %>-<%= f.name %>"><%= f.label %></label>
      <select class="form-select" id="<%= tbId %>-<%= f.name %>" name="<%= f.name %>">
        <% (f.options || []).forEach(function (o) { %>
          <option value="<%= o.value %>"<%= (f.value !== undefined && String(f.value) === String(o.value)) ? ' selected' : '' %>><%= o.label %></option>
        <% }); %>
      </select>
    </div>
  <% }); %>
  <% if (tbClear) { %>
    <button type="button" class="btn btn--ghost btn--sm filters__clear" data-filter-clear>Clear</button>
  <% } %>
</form>
