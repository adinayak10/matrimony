# apps/admin - copy to .env for local runs. In production apps/admin/.env is a
# symlink to /var/www/banjaramatch-shared/env/admin.env (written by deploy.sh link_shared).
# The admin server never holds JWT_SECRET: it proxies to the API and the API verifies tokens.

# Port the admin server listens on (pm2 sets 4001).
PORT=4001
# Bind address; keep loopback, nginx proxies to it. Always 127.0.0.1, never "localhost".
HOST=127.0.0.1
# production | development | test
NODE_ENV=production
# API base for server-side calls (login proxy, /api/* proxy). Loopback in production.
API_BASE_URL=http://127.0.0.1:4002
# Same as API_BASE_URL; name used by the Phase 3c admin server (config/env.js).
API_INTERNAL_URL=http://127.0.0.1:4002
# Public API origin, for links/redirects rendered into pages.
API_PUBLIC_URL=https://api.banjaramatch.com
# Lifetime of the admin_session cookie in hours (must match the API admin JWT expiry).
SESSION_TTL_HOURS=8
# Git sha of the running release; set by deploy.sh/pm2, reported by GET /health.
RELEASE_SHA=
# set to 1 to enforce the CSP (default report-only)
CSP_ENFORCE=0
# optional label shown in the topbar (e.g. production)
ADMIN_SERVER=
