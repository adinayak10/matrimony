# apps/web - copy to .env for local runs. In production apps/web/.env is a
# symlink to /var/www/banjaramatch-shared/env/web.env (written by deploy.sh link_shared).

# Port the Express app listens on (pm2 sets 4000).
PORT=4000
# Bind address; keep loopback, nginx proxies to it. Node 22 resolves "localhost" to ::1, so always use 127.0.0.1.
HOST=127.0.0.1
# production | development | test
NODE_ENV=production
# Google Analytics 4 property id used by views/partials/analytics.ejs.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Set to "true" to load analytics outside NODE_ENV=production.
ENABLE_ANALYTICS=false
# Same value as apps/api JWT_SECRET (web verifies the login cookie locally until Phase 3a). 32+ chars.
JWT_SECRET=change-me-to-a-long-random-string
# API base used for server-side auth lookups (/api/auth/me). Loopback in production.
AUTH_SERVER_URL=http://127.0.0.1:4002
# API base used by models/Contact.js and the sitemap generators. Loopback in production.
API_URL=http://127.0.0.1:4002
# Git sha of the running release; set by deploy.sh/pm2, reported by GET /health.
RELEASE_SHA=
# shared with api.env; required header on POST /api/regenerate-sitemap
SITEMAP_REGEN_SECRET=
# comma-separated Android signing cert SHA-256 fingerprints for /.well-known/assetlinks.json
ANDROID_SHA256_FINGERPRINTS=
GOOGLE_SITE_VERIFICATION=
REQUIRE_COOKIE_CONSENT=0
SUPPORT_EMAIL=info@banjaramatch.com
# set to 1 to enforce the CSP (default report-only)
CSP_ENFORCE=0
# public API host used in templates for /uploads image URLs
API_PUBLIC_URL=https://api.banjaramatch.com
# Organization JSON-LD (owner-supplied; empty = omitted)
SITE_LEGAL_ENTITY=
SITE_ADDRESS=
# comma-separated real social profile URLs for sameAs
SITE_SAME_AS=
# twitter handle incl. @ (empty = omitted)
SITE_TWITTER=
# server-side API base (loopback); same as AUTH_SERVER_URL
API_INTERNAL_URL=http://127.0.0.1:4002
# Directory the sitemap XML files are generated into and served from
# (/sitemap.xml, /sitemap-*.xml). Default: apps/web/public. Monorepo deploy:
# SITEMAP_DIR=/var/www/banjaramatch-shared/sitemaps
SITEMAP_DIR=
# City pages need this many unique CMS words before they are indexed (default 300)
CITY_INDEX_MIN_WORDS=
