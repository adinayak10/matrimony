<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
</head>

<body>
    <%- include('../partials/header') %>

    <!-- LOGIN -->
    <section>
        <div class="db">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 col-lg-3">
                        <%- include('../partials/member-nav', { active: 'interests' }) %>
                    </div>
                    <div class="col-md-8 col-lg-9">
                        <div class="row">
                            <div class="col-md-12 db-sec-com">
                                <h2 class="db-tit">Interest request</h2>
                                <div class="db-pro-stat">
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="dropdown">
                                            <i class="fa fa-ellipsis-h" aria-hidden="true"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                          <li><a class="dropdown-item" href="/update-profile">Edit profile</a></li>
                                          <li><a class="dropdown-item" href="/profile/<%= user?._id %>">View profile</a></li>
                                          <li><a class="dropdown-item" href="/user-chat">Chat list</a></li>
                                        </ul>
                                    </div>
                                    <div class="db-inte-main">
                                       
                                          <ul class="nav nav-tabs" role="tablist">
                                            <li class="nav-item">
                                              <a class="nav-link active" data-bs-toggle="tab" href="#home">Received Requests (<span id="receivedCount">0</span>)</a>
                                            </li>
                                            <li class="nav-item">
                                              <a class="nav-link" data-bs-toggle="tab" href="#menu1">Sent Requests (<span id="sentCount">0</span>)</a>
                                            </li>
                                            <li class="nav-item">
                                              <a class="nav-link" data-bs-toggle="tab" href="#menu2">Connections (<span id="acceptedCount">0</span>)</a>
                                            </li>
                                            <li class="nav-item">
                                              <a class="nav-link" data-bs-toggle="tab" href="#menu3">Rejected (<span id="rejectedCount">0</span>)</a>
                                            </li>
                                          </ul>
                                          
  <!-- Tab panes -->
  <div class="tab-content">
    <!-- Received Requests Tab -->
    <div id="home" class="container tab-pane active"><br>
      <div class="db-inte-prof-list">
        <ul id="receivedRequestsList">
          <li class="text-center">
            <p class="text-muted">Loading requests...</p>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Sent Requests Tab -->
    <div id="menu1" class="container tab-pane fade"><br>
      <div class="db-inte-prof-list">
        <ul id="sentRequestsList">
          <li class="text-center">
            <p class="text-muted">Loading requests...</p>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Connections Tab (accepted interests, both directions; /connections redirects here) -->
    <div id="menu2" class="container tab-pane fade"><br>
      <div class="db-inte-prof-list">
        <ul id="acceptedRequestsList">
          <li class="text-center">
            <p class="text-muted">Loading requests...</p>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Rejected Requests Tab -->
    <div id="menu3" class="container tab-pane fade"><br>
      <div class="db-inte-prof-list">
        <ul id="rejectedRequestsList">
          <li class="text-center">
            <p class="text-muted">Loading requests...</p>
          </li>
        </ul>
      </div>
    </div>
  </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- END -->

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

    <!-- END -->
    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    
    <%- include('../partials/scripts') %>
<script>
// Deferred bundle (partials/scripts.ejs): page code runs once the DOM and the deferred scripts are ready.
document.addEventListener('DOMContentLoaded', function () {
const API_BASE_URL = '/api'; // same-origin proxy (middleware/apiProxy.js) injects the session Bearer
const MY_USER_ID = '<%= user?._id %>';


// Format date
function formatDate(dateString) {
    const date = new Date(dateString);
    return date.toLocaleString('en-US', { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric', 
        hour: '2-digit', 
        minute: '2-digit' 
    });
}

// Calculate age from DOB
function calculateAge(dob) {
    if (!dob) return 'N/A';
    const birthDate = new Date(dob);
    const today = new Date();
    let age = today.getFullYear() - birthDate.getFullYear();
    const monthDiff = today.getMonth() - birthDate.getMonth();
    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
        age--;
    }
    return age;
}

// Get membership badge
function getMembershipBadge(plan) {
    if (!plan || !plan.name) return '';
    
    if (plan.name === 'Platinum') {
        return '<span class="badge bg-primary user-pla-pat">Platinum user</span>';
    } else if (plan.name === 'Gold') {
        return '<span class="badge bg-primary user-pla-gold">Gold user</span>';
    } else {
        return '<span class="badge bg-primary user-pla-free">Free user</span>';
    }
}

// Render request item
function renderRequestItem(req, type) {
    const user = req.user || req.from || req.requester || req.to || req.receiver;
    if (!user) {
        console.log('No user data in request:', req);
        return '';
    }
    
    const age = calculateAge(user.dob);
    const height = user.height ? `${user.height} cm` : 'Not specified';
    const profession = user.profession?.name || 'Not specified';
    const city = user.location?.city?.name || 'N/A';
    const membershipBadge = getMembershipBadge(user.membershipPlan);
    const userImage = user.profile ? (user.profile.startsWith('http') ? user.profile : `https://api.banjaramatch.com/${user.profile}`) : '/images/default-user.jpg';
    
    let buttons = '';
    if (type === 'received' && req.status === 'pending') {
        buttons = `
            <button type="button" class="btn btn-success btn-sm accept-btn" data-user-id="${user._id}" data-request-id="${req._id}">Accept</button>
            <button type="button" class="btn btn-outline-danger btn-sm reject-btn" data-user-id="${user._id}" data-request-id="${req._id}">Reject</button>
        `;
    } else if (type === 'sent' && req.status === 'pending') {
        buttons = `
            <button type="button" class="btn btn-outline-danger btn-sm cancel-btn" data-user-id="${user._id}" data-request-id="${req._id}">Cancel Request</button>
        `;
    } else if (type === 'accepted') {
        buttons = `
            <a href="/user-chat" class="btn btn-primary btn-sm">Chat now</a>
            <button type="button" class="btn btn-outline-danger btn-sm remove-btn" data-user-id="${user._id}" data-request-id="${req._id}">Remove</button>
        `;
    } else if (type === 'rejected') {
        buttons = `
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Rejected</button>
        `;
    }
    
    let dates = `<li>Request on: ${formatDate(req.createdAt)}</li>`;
    if (req.status === 'accepted' && req.updatedAt) {
        dates += `<li>Accepted on: ${formatDate(req.updatedAt)}</li>`;
    } else if (req.status === 'rejected' && req.updatedAt) {
        dates += `<li>Rejected on: ${formatDate(req.updatedAt)}</li>`;
    }
    
    return `
        <li data-request-id="${req._id}">
            <div class="db-int-pro-1">
                <img src="${esc(userImage)}" alt="${esc(user.full_name)}" onerror="this.src='/images/default-user.jpg'">
                ${membershipBadge}
            </div>
            <div class="db-int-pro-2">
                <h5>${esc(user.full_name)}</h5>
                <ol class="poi">
                    <li>City: <strong>${esc(city)}</strong></li>
                    <li>Age: <strong>${esc(age)}</strong></li>
                    <li>Height: <strong>${esc(height)}</strong></li>
                    <li>Job: <strong>${esc(profession)}</strong></li>
                </ol>
                <ol class="poi poi-date">
                    ${dates}
                </ol>
                <a href="/profile/${user._id}" class="cta-5" target="_blank">View full profile</a>
            </div>
            <div class="db-int-pro-3">
                ${buttons}
            </div>
        </li>
    `;
}

// Load all interest requests
async function loadInterestRequests() {
    try {
        // Fetch received requests
        const receivedResponse = await fetch(`${API_BASE_URL}/getInterestList`, {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                my_user_id: MY_USER_ID,
                type: 'received',
                limit: 100,
                start: 1
            })
        });
        
        const receivedData = await receivedResponse.json();
        console.log('Received interests:', receivedData);
        
        // Fetch sent requests
        const sentResponse = await fetch(`${API_BASE_URL}/getInterestList`, {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                my_user_id: MY_USER_ID,
                type: 'sent',
                limit: 100,
                start: 1
            })
        });
        
        const sentData = await sentResponse.json();
        console.log('Sent interests:', sentData);
        
        // Fetch accepted requests
        const acceptedResponse = await fetch(`${API_BASE_URL}/getInterestList`, {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                status: 'accepted',
                limit: 100,
                start: 1
            })
        });
        
        const acceptedData = await acceptedResponse.json();
        console.log('Accepted interests:', acceptedData);
        
        const receivedRequests = receivedData.status ? (receivedData.data || []) : [];
        const sentRequests = sentData.status ? (sentData.data || []) : [];
        const acceptedRequests = acceptedData.status ? (acceptedData.data || []) : [];
        
        // Filter by status
        const receivedPending = receivedRequests.filter(r => r.status === 'pending');
        const sentPending = sentRequests.filter(r => r.status === 'pending');
        const allAccepted = acceptedRequests.filter(r => r.status === 'accepted');
        const allRejected = [...receivedRequests, ...sentRequests].filter(r => r.status === 'rejected');
        
        // Update counts
        $('#receivedCount').text(receivedPending.length);
        $('#sentCount').text(sentPending.length);
        $('#acceptedCount').text(allAccepted.length);
        $('#rejectedCount').text(allRejected.length);
        
        // Render received requests
        if (receivedPending.length > 0) {
            $('#receivedRequestsList').html(receivedPending.map(r => renderRequestItem(r, 'received')).join(''));
        } else {
            $('#receivedRequestsList').html('<li class="text-center"><p class="text-muted py-4">No new interest requests</p></li>');
        }
        
        // Render sent requests
        if (sentPending.length > 0) {
            $('#sentRequestsList').html(sentPending.map(r => renderRequestItem(r, 'sent')).join(''));
        } else {
            $('#sentRequestsList').html('<li class="text-center"><p class="text-muted py-4">No sent requests</p></li>');
        }
        
        // Render accepted requests
        if (allAccepted.length > 0) {
            $('#acceptedRequestsList').html(allAccepted.map(r => renderRequestItem(r, 'accepted')).join(''));
        } else {
            $('#acceptedRequestsList').html('<li class="text-center"><p class="text-muted py-4">No connections yet</p></li>');
        }
        
        // Render rejected requests
        if (allRejected.length > 0) {
            $('#rejectedRequestsList').html(allRejected.map(r => renderRequestItem(r, 'rejected')).join(''));
        } else {
            $('#rejectedRequestsList').html('<li class="text-center"><p class="text-muted py-4">No rejected requests</p></li>');
        }
        
    } catch (error) {
        console.error('Error loading interest requests:', error);
        $('.db-inte-prof-list ul').html('<li class="text-center"><p class="text-danger">Error loading requests</p></li>');
    }
}

// Accept Interest Request
$(document).on('click', '.accept-btn', async function() {
    const btn = $(this);
    const userId = btn.data('user-id');
    const listItem = btn.closest('li');
    
    if (!confirm('Accept this interest request?')) return;
    
    btn.prop('disabled', true).text('Processing...');
    
    try {
        const response = await fetch(`${API_BASE_URL}/acceptInterestRequest`, {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                my_user_id: MY_USER_ID,
                user_id: userId
            })
        });
        
        const data = await response.json();
        
        if (data.status) {
            alert('Interest request accepted! You can now chat with this person.');
            loadInterestRequests(); // Reload all lists
        } else {
            alert(data.message || 'Failed to accept request');
            btn.prop('disabled', false).text('Accept');
        }
    } catch (error) {
        console.error('Error accepting request:', error);
        alert('An error occurred. Please try again.');
        btn.prop('disabled', false).text('Accept');
    }
});

// Reject Interest Request
$(document).on('click', '.reject-btn', async function() {
    const btn = $(this);
    const userId = btn.data('user-id');
    const listItem = btn.closest('li');
    
    if (!confirm('Reject this interest request?')) return;
    
    btn.prop('disabled', true).text('Processing...');
    
    try {
        const response = await fetch(`${API_BASE_URL}/rejectInterestRequest`, {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                my_user_id: MY_USER_ID,
                user_id: userId
            })
        });
        
        const data = await response.json();
        
        if (data.status) {
            alert('Interest request rejected');
            loadInterestRequests(); // Reload all lists
        } else {
            alert(data.message || 'Failed to reject request');
            btn.prop('disabled', false).text('Reject');
        }
    } catch (error) {
        console.error('Error rejecting request:', error);
        alert('An error occurred. Please try again.');
        btn.prop('disabled', false).text('Reject');
    }
});

// Cancel Sent Request
$(document).on('click', '.cancel-btn', async function() {
    const btn = $(this);
    const userId = btn.data('user-id');
    const listItem = btn.closest('li');
    
    if (!confirm('Cancel this interest request?')) return;
    
    btn.prop('disabled', true).text('Processing...');
    
    try {
        const response = await fetch(`${API_BASE_URL}/cancelInterestRequest`, {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                my_user_id: MY_USER_ID,
                user_id: userId
            })
        });
        
        const data = await response.json();
        
        if (data.status) {
            alert('Interest request cancelled');
            loadInterestRequests(); // Reload all lists
        } else {
            alert(data.message || 'Failed to cancel request');
            btn.prop('disabled', false).text('Cancel Request');
        }
    } catch (error) {
        console.error('Error cancelling request:', error);
        alert('An error occurred. Please try again.');
        btn.prop('disabled', false).text('Cancel Request');
    }
});

// Remove Connection
$(document).on('click', '.remove-btn', async function() {
    const btn = $(this);
    const userId = btn.data('user-id');
    const listItem = btn.closest('li');
    
    if (!confirm('Remove this connection? This cannot be undone.')) return;
    
    btn.prop('disabled', true).text('Removing...');
    
    try {
        const response = await fetch(`${API_BASE_URL}/removeConnection`, {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                my_user_id: MY_USER_ID,
                user_id: userId
            })
        });
        
        const data = await response.json();
        
        if (data.status) {
            alert('Connection removed');
            loadInterestRequests(); // Reload all lists
        } else {
            alert(data.message || 'Failed to remove connection');
            btn.prop('disabled', false).text('Remove');
        }
    } catch (error) {
        console.error('Error removing connection:', error);
        alert('An error occurred. Please try again.');
        btn.prop('disabled', false).text('Remove');
    }
});

// Load requests on page load
$(document).ready(function() {
    loadInterestRequests();

    // Deep links: /user-interests#menu2 (and /connections, which redirects there)
    // open that tab; switching tabs keeps the hash in the URL.
    function showTab(hash) {
        const link = document.querySelector('.db-inte-main .nav-link[href="' + hash + '"]');
        if (!link) return;
        if (window.bootstrap && bootstrap.Tab) {
            bootstrap.Tab.getOrCreateInstance(link).show();
            return;
        }
        document.querySelectorAll('.db-inte-main .nav-link').forEach((a) => a.classList.toggle('active', a === link));
        document.querySelectorAll('.db-inte-main .tab-pane').forEach((p) => {
            const on = '#' + p.id === hash;
            p.classList.toggle('active', on);
            p.classList.toggle('show', on);
        });
    }
    if (/^#(home|menu[123])$/.test(window.location.hash)) showTab(window.location.hash);
    document.querySelectorAll('.db-inte-main .nav-link[data-bs-toggle="tab"]').forEach(function (a) {
        a.addEventListener('click', function () {
            if (history.replaceState) history.replaceState(null, '', a.getAttribute('href'));
        });
    });
    
    // Logout confirmation
    $('a[href="/logout"]').on('click', function(e) {
        if (!confirm('Are you sure you want to log out?')) {
            e.preventDefault();
        }
    });
});
    
  window.formatDate = formatDate;
  window.calculateAge = calculateAge;
  window.getMembershipBadge = getMembershipBadge;
  window.renderRequestItem = renderRequestItem;
  window.loadInterestRequests = loadInterestRequests;
});
</script>
</body>
</html>
