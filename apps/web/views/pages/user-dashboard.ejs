    <script defer>
// Wait for DOM to be fully loaded
document.addEventListener('DOMContentLoaded', function() {
    
// Wait for jQuery and slick to be loaded
const initSliders = () => {
    if (typeof jQuery !== 'undefined' && jQuery.fn.slick) {
        // COMMON SLIDER - Initialize all sliders
        $('.slider').each(function() {
            if (!$(this).hasClass('slick-initialized')) {
                $(this).slick({
                    infinite: false,
                    slidesToShow: 5,
                    arrows: false,
                    slidesToScroll: 1,
                    autoplay: false,
                    dots: false,
                    centerMode: false,
                    variableWidth: false,
                    swipe: true,
                    touchMove: true,
                    touchThreshold: 5,
                    draggable: true,
                    responsive: [{
                        breakpoint: 992,
                        settings: {
                            slidesToShow: 3,
                            slidesToScroll: 1,
                            centerMode: false,
                            swipe: true,
                            touchMove: true,
                            draggable: true
                        }
                    }, {
                        breakpoint: 768,
                        settings: {
                            slidesToShow: 2.5,
                            slidesToScroll: 1,
                            centerMode: false,
                            swipe: true,
                            touchMove: true,
                            draggable: true,
                            touchThreshold: 5
                        }
                    }, {
                        breakpoint: 480,
                        settings: {
                            slidesToShow: 2.5,
                            slidesToScroll: 1,
                            centerMode: false,
                            swipe: true,
                            touchMove: true,
                            draggable: true,
                            touchThreshold: 5
                        }
                    }]
                });
            }
        });
    } else {
        setTimeout(initSliders, 100);
    }
};

// Initialize sliders
initSliders();

// Animated counter
$('.count').each(function () {
    $(this).prop('Counter',0).animate({
        Counter: $(this).text()
    }, {
        duration: 4000,
        easing: 'swing',
        step: function (now) {
            $(this).text(Math.ceil(now));
        }
    });
});

// API Configuration
const API_BASE_URL = 'https://api.banjaramatch.com/api';
const MY_USER_ID = '<%= user?._id %>';

// Log profile completion data
console.log('Profile Completion Percentage:', <%= Math.round(user?.profileCompletion?.percentage || 0) %>);
console.log('Profile Completion Data:', {
    percentage: <%= Math.round(user?.profileCompletion?.percentage || 0) %>,
    suggestion: '<%= (user?.profileCompletion?.suggestion || '').replace(/'/g, "\\'") %>',
    missingFields: <%- JSON.stringify(user?.profileCompletion?.missingFields || []) %>
});

// Helper function to get auth token
function getAuthToken() {
    return document.cookie.split('; ')
        .find(row => row.startsWith('token='))
        ?.split('=')[1];
}

// Load Profile Statistics
async function loadProfileStats() {
    try {
        const response = await fetch(`${API_BASE_URL}/getProfileVisitorSummary`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${getAuthToken()}`
            },
            body: JSON.stringify({
                user_id: MY_USER_ID
            })
        });
        
        const data = await response.json();
        
        if (data.status && data.data) {
            $('#viewsCount').text(data.data.totalViews || 0);
            $('#likesCount').text(data.data.totalLikes || 0);
            $('#clicksCount').text(data.data.totalClicks || 0);
            // Update the new profile view count in activity section
            $('#profileViewCount').text(data.data.totalViews || 0);
        }
    } catch (error) {
        console.error('Error loading profile stats:', error);
        $('#profileViewCount').text('0');
    }
}

// Load Live Ice Breaker Players Count
async function loadLivePlayersCount() {
    try {
        const response = await fetch(`${API_BASE_URL}/getIcebreakerStats`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.status) {
            const activeCount = (data.data?.activeGames || 0) * 2 + (data.data?.queuedPlayers || 0);
            $('#livePlayersCount').text(activeCount > 0 ? activeCount : 'Join Now');
        } else {
            $('#livePlayersCount').text('Join Now');
        }
    } catch (error) {
        console.error('Error loading ice breaker stats:', error);
        $('#livePlayersCount').text('Join Now');
    }
}

// Load Recent Chats
async function loadRecentChats() {
    try {
        const response = await fetch(`${API_BASE_URL}/fetchUserRooms`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${getAuthToken()}`
            },
            body: JSON.stringify({
                my_user_id: MY_USER_ID,
                limit: 4
            })
        });
        
        const data = await response.json();
        
        if (data.status && data.data && data.data.length > 0) {
            const chatListHtml = data.data.map(chat => {
                const otherUser = chat.participants.find(p => p._id !== MY_USER_ID) || {};
                const location = otherUser.location?.city?.name || otherUser.location?.state?.name || 'Location not specified';
                const chatProfileImage = otherUser.profile ? (otherUser.profile.startsWith('http') ? otherUser.profile : `https://api.banjaramatch.com/${otherUser.profile}`) : '/images/default-user.jpg';
                
                return `
                    <li>
                        <div class="db-int-pro-1">
                            <img src="${esc(chatProfileImage)}" alt="${esc(otherUser.full_name)}">
                        </div>
                        <div class="db-int-pro-2">
                            <h5>${esc(otherUser.full_name || 'Unknown')}</h5>
                            <span>${esc(location)}</span>
                        </div>
                        <a href="/user-chat?room=${chat._id}" class="fclick">&nbsp;</a>
                    </li>
                `;
            }).join('');
            
            $('#recentChatList').html(chatListHtml);
        } else {
            $('#recentChatList').html('<li class="text-center"><p class="text-muted py-3">No recent chats</p></li>');
        }
    } catch (error) {
        console.error('Error loading recent chats:', error);
        $('#recentChatList').html('<li class="text-center"><p class="text-muted py-3">Failed to load chats</p></li>');
    }
}

// Load stats on page load
// Trending Now widget — fetchLiveActivity/getMatchMomentum already existed
// server-side but no page ever called them before now.
async function loadLiveActivity() {
    const section = document.getElementById('liveActivitySection');
    const list = document.getElementById('liveActivityList');
    const momentumEl = document.getElementById('momentumBadge');
    if (!section || !MY_USER_ID) return;

    try {
        const [activityRes, momentumRes] = await Promise.all([
            fetch(`${API_BASE_URL}/fetchLiveActivity`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ my_user_id: MY_USER_ID })
            }).then(r => r.json()).catch(() => null),
            fetch(`${API_BASE_URL}/getMatchMomentum`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: MY_USER_ID })
            }).then(r => r.json()).catch(() => null)
        ]);

        let hasContent = false;

        if (momentumRes && momentumRes.status && momentumRes.data && momentumRes.data.momentumScore > 0) {
            momentumEl.textContent = momentumRes.data.label;
            momentumEl.style.display = 'block';
            hasContent = true;
        }

        if (activityRes && activityRes.status && activityRes.data && activityRes.data.length > 0) {
            list.innerHTML = activityRes.data.slice(0, 6).map(a => `
                <li style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid #f0f0f0;">
                    <img src="${esc(a.icon)}" style="width:24px; height:24px;" alt="">
                    <span style="flex:1;">${esc(a.title)}</span>
                    <span style="color:#999; font-size:12px;">${esc(a.timeAgo)}</span>
                </li>
            `).join('');
            hasContent = true;
        }

        if (hasContent) section.style.display = 'block';
    } catch (error) {
        console.error('Error loading live activity:', error);
    }
}

$(document).ready(function() {
    loadProfileStats();
    loadRecentChats();
    loadLivePlayersCount();
    loadLiveActivity();
    
    // Refresh live players count every 10 seconds
    setInterval(loadLivePlayersCount, 10000);
    
    // Logout confirmation
    $('a[href="/logout"]').on('click', function(e) {
        if (!confirm('Are you sure you want to log out?')) {
            e.preventDefault();
        }
    });
});

}); // End DOMContentLoaded
    </script>
    
