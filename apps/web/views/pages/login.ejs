    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="js/jquery.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/select-opt.min.js"></script>
    <script src="js/custom.min.js"></script>


    <script>
        // Firebase Configuration
        const firebaseConfig = {
            apiKey: "AIzaSyBEQVygTdSOOUczWmUezTt0CyoGm4l5Qe8",
            authDomain: "socialmedia-dcdd8.firebaseapp.com",
            databaseURL: "https://socialmedia-dcdd8-default-rtdb.firebaseio.com",
            projectId: "socialmedia-dcdd8",
            storageBucket: "socialmedia-dcdd8.firebasestorage.app",
            messagingSenderId: "799990198329",
            appId: "1:799990198329:web:ee65ff58d4992177a21de8",
            measurementId: "G-3RE8KG7MXG"
        };

        // Initialize Firebase only if not already initialized
        try {
            if (!firebase.apps.length) {
                firebase.initializeApp(firebaseConfig);
                console.log('✅ Firebase initialized successfully');
            } else {
                console.log('ℹ️ Firebase already initialized');
            }
        } catch (error) {
            console.error('❌ Firebase initialization error:', error);
        }

        // Toggle password visibility
        function togglePassword() {
            const input = document.getElementById('password');
            const icon = document.querySelector('.toggle-password');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // Login Form Handler
        document.getElementById("loginForm").addEventListener("submit", async function(e) {
            e.preventDefault();
            
            console.log('=== LOGIN: START ===');
            const email = document.getElementById("email").value.trim();
            const password = document.getElementById("password").value;
            
            if (!email || !password) {
                alert('Please enter both email and password');
                return;
            }

            document.getElementById('login-spinner').classList.add('active');
            document.getElementById('loginBtn').disabled = true;

            try {
                console.log('🔐 Logging in with email:', email);
                
                // Sign in with Firebase
                const auth = firebase.auth();
                const userCredential = await auth.signInWithEmailAndPassword(email, password);
                const firebaseUser = userCredential.user;
                
                console.log('✅ Firebase authentication successful');
                console.log('🆔 Firebase UID:', firebaseUser.uid);
                
                const firebaseToken = await firebaseUser.getIdToken();
                console.log('🎫 Firebase ID Token obtained');

                // Login to backend
                const loginResponse = await fetch('https://api.banjaramatch.com/api/auth/firebase-email-login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        email: email,
                        firebaseUid: firebaseUser.uid,
                        firebaseToken: firebaseToken
                    }),
                    credentials: 'include'
                });

                const loginData = await loginResponse.json();
                console.log('🔐 Backend login response:', loginData);

                if (loginData.status && loginData.token) {
                    console.log('✅ Login successful! Setting token...');
                    document.cookie = `token=${loginData.token}; path=/; max-age=${7 * 24 * 60 * 60}; domain=.banjaramatch.com; SameSite=Lax`;
                    
                    // Track login event
                    if (typeof gtag !== 'undefined') {
                        gtag('event', 'login', {
                            'event_category': 'engagement',
                            'method': 'email'
                        });
                    }
                    
                    console.log('🎉 Redirecting to dashboard...');
                    alert('Login successful!');
                    window.location.href = '/dashboard';
                } else {
                    alert(loginData.message || 'Login failed. Please try again.');
                    document.getElementById('login-spinner').classList.remove('active');
                    document.getElementById('loginBtn').disabled = false;
                }
            } catch (error) {
                console.error('=== LOGIN: FAILED ===');
                console.error('❌ Error:', error);
                console.error('❌ Error code:', error.code);
                console.error('❌ Error message:', error.message);
                
                document.getElementById('login-spinner').classList.remove('active');
                document.getElementById('loginBtn').disabled = false;
                
                let errorMsg = 'Login failed. ';
                if (error.code === 'auth/user-not-found') {
                    errorMsg = 'No account found with this email. Please register first.';
                } else if (error.code === 'auth/wrong-password') {
                    errorMsg = 'Incorrect password. Please try again.';
                } else if (error.code === 'auth/invalid-email') {
                    errorMsg = 'Invalid email format.';
                } else if (error.code === 'auth/user-disabled') {
                    errorMsg = 'This account has been disabled.';
                } else if (error.code === 'auth/too-many-requests') {
                    errorMsg = 'Too many failed login attempts. Please try again later.';
                } else {
                    errorMsg += error.message || 'Please try again.';
                }
                
                alert(errorMsg);
            }
        });

        // Google Sign-In Handler (POPUP-BASED with blocker detection)
        document.getElementById('googleLoginBtn').addEventListener('click', async function() {
            console.log('=== GOOGLE LOGIN: BUTTON CLICKED (POPUP METHOD) ===');
            console.log('Timestamp:', new Date().toISOString());
            console.log('Current URL:', window.location.href);
            
            this.disabled = true;
            this.innerHTML = '<div class="loading-spinner active" style="width: 20px; height: 20px; margin: 0;"></div> Opening Google...';

            let popupStartTime = null; // Declare outside try-catch for error handler access
            
            try {
                console.log('Step 1: Getting Firebase auth instance...');
                const auth = firebase.auth();
                console.log('✅ Firebase auth instance obtained:', auth ? 'Yes' : 'No');
                
                console.log('Step 2: Creating Google provider...');
                const provider = new firebase.auth.GoogleAuthProvider();
                console.log('✅ Google provider created');
                
                // Request additional scopes
                console.log('Step 3: Adding scopes...');
                provider.addScope('profile');
                provider.addScope('email');
                console.log('✅ Scopes added: profile, email');
                
                console.log('Step 4: Opening Google Sign-In popup...');
                console.log('🔐 About to call signInWithPopup()');
                this.innerHTML = '<div class="loading-spinner active" style="width: 20px; height: 20px; margin: 0;"></div> Waiting for Google...';
                
                // Track popup open time
                popupStartTime = Date.now();
                console.log('Popup opened at:', new Date(popupStartTime).toISOString());
                
                // Use POPUP for authentication
                const result = await auth.signInWithPopup(provider);
                const popupDuration = Date.now() - popupStartTime;
                console.log('✅ signInWithPopup() completed!');
                console.log('Popup duration:', popupDuration, 'ms');
                console.log('📦 Result:', result);
                
                const firebaseUser = result.user;
                console.log('👤 User obtained from popup:', firebaseUser);
                
                // Update button state
                this.innerHTML = '<div class="loading-spinner active" style="width: 20px; height: 20px; margin: 0;"></div> Completing sign-in...';
                
                // Process the login
                await processGoogleLogin(firebaseUser);
                
            } catch (error) {
                const errorDuration = Date.now() - (popupStartTime || Date.now());
                
                this.disabled = false;
                this.innerHTML = '<img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google"> Sign in with Google';
                
                // Handle popup-closed-by-user silently if user actually closed it
                if (error.code === 'auth/popup-closed-by-user') {
                    console.log('ℹ️ User closed Google Sign-In popup');
                    // Don't show error alert for user cancellation - this is normal behavior
                    return;
                } else if (error.code === 'auth/cancelled-popup-request') {
                    console.log('ℹ️ Popup request cancelled (another popup may be open)');
                    return;
                }
                
                // Log all other errors
                console.error('=== GOOGLE LOGIN: FAILED ===');
                console.error('Time to error:', errorDuration, 'ms');
                console.error('❌ Error:', error);
                console.error('❌ Error code:', error.code);
                console.error('❌ Error message:', error.message);
                
                let errorMsg = '';
                
                if (error.code === 'auth/popup-blocked') {
                    errorMsg = '⚠️ Popup Blocked!\n\nPlease allow popups for banjaramatch.com and try again.';
                    console.error('🚫 Browser blocked the popup');
                } else if (error.code === 'auth/account-exists-with-different-credential') {
                    errorMsg = 'An account already exists with this email using email/password. Please use email login instead.';
                } else if (error.code === 'auth/operation-not-allowed') {
                    errorMsg = '⚠️ Configuration Error\n\nGoogle Sign-In is not enabled in Firebase Console.\n\nPlease contact administrator.';
                    console.error('🚫 CRITICAL: Enable Google provider at Firebase Console');
                } else if (error.code === 'auth/unauthorized-domain') {
                    errorMsg = '⚠️ Domain Not Authorized\n\nThis domain is not authorized for Google Sign-In.\n\nPlease contact administrator.';
                    console.error('🚫 CRITICAL: Add domain to Firebase authorized domains');
                } else {
                    errorMsg = 'Google sign-in failed: ' + (error.message || 'Unknown error');
                }
                
                alert(errorMsg);
            }
        });

        // Check for existing auth session on page load (popup doesn't need redirect handler)
        (async function checkExistingAuth() {
            console.log('\n=== CHECKING EXISTING AUTH SESSION ===');
            console.log('Page loaded at:', new Date().toISOString());
            
            try {
                const auth = firebase.auth();
                
                // Check if user is already signed in
                auth.onAuthStateChanged((user) => {
                    if (user) {
                        console.log('✅ User already authenticated!');
                        console.log('👤 Display Name:', user.displayName);
                        console.log('📧 Email:', user.email);
                        console.log('🆔 UID:', user.uid);
                        console.log('ℹ️ User can continue to dashboard');
                    } else {
                        console.log('ℹ️ No active Firebase session - user needs to login');
                    }
                });
                
            } catch (error) {
                console.error('❌ Error checking auth state:', error);
            }
        })();
        
        // Separate function to process Google login
        async function processGoogleLogin(firebaseUser) {
            try {
                console.log('=== PROCESSING GOOGLE LOGIN ===');
                console.log('👤 Display Name:', firebaseUser.displayName);
                console.log('📧 Email:', firebaseUser.email);
                console.log('🆔 Firebase UID:', firebaseUser.uid);
                console.log('📸 Photo URL:', firebaseUser.photoURL);
                console.log('✉️ Email Verified:', firebaseUser.emailVerified);
                console.log('📞 Phone Number:', firebaseUser.phoneNumber);
                console.log('🔑 Provider Data:', firebaseUser.providerData);
                
                // Show loading state
                const googleBtn = document.getElementById('googleLoginBtn');
                if (googleBtn) {
                    console.log('Setting button to loading state...');
                    googleBtn.disabled = true;
                    googleBtn.innerHTML = '<div class="loading-spinner active" style="width: 20px; height: 20px; margin: 0;"></div> Completing sign-in...';
                } else {
                    console.log('⚠️ Google button not found in DOM');
                }
                
                console.log('\nGetting Firebase ID token...');
                const firebaseToken = await firebaseUser.getIdToken();
                console.log('✅ Firebase ID Token obtained');
                console.log('Token length:', firebaseToken.length);
                console.log('Token (first 50 chars):', firebaseToken.substring(0, 50) + '...');

                console.log('\nPreparing backend login request...');
                const requestData = { 
                    email: firebaseUser.email,
                    full_name: firebaseUser.displayName,
                    firebaseUid: firebaseUser.uid,
                    firebaseToken: firebaseToken,
                    photoURL: firebaseUser.photoURL
                };
                console.log('Request data:', JSON.stringify(requestData, null, 2));

                console.log('\nCalling backend API...');
                console.log('URL: https://api.banjaramatch.com/api/auth/firebase-google-login');
                console.log('⏳ Sending request...');
                
                const loginResponse = await fetch('https://api.banjaramatch.com/api/auth/firebase-google-login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(requestData),
                    credentials: 'include'
                });

                console.log('\n✅ Backend responded');
                console.log('Response status:', loginResponse.status);
                console.log('Response status text:', loginResponse.statusText);
                console.log('Response headers:', [...loginResponse.headers.entries()]);
                
                const loginData = await loginResponse.json();
                console.log('✅ Response parsed');
                console.log('Backend response:', JSON.stringify(loginData, null, 2));

                if (loginData.status && loginData.token) {
                    console.log('\n🎉 Google login successful!');
                    console.log('Token received:', loginData.token.substring(0, 50) + '...');
                    console.log('Message:', loginData.message);
                    
                    // Set cookie with proper flags (backend also sets it, but we ensure it here too)
                    console.log('Setting cookie on client-side...');
                    const cookieString = `token=${loginData.token}; path=/; max-age=${7 * 24 * 60 * 60}; domain=.banjaramatch.com; SameSite=Lax; Secure`;
                    document.cookie = cookieString;
                    console.log('Cookie string:', cookieString.substring(0, 100) + '...');
                    
                    // Verify cookie was set
                    const cookies = document.cookie;
                    console.log('Current cookies:', cookies);
                    const hasToken = cookies.includes('token=');
                    console.log('Token cookie exists:', hasToken);
                    
                    // Also store in localStorage as backup
                    try {
                        localStorage.setItem('auth_token', loginData.token);
                        console.log('✅ Token also saved to localStorage');
                    } catch (e) {
                        console.warn('⚠️ Could not save to localStorage:', e);
                    }
                    
                    // Track event based on registration vs login
                    const isNewUser = loginData.message && loginData.message.includes('Registration');
                    console.log('Is new user?', isNewUser);
                    
                    if (typeof gtag !== 'undefined') {
                        gtag('event', isNewUser ? 'sign_up' : 'login', {
                            'event_category': 'engagement',
                            'method': 'google'
                        });
                    }
                    
                    console.log('🎉 Google login completed successfully!');
                    console.log('✅ ALL DONE - Check logs above for details');
                    console.log('📋 SUMMARY:');
                    console.log('  - Firebase authentication: ✅');
                    console.log('  - Backend API call: ✅');
                    console.log('  - Token saved in cookie: ✅');
                    console.log('  - Token saved in localStorage: ✅');
                    console.log('');
                    
                    // Redirect to thank-you page for new registrations, dashboard for existing users
                    if (isNewUser) {
                        console.log('🔗 New user - Redirecting to thank-you page...');
                        // Track registration conversion
                        if (typeof window.trackRegistrationConversion === 'function') {
                            window.trackRegistrationConversion();
                        }
                        window.location.href = '/thank-you';
                    } else {
                        console.log('🔗 Existing user - Redirecting to dashboard...');
                        window.location.href = '/dashboard';
                    }
                } else {
                    console.error('\n❌ Backend login failed');
                    console.error('Status:', loginData.status);
                    console.error('Message:', loginData.message);
                    console.error('Full response:', loginData);
                    alert(loginData.message || 'Login failed. Please try again.');
                    if (googleBtn) {
                        googleBtn.disabled = false;
                        googleBtn.innerHTML = '<img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google"> Sign in with Google';
                    }
                }
            } catch (error) {
                console.error('\n❌ ERROR IN processGoogleLogin:', error);
                throw error;
            }
        }
    </script>
</body>


