<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
</head>

<body>
    <%- include('../partials/header') %>
<%- include('../partials/breadcrumb') %>

    <!-- BREADCRUMB -->
    <section class="wed-hom-ser">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="wed-hom-ser-1">
                        <h1>Community Feedback & Suggestions</h1>
                        <p>Your Voice Shapes Our Future - Help Us Build a Better Platform for the Banjara Community</p>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Community Feedback</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN CONTENT -->
    <section class="about-us">
        <div class="container">
            <!-- Introduction Section -->
            <div class="row mb-5">
                <div class="col-md-12">
                    <div class="about-intro" style="text-align: center; margin-bottom: 40px;">
                        <h2 style="color: #f6af04; font-size: 36px; margin-bottom: 20px;">We Listen, We Learn, We Evolve</h2>
                        <p style="font-size: 18px; line-height: 1.8; color: #555; max-width: 900px; margin: 0 auto;">
                            At BanjaraMatch, we believe in the power of community. Your experiences, ideas, and concerns are the 
                            foundation of our growth. We're not just building a matrimony platform—we're creating a digital home 
                            for the Banjara community, and your voice matters every step of the way.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Why Your Feedback Matters -->
            <div class="row mb-5">
                <div class="col-md-12">
                    <h2 style="color: #333; text-align: center; margin-bottom: 30px;">Why Your Feedback Shapes Our Future</h2>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-box" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px; border-radius: 15px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); height: 100%;">
                        <i class="fa fa-users" style="font-size: 48px; color: #fff; margin-bottom: 15px;"></i>
                        <h4 style="color: #fff; margin-bottom: 15px;">Community-Driven Development</h4>
                        <p style="color: rgba(255,255,255,0.9); font-size: 14px; line-height: 1.6;">
                            Every feature we build comes from real suggestions by real community members like you. Your input directly 
                            influences what we develop next.
                        </p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-box" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); padding: 30px; border-radius: 15px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); height: 100%;">
                        <i class="fa fa-shield" style="font-size: 48px; color: #fff; margin-bottom: 15px;"></i>
                        <h4 style="color: #fff; margin-bottom: 15px;">Complete Transparency</h4>
                        <p style="color: rgba(255,255,255,0.9); font-size: 14px; line-height: 1.6;">
                            We believe in open communication. See what features are being developed, what's in the pipeline, and 
                            how your suggestions are being implemented.
                        </p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="feature-box" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); padding: 30px; border-radius: 15px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); height: 100%;">
                        <i class="fa fa-rocket" style="font-size: 48px; color: #fff; margin-bottom: 15px;"></i>
                        <h4 style="color: #fff; margin-bottom: 15px;">Hi-Tech Future</h4>
                        <p style="color: rgba(255,255,255,0.9); font-size: 14px; line-height: 1.6;">
                            Help us bring the Banjara community into the digital age. Your tech-savvy ideas help us stay modern 
                            while respecting our traditions.
                        </p>
                    </div>
                </div>
            </div>

            <!-- What You Can Share -->
            <div class="row mb-5">
                <div class="col-md-12">
                    <h2 style="color: #333; text-align: center; margin-bottom: 30px;">What Can You Share With Us?</h2>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="suggestion-type" style="display: flex; align-items: start; padding: 20px; background: #f9f9f9; border-radius: 10px; border-left: 4px solid #f6af04;">
                        <i class="fa fa-lightbulb-o" style="font-size: 32px; color: #f6af04; margin-right: 15px; margin-top: 5px;"></i>
                        <div>
                            <h5 style="color: #333; margin-bottom: 10px;">Feature Suggestions</h5>
                            <p style="color: #666; font-size: 14px; margin: 0;">
                                Have an idea for a new feature? Whether it's video calling, advanced filters, AI matchmaking, 
                                or something completely unique—we want to hear it!
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="suggestion-type" style="display: flex; align-items: start; padding: 20px; background: #f9f9f9; border-radius: 10px; border-left: 4px solid #e74c3c;">
                        <i class="fa fa-exclamation-triangle" style="font-size: 32px; color: #e74c3c; margin-right: 15px; margin-top: 5px;"></i>
                        <div>
                            <h5 style="color: #333; margin-bottom: 10px;">Report Issues & Concerns</h5>
                            <p style="color: #666; font-size: 14px; margin: 0;">
                                Spotted a bug? Something not working right? Or concerned about something that doesn't align 
                                with Banjara values? Let us know immediately.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="suggestion-type" style="display: flex; align-items: start; padding: 20px; background: #f9f9f9; border-radius: 10px; border-left: 4px solid #3498db;">
                        <i class="fa fa-paint-brush" style="font-size: 32px; color: #3498db; margin-right: 15px; margin-top: 5px;"></i>
                        <div>
                            <h5 style="color: #333; margin-bottom: 10px;">Design & User Experience</h5>
                            <p style="color: #666; font-size: 14px; margin: 0;">
                                Think something could look better? Navigation confusing? Share your thoughts on improving 
                                the design and user experience.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="suggestion-type" style="display: flex; align-items: start; padding: 20px; background: #f9f9f9; border-radius: 10px; border-left: 4px solid #9b59b6;">
                        <i class="fa fa-heart" style="font-size: 32px; color: #9b59b6; margin-right: 15px; margin-top: 5px;"></i>
                        <div>
                            <h5 style="color: #333; margin-bottom: 10px;">Cultural Sensitivity</h5>
                            <p style="color: #666; font-size: 14px; margin: 0;">
                                Help us ensure BanjaraMatch respects and celebrates our Banjara heritage. Share if something 
                                doesn't feel right culturally.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Community Contributors Section -->
            <div class="row mt-5 mb-5">
                <div class="col-md-12">
                    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 50px; border-radius: 20px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                        <i class="fa fa-users" style="font-size: 60px; color: #fff; margin-bottom: 20px;"></i>
                        <h2 style="color: #fff; margin-bottom: 15px;">🏆 Community Contributors</h2>
                        <p style="color: rgba(255,255,255,0.9); font-size: 16px; margin-bottom: 30px;">
                            Special recognition to our amazing community members who helped shape BanjaraMatch through their valuable feedback!
                        </p>
                        
                        <!-- Contributors Grid - Shows individual contributions -->
                        <div id="contributorsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; margin-top: 30px;">
                            <div style="text-align: center; padding: 20px; color: rgba(255,255,255,0.7); grid-column: 1 / -1;">
                                <i class="fa fa-spinner fa-spin" style="font-size: 32px;"></i>
                                <p style="margin-top: 10px;">Loading contributors...</p>
                            </div>
                        </div>

                        <!-- Load More Button -->
                        <div id="loadMoreContainer" style="display: none; margin-top: 30px;">
                            <button onclick="loadMoreContributors()" style="background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); color: #fff; padding: 12px 30px; border-radius: 30px; cursor: pointer; font-weight: 600; transition: all 0.3s;"
                                    onmouseover="this.style.background='rgba(255,255,255,0.3)'"
                                    onmouseout="this.style.background='rgba(255,255,255,0.2)'">
                                <i class="fa fa-chevron-down" style="margin-right: 8px;"></i>
                                Load More (<span id="remainingCount">0</span> more)
                            </button>
                        </div>

                        <div id="noContributors" style="display: none; padding: 30px; background: rgba(255,255,255,0.1); border-radius: 10px; margin-top: 20px;">
                            <p style="color: rgba(255,255,255,0.9); font-size: 16px; margin: 0;">
                                Be the first to contribute! Submit your feedback above and help us improve BanjaraMatch.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
    <!-- END -->

    <!-- FEEDBACK FORM SECTION -->
    <section>
        <div class="login pg-cont">
            <div class="container">
                <div class="row">
                    <div class="inn">
                            <div class="lhs">
                                <div class="tit">
                                    <h2>Now <b>Share Your Thoughts</b> Easy and fast.</h2>
                                    <p>Every suggestion is reviewed by our team. We value your input on <a href="/register" title="Registration">features</a>, <a href="/all-profiles" title="Design">design</a>, <a href="/about" title="Experience">experience</a>, or general inquiries.</p>
                                </div>
                                <div class="im">
                                    <img src="/images/login-couple.png" alt="Community Feedback">
                                </div>
                                <div class="log-bg">&nbsp;</div>
                            </div>
                            <div class="rhs">
                                <div>
                                    <div class="form-tit">
                                        <h4>We Value Your Input</h4>
                                        <h2>Send your feedback now</h2>
                                    </div>
                                    <div class="form-login">
                                        <form id="feedbackForm" class="cform">
                                            <div id="formMessage" class="alert" style="display: none;" role="alert"></div>
<div class="bm-hp" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;overflow:hidden;">
  <label for="feedbackWebsite">Website</label>
  <input type="text" id="feedbackWebsite" name="website" tabindex="-1" autocomplete="off" value="">
</div>
                                            
                                            <div class="form-group">
                                                <label class="lb" for="name">Your Name: <span style="color: red;">*</span></label>
                                                <input type="text" id="name" class="form-control"
                                                    placeholder="Enter your full name" name="name" required>
