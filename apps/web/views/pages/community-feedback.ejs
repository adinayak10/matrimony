                                            <div class="form-group">
                                                <label class="lb" for="message">Your Message: <span style="color: red;">*</span></label>
                                                <textarea name="message" class="form-control" id="message"
                                                    placeholder="Please share your thoughts, ideas, or concerns in detail" rows="6" required></textarea>
                                            </div>
                                            <div class="form-group form-check">
                                                <label class="form-check-label" for="followUp">
                                                    <input class="form-check-input" type="checkbox" id="followUp" name="followUp">
                                                    I would like to receive updates on the status of my feedback
                                                </label>
                                            </div>
                                            <button type="submit" id="submitBtn" class="btn btn-primary">
                                                <i class="fa fa-paper-plane"></i> Submit Feedback
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- END -->

    <!-- Our Commitment -->
    <section>
        <div class="ab-cont pg-cont">
            <div class="container">
                <div class="row">
                <div class="col-md-12">
                    <div style="background: #f9f9f9; padding: 40px; border-radius: 15px; text-align: center;">
                        <h2 style="color: #333; margin-bottom: 20px;">Our Commitment to You</h2>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <i class="fa fa-clock-o" style="font-size: 42px; color: #f6af04; margin-bottom: 10px;"></i>
                                <h5 style="color: #333;">48-Hour Response</h5>
                                <p style="color: #666; font-size: 14px;">We review and respond to every submission within 48 hours</p>
                            </div>
                            <div class="col-md-3 mb-3">
                                <i class="fa fa-check-circle" style="font-size: 42px; color: #27ae60; margin-bottom: 10px;"></i>
                                <h5 style="color: #333;">Action Taken</h5>
                                <p style="color: #666; font-size: 14px;">Valid suggestions are added to our development roadmap</p>
                            </div>
                            <div class="col-md-3 mb-3">
                                <i class="fa fa-bell" style="font-size: 42px; color: #3498db; margin-bottom: 10px;"></i>
                                <h5 style="color: #333;">Updates & Notifications</h5>
                                <p style="color: #666; font-size: 14px;">Get notified when your suggested feature goes live</p>
                            </div>
                            <div class="col-md-3 mb-3">
                                <i class="fa fa-trophy" style="font-size: 42px; color: #e67e22; margin-bottom: 10px;"></i>
                                <h5 style="color: #333;">Community Recognition</h5>
