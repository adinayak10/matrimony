                                                <input type="email" class="form-control" id="email"
                                                    placeholder="Enter your email" name="email" required>
                                            </div>
                                            <div class="form-group">
                                                <label class="lb" for="phone">Phone (Optional):</label>
                                                <input type="tel" class="form-control" id="phone"
                                                    placeholder="Enter phone number" name="phone">
                                            </div>
                                            <div class="form-group">
                                                <label class="lb" for="category">Feedback Category: <span style="color: red;">*</span></label>
                                                <select class="form-control" id="category" name="category" required>
                                                    <option value="">Select a category...</option>
                                                    <option value="feature_request">💡 Feature Request / New Idea</option>
                                                    <option value="bug_report">🐛 Bug Report / Technical Issue</option>
                                                    <option value="design_ux">🎨 Design & User Experience</option>
                                                    <option value="cultural_concern">👥 Cultural Sensitivity Concern</option>
                                                    <option value="general_feedback">💬 General Feedback</option>
                                                    <option value="appreciation">❤️ Appreciation / Compliment</option>
                                                    <option value="other">⭐ Other</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label class="lb" for="subject">Subject / Title: <span style="color: red;">*</span></label>
                                                <input type="text" class="form-control" id="subject"
                                                    placeholder="Brief summary of your feedback" name="subject" required>
