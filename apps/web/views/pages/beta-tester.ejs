<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<style>
    .beta-hero {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 100px 0 80px;
      color: white;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    
    .beta-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 1;
      animation: pattern-slide 20s linear infinite;
    }
    
    @keyframes pattern-slide {
      0% { background-position: 0 0; }
      100% { background-position: 60px 60px; }
    }
    
    .beta-hero h1 {
      font-size: 3.2rem;
      font-weight: 800;
      margin-bottom: 25px;
      text-shadow: 0 2px 20px rgba(0,0,0,0.2);
      position: relative;
      z-index: 10;
      color: #ffffff;
      letter-spacing: -0.5px;
    }
    
    .beta-hero .subtitle {
      font-size: 1.3rem;
      margin-bottom: 35px;
      opacity: 0.95;
      font-weight: 500;
      text-shadow: 0 2px 10px rgba(0,0,0,0.15);
      position: relative;
      z-index: 10;
      line-height: 1.7;
      color: #f0f0f0;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }
    
    .beta-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.95);
      color: #667eea;
      padding: 10px 30px;
      border-radius: 50px;
      font-weight: 800;
      font-size: 0.85rem;
      margin-bottom: 25px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
      border: none;
      letter-spacing: 1px;
      position: relative;
      z-index: 10;
      margin-left: 15px;
      margin-right: 15px;
    }
    
    .slots-badge {
      background: rgba(255, 255, 255, 0.2);
      padding: 15px 40px;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 700;
      border: 2px solid rgba(255, 255, 255, 0.4);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
      backdrop-filter: blur(10px);
      display: inline-block;
      margin-top: 10px;
      position: relative;
      z-index: 10;
      color: #ffffff;
    }

    .beta-content {
      padding: 60px 0;
      background: white;
    }

    .feature-card {
      background: white;
      border-radius: 15px;
      padding: 35px 25px;
      text-align: center;
      box-shadow: 0 5px 25px rgba(0,0,0,0.08);
      margin-bottom: 30px;
      height: 100%;
      transition: all 0.3s ease;
      border: 1px solid #f0f0f0;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 40px rgba(102, 126, 234, 0.15);
      border-color: #667eea;
    }

    .feature-card .icon {
      font-size: 3rem;
      margin-bottom: 18px;
    }

    .feature-card h3 {
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 12px;
      color: #333;
    }

    .feature-card p {
      color: #666;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .beta-form-section {
      background: #f8f9fa;
      padding: 60px 0;
    }

    .form-container {
      background: white;
      border-radius: 15px;
      padding: 40px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
      max-width: 600px;
      margin: 0 auto;
    }

    .form-container h2 {
      color: #333;
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 10px;
      text-align: center;
    }

    .form-container .form-subtitle {
      text-align: center;
      color: #666;
      margin-bottom: 30px;
    }

    .form-group label {
      font-weight: 600;
      color: #333;
      margin-bottom: 8px;
    }

    .form-control {
      border-radius: 8px;
      border: 1px solid #ddd;
      padding: 12px 15px;
      font-size: 15px;
    }

    .form-control:focus {
      border-color: #667eea;
      box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
    }

    .btn-submit {
      background: linear-gradient(135deg, #f6af04 0%, #ff8c00 100%);
      color: white;
      padding: 18px 40px;
      border-radius: 30px;
      font-size: 1.15rem;
      font-weight: 700;
      border: none;
      width: 100%;
      margin-top: 20px;
      transition: all 0.3s ease;
      box-shadow: 0 8px 25px rgba(246, 175, 4, 0.4);
      letter-spacing: 0.5px;
    }

    .btn-submit:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 35px rgba(246, 175, 4, 0.5);
      background: linear-gradient(135deg, #ff8c00 0%, #f6af04 100%);
    }

    .note-text {
      background: #fff8e1;
      border-left: 4px solid #ffa726;
      padding: 18px 22px;
      margin: 30px 0;
      border-radius: 8px;
      box-shadow: 0 3px 15px rgba(255, 167, 38, 0.1);
      color: #333;
      font-size: 1rem;
      line-height: 1.6;
    }

    .success-message {
      display: none;
      background: #d4edda;
      color: #155724;
      padding: 20px;
      border-radius: 10px;
      text-align: center;
      margin-top: 20px;
    }

    .error-message {
      display: none;
      background: #f8d7da;
      color: #721c24;
      padding: 15px;
      border-radius: 8px;
      margin-top: 15px;
      text-align: center;
    }

    @media (max-width: 768px) {
      .beta-hero { 
        padding: 50px 15px 40px;
      }
      .beta-hero h1 { 
        font-size: 1.8rem;
        line-height: 1.3;
        padding: 0 10px;
      }
      .beta-hero .subtitle { 
        font-size: 1rem;
        line-height: 1.6;
        padding: 0 10px;
      }
      .form-container { 
        padding: 25px 20px;
        margin: 0 15px;
      }
      .form-container h2 {
        font-size: 1.5rem;
      }
      .slots-badge {
        font-size: 0.85rem;
        padding: 10px 20px;
        margin: 10px;
        display: inline-block;
      }
      .beta-badge {
        font-size: 0.75rem;
        padding: 8px 20px;
        margin: 10px;
        display: inline-block;
      }
      .feature-card {
        margin-bottom: 20px;
      }
      .beta-content {
        padding: 40px 0;
      }
      .beta-form-section {
        padding: 40px 0;
      }
      .note-text {
        margin: 20px 15px;
        padding: 15px;
        font-size: 0.9rem;
      }
    }
    
    @media (max-width: 480px) {
      .beta-hero {
        padding: 40px 10px 30px;
      }
      .beta-hero h1 {
        font-size: 1.4rem;
        padding: 0 5px;
      }
      .beta-hero .subtitle {
        font-size: 0.9rem;
        padding: 0 5px;
      }
      .beta-badge {
        font-size: 0.7rem;
        padding: 6px 15px;
        margin: 10px 5px;
      }
      .slots-badge {
        font-size: 0.8rem;
        padding: 8px 15px;
        margin: 10px 5px;
      }
      .form-container {
        padding: 20px 15px;
      }
      .btn-submit {
        padding: 12px 30px;
        font-size: 1rem;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/header') %>

  <%- include('../partials/breadcrumb', { 
    breadcrumbs: [
      { name: 'Beta Testing Program', url: '/beta-tester' }
    ]
  }) %>

  <!-- HERO SECTION -->
  <section class="beta-hero">
    <div class="container">
      <div class="row">
        <div class="col-md-12">
          <span class="beta-badge">🚀 BETA PROGRAM</span>
          <h1>Join Beta Testing Program</h1>
          <p class="subtitle">Get early access to advanced features before public release.<br>BanjaraMatch is FREE forever - beta testers experience new features first!</p>
          <div style="margin-top: 30px;">
            <span id="slotsAvailable" class="slots-badge">
              <i class="fa fa-users"></i> <span id="slotsCount">Loading...</span> Slots Available
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- APPLICATION FORM (MOVED TO TOP) -->
  <section class="beta-form-section">
    <div class="container">
      <div class="row">
        <div class="col-md-12">
          <div class="form-container">
            <h2>Get Beta App Download Link</h2>
            <p class="form-subtitle">Enter your email to instantly receive the direct download link for our beta app</p>

            <div id="successMessage" class="success-message">
              <i class="fa fa-check-circle" style="font-size: 2rem; margin-bottom: 10px;"></i>
              <h3>Download Link Sent!</h3>
              <p>Check your email - we've sent you the direct download link for the BanjaraMatch Beta App. The app will be on Play Store soon!</p>
            </div>

            <form id="betaTesterForm">
<div class="bm-hp" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;overflow:hidden;">
  <label for="betaWebsite">Website</label>
  <input type="text" id="betaWebsite" name="website" tabindex="-1" autocomplete="off" value="">
</div>
              <div class="form-group">
                <label for="email" style="font-size: 1.1rem;">Enter Your Email Address *</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="your@email.com" required style="padding: 15px; font-size: 1.05rem;">
              </div>

              <div id="errorMessage" class="error-message"></div>

              <button type="submit" class="btn-submit">
                <span class="btn-text">Send Me Download Link</span>
                <span class="btn-loader" style="display:none;"><i class="fa fa-spinner fa-spin"></i> Sending...</span>
              </button>

              <p style="text-align: center; margin-top: 20px; font-size: 0.9rem; color: #666;">
                <i class="fa fa-android"></i> Instant download link delivery • <i class="fa fa-google"></i> Coming to Play Store soon • 100% Free
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS SECTION -->
  <section class="beta-content">
    <div class="container">
      <div class="row">
        <div class="col-md-12 text-center" style="margin-bottom: 40px;">
          <h2 style="font-size: 2.2rem; font-weight: 700; color: #333;">What You'll Get as a Beta Tester</h2>
          <p style="font-size: 1.1rem; color: #666;">Everyone gets BanjaraMatch FREE forever. Beta testers just get the future first.</p>
        </div>
      </div>
      <div class="row">
        <div class="col-md-4">
          <div class="feature-card">
            <div class="icon">🤖</div>
            <h3>AI-Powered Matching</h3>
            <p>Get early access to our intelligent AI matchmaking algorithm that learns your preferences and suggests highly compatible profiles</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="feature-card">
            <div class="icon">🎯</div>
            <h3>Advanced Filters</h3>
            <p>Access premium search filters including education, profession, family background, lifestyle preferences, and more before public release</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="feature-card">
            <div class="icon">✅</div>
            <h3>AI Profile Verification</h3>
            <p>Experience our smart verification system that uses AI to detect fake profiles and ensure authenticity months ahead of others</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="feature-card">
            <div class="icon">📱</div>
            <h3>Mobile App Beta</h3>
            <p>Be the first to test our Android app before public launch and help shape its features</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="feature-card">
            <div class="icon">⚡</div>
            <h3>Priority Features</h3>
            <p>All new features released to you first - video calls, voice messages, instant chat, and more</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="feature-card">
            <div class="icon">🏆</div>
            <h3>Lifetime Early Access</h3>
            <p>Once a beta tester, always first in line for every new feature we build. Forever.</p>
          </div>
        </div>
      </div>

      <div class="row" style="margin-top: 40px;">
        <div class="col-md-10 offset-md-1">
          <div class="note-text">
            <strong>📌 Important:</strong> BanjaraMatch will ALWAYS be 100% FREE for everyone. Beta testers don't pay anything - they just get to use advanced AI features 3-6 months before regular users. These features will eventually roll out to all users for free.
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <!--== SCRIPT FILES ==-->

  <%- include('../partials/scripts') %>
<script>
// Deferred bundle (partials/scripts.ejs): page code runs once the DOM and the deferred scripts are ready.
document.addEventListener('DOMContentLoaded', function () {
    $(document).ready(function() {
      // Load available slots count
      function loadSlots() {
        $.ajax({
          url: 'https://api.banjaramatch.com/api/beta-tester/stats',
          type: 'GET',
          success: function(response) {
            const total = response.data.total || 0;
            const maxSlots = 15; // Total slots available
            const available = maxSlots - total;
            $('#slotsCount').text(available > 0 ? available : 0);
            
            // Disable form if no slots available
            if (available <= 0) {
              $('#betaTesterForm').html('<div class="alert alert-warning" style="text-align:center; padding: 20px;"><strong>🚫 Beta Program Full</strong><br>All beta slots are currently filled. Check back later for new openings.</div>');
            }
          },
          error: function() {
            $('#slotsCount').text('Limited');
          }
        });
      }
      
      loadSlots();

      // Handle form submission
      $('#betaTesterForm').on('submit', function(e) {
        e.preventDefault();

        // Disable submit button
        const $submitBtn = $('.btn-submit');
        const $btnText = $('.btn-text');
        const $btnLoader = $('.btn-loader');
        
        $submitBtn.prop('disabled', true);
        $btnText.hide();
        $btnLoader.show();

        // Hide previous messages
        $('#errorMessage').hide();
        $('#successMessage').hide();

        // Collect form data (email only)
        const formData = {
          email: $('#email').val().trim()
        };

        // Submit to API
        $.ajax({
          url: 'https://api.banjaramatch.com/api/beta-tester/submit',
          type: 'POST',
          contentType: 'application/json',
          data: JSON.stringify(formData),
          success: function(response) {
            // Show success message
            $('#successMessage').fadeIn();
            
            // Hide form
            $('#betaTesterForm')[0].reset();
            $('html, body').animate({
              scrollTop: $('#successMessage').offset().top - 100
            }, 500);

            // Reload slot count
            loadSlots();

            // Track conversion
            if (typeof gtag !== 'undefined') {
              gtag('event', 'conversion', {
                'event_category': 'Beta Tester',
                'event_label': 'Application Submitted'
              });
            }
          },
          error: function(xhr) {
            // Show error message
            const errorMsg = xhr.responseJSON?.message || 'Something went wrong. Please try again.';
            $('#errorMessage').text(errorMsg).fadeIn();
            
            // Re-enable submit button
            $submitBtn.prop('disabled', false);
            $btnText.show();
            $btnLoader.hide();
          }
        });
      });
    });
});
</script>

</body>
</html>
