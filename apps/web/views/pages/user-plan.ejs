<!doctype html>
<html lang="en">
<head>
    <title><%= title || 'My Plan - Banjara Match' %></title>
    <!--== META TAGS ==-->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta name="theme-color" content="#f6af04">
    <meta name="description" content="View your Banjara Match membership plan">
    <meta name="robots" content="noindex, nofollow">
    <!--== FAV ICON(BROWSER TAB ICON) ==-->
    <link rel="shortcut icon" href="/images/fav.ico" type="image/x-icon">

    <!--== PERFORMANCE: Resource Hints ==-->
    <link rel="preconnect" href="https://api.banjaramatch.com">
    <link rel="dns-prefetch" href="https://api.banjaramatch.com">

    <!--== CSS FILES ==-->
    <link rel="stylesheet" href="/css/bootstrap.css">
    <link rel="stylesheet" href="/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/animate.min.css">
    <link rel="stylesheet" href="/css/style.min.css">

    <style>
    .plan-card {
        background: #fff;
        border-radius: 8px;
        padding: 30px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .plan-current-name {
        font-size: 26px;
        font-weight: 700;
        color: #f6af04;
        margin-bottom: 6px;
    }
    .plan-badge {
        display: inline-block;
        background: #f6af04;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 3px 12px;
        border-radius: 12px;
        margin-bottom: 15px;
    }
    .plan-badge.free {
        background: #9e9e9e;
    }
    .plan-features {
        list-style: none;
        padding: 0;
        margin: 20px 0;
    }
    .plan-features li {
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
        color: #444;
    }
    .plan-features li:before {
        content: "\f00c";
        font-family: FontAwesome;
        color: #2e7d32;
        margin-right: 10px;
    }
    .plan-upgrade-box {
        background: #fff8e1;
        border: 1px solid #f6af04;
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
    }
    </style>
</head>

<body>
    <%- include('../partials/header') %>

    <!-- PLAN -->
    <section>
        <div class="db">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 col-lg-3">
                        <div class="db-nav">
                            <div class="db-nav-pro">
                                <img src="<%= user?.profile || '/images/default-user.jpg' %>" class="img-fluid" alt="<%= user?.full_name || 'User' %>" onerror="this.src='/images/default-user.jpg'">
                            </div>
                            <div class="db-nav-list">
                                <ul>
                                    <li><a href="/dashboard"><i class="fa fa-tachometer" aria-hidden="true"></i>Dashboard</a></li>
                                    <li><a href="/update-profile"><i class="fa fa-male" aria-hidden="true"></i>Profile</a></li>
                                    <li><a href="/user-interests"><i class="fa fa-handshake-o" aria-hidden="true"></i>Interests</a></li>
                                    <li><a href="/shortlisted"><i class="fa fa-star" aria-hidden="true"></i>Shortlist</a></li>
                                    <li><a href="/profile-visitors"><i class="fa fa-eye" aria-hidden="true"></i>Visitors</a></li>
                                    <li><a href="/user-chat"><i class="fa fa-commenting-o" aria-hidden="true"></i>Chat list</a></li>
                                    <li><a href="/notifications"><i class="fa fa-bell" aria-hidden="true"></i>Notifications</a></li>
                                    <li><a href="/user-plan" class="act"><i class="fa fa-money" aria-hidden="true"></i>Plan</a></li>
                                    <li><a href="/user-setting"><i class="fa fa-cog" aria-hidden="true"></i>Setting</a></li>
                                    <li><a href="/blocked-users"><i class="fa fa-ban" aria-hidden="true"></i>Blocked Users</a></li>
                                    <li><a href="/logout"><i class="fa fa-sign-out" aria-hidden="true"></i>Log out</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8 col-lg-9">
                        <h2 class="db-tit">My Plan</h2>

                        <div class="plan-card">
                            <% const plan = user?.membershipPlan; %>
                            <% if (plan && plan.name) { %>
                                <span class="plan-badge"><%= plan.name %></span>
                                <div class="plan-current-name"><%= plan.name %> Membership</div>
                                <% if (plan.duration_days) { %>
                                    <p style="color:#777; margin-bottom:0;">Duration: <%= plan.duration_days %> days<% if (plan.price) { %> &middot; ₹<%= plan.price %><% } %></p>
                                <% } %>
                                <% if (plan.description) { %>
                                    <p style="color:#555; margin-top:15px;"><%= plan.description %></p>
                                <% } %>
                                <% if (plan.features && plan.features.length) { %>
                                    <ul class="plan-features">
                                        <% plan.features.forEach(function(f) { %>
                                            <li><%= f %></li>
                                        <% }); %>
                                    </ul>
                                <% } %>
                            <% } else { %>
                                <span class="plan-badge free">Free</span>
                                <div class="plan-current-name">Free Membership</div>
                                <p style="color:#777;">You're currently on the free plan. Upgrade to unlock premium visibility and features.</p>
                            <% } %>

                            <div class="plan-upgrade-box">
                                <h5 style="margin-top:0; color:#333;">Want to upgrade?</h5>
                                <p style="color:#555; margin-bottom:15px;">
                                    Online plan purchase isn't available yet — our team can upgrade your membership manually. Reach out and we'll take care of it.
                                </p>
                                <a href="/contact" class="btn" style="background:#f6af04; color:#fff; padding:10px 24px; border-radius:4px; font-weight:600;">Contact us to upgrade</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/select-opt.min.js"></script>
    <script src="/js/custom.min.js"></script>
</body>
</html>
