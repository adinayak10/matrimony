<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<style>
    .settings-card {
        background: #fff;
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .blocked-users-list {
        max-height: 600px;
        overflow-y: auto;
    }
    .blocked-user-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px;
        background: #f9f9f9;
        border-radius: 6px;
        margin-bottom: 10px;
    }
    .blocked-user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .blocked-user-info img {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
    }
    </style>
</head>

<body>
    <%- include('../partials/header') %>

    <section>
        <div class="db">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 col-lg-3">
                        <%- include('../partials/member-nav', { active: 'blocked' }) %>
                    </div>
                    <div class="col-md-8 col-lg-9">
                        <h2 class="db-tit">Blocked Users</h2>

                        <div class="settings-card">
                            <div id="blockedUsersList" class="blocked-users-list">
                                <p class="text-center text-muted">Loading blocked users...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>


    <%- include('../partials/scripts') %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const API_BASE_URL = '/api'; // same-origin proxy (middleware/apiProxy.js) injects the session Bearer
        const MY_USER_ID = '<%= user?._id %>';


        function photoUrl(profile) {
            if (!profile) return '/images/default-user.jpg';
            return profile.startsWith('http') ? profile : `https://api.banjaramatch.com/${profile}`;
        }

        async function loadBlockedUsers() {
            try {
                const response = await fetch(`${API_BASE_URL}/fetchBlockedUserList`, {
                    credentials: 'same-origin',
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ my_user_id: MY_USER_ID, limit: 100 })
                });
                const data = await response.json();

                if (data.status && data.data && data.data.length > 0) {
                    const html = data.data.map(u => `
                        <div class="blocked-user-item" data-user-id="${u._id}">
                            <div class="blocked-user-info">
                                <img src="${esc(photoUrl(u.profile))}" alt="${esc(u.full_name)}" onerror="this.src='/images/default-user.jpg'">
                                <div>
                                    <div style="font-weight: 600;">${esc(u.full_name || 'Unknown user')}</div>
                                    <div style="font-size: 13px; color: #777;">Blocked</div>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-danger unblock-btn" data-user-id="${u._id}">
                                <i class="fa fa-unlock"></i> Unblock
                            </button>
                        </div>
                    `).join('');
                    document.getElementById('blockedUsersList').innerHTML = html;
                } else {
                    document.getElementById('blockedUsersList').innerHTML = '<p class="text-center text-muted py-4">You haven\'t blocked anyone.</p>';
                }
            } catch (error) {
                console.error('Error loading blocked users:', error);
                document.getElementById('blockedUsersList').innerHTML = '<p class="text-center text-danger">Failed to load blocked users</p>';
            }
        }

        document.getElementById('blockedUsersList').addEventListener('click', async function(e) {
            const btn = e.target.closest('.unblock-btn');
            if (!btn) return;

            const userId = btn.dataset.userId;
            if (!window.confirm('Are you sure you want to unblock this user?')) return;

            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Unblocking...';

            try {
                const response = await fetch(`${API_BASE_URL}/UserUnblockedByUser`, {
                    credentials: 'same-origin',
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ my_user_id: MY_USER_ID, user_id: userId })
                });
                const data = await response.json();
                if (data.status) {
                    loadBlockedUsers();
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa fa-unlock"></i> Unblock';
                }
            } catch (error) {
                console.error('Error unblocking user:', error);
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-unlock"></i> Unblock';
            }
        });

        loadBlockedUsers();
    });
    </script>
</body>
</html>
