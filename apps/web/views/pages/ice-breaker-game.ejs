<!doctype html>
<html lang="en">
<head>
    <title>Ice Breaker Game - Banjara Match</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta name="theme-color" content="#667eea">
    <link rel="shortcut icon" href="/images/fav.ico" type="image/x-icon">
    
    <link rel="stylesheet" href="/css/bootstrap.css">
    <link rel="stylesheet" href="/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.min.css">
    
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Arial', sans-serif;
        }
        
        .game-container {
            max-width: 900px;
            margin: 50px auto;
            padding: 20px;
        }
        
        .game-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            text-align: center;
        }
        
        .game-status {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
        }
        
        .question-card {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 30px;
            margin: 30px 0;
        }
        
        .option-btn {
            background: white;
            border: 2px solid #667eea;
            color: #667eea;
            padding: 15px 25px;
            border-radius: 10px;
            margin: 10px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
            width: 100%;
            max-width: 400px;
        }
        
        .option-btn:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }
        
        .option-btn.selected {
            background: #667eea;
            color: white;
        }
        
        .option-btn.opponent-selected {
            background: #f5576c;
            border-color: #f5576c;
            color: white;
        }
        
        .waiting-animation {
            display: inline-block;
            width: 60px;
            height: 60px;
            border: 5px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .score-display {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
        }
        
        .score-item {
            text-align: center;
        }
        
        .score-item h3 {
            color: #667eea;
            margin: 0;
            font-size: 36px;
        }
        
        .player-info {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
        }
        
        .btn-primary-game {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 15px 40px;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s;
        }
        
        .btn-primary-game:hover {
            transform: scale(1.05);
        }
        
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(255,255,255,0.2);
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s;
        }
        
        .back-btn:hover {
            background: rgba(255,255,255,0.3);
            color: white;
        }
        
        .match-animation {
            font-size: 80px;
            animation: bounce 1s ease infinite;
        }
        
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }
        
        .timer {
            background: #f5576c;
            color: white;
            padding: 10px 20px;
            border-radius: 50px;
            font-weight: 700;
            display: inline-block;
            margin: 10px 0;
        }
    </style>
</head>

<body>
    <a href="/dashboard" class="back-btn">
        <i class="fa fa-arrow-left"></i> Back to Dashboard
    </a>
    
    <div class="game-container">
        <div class="game-card">
            <!-- Waiting for Match Screen -->
            <div id="waitingScreen">
                <div class="match-animation">🎮</div>
                <h2 style="color: #667eea; margin-top: 20px;">Ice Breaker Game</h2>
                <p style="color: #666; font-size: 16px; margin: 20px 0;">
                    Get matched with someone online and answer fun questions together!
                </p>
                <button class="btn-primary-game" onclick="joinGame()">
                    <i class="fa fa-play"></i> Find a Match
                </button>
                <div style="margin-top: 30px; color: #999;">
                    <i class="fa fa-users"></i> <span id="queueCount">...</span> players in queue
                </div>
            </div>
            
            <!-- Searching for Match -->
            <div id="searchingScreen" style="display: none;">
                <div class="waiting-animation"></div>
                <h3 style="color: #667eea; margin-top: 30px;">Finding your match...</h3>
                <p style="color: #666;">Connecting you with someone online</p>
                <button class="btn" style="margin-top: 20px; background: #f5576c; color: white; border: none; padding: 10px 30px; border-radius: 8px;" onclick="cancelSearch()">
                    Cancel
                </button>
            </div>
            
            <!-- Game Screen -->
            <div id="gameScreen" style="display: none;">
                <div class="player-info">
                    <div class="row">
                        <div class="col-6">
                            <h5><i class="fa fa-user"></i> You</h5>
                            <h3 id="myScore">0</h3>
                        </div>
                        <div class="col-6">
                            <h5><i class="fa fa-user"></i> <span id="opponentName">Opponent</span></h5>
                            <h3 id="opponentScore">0</h3>
                        </div>
                    </div>
                </div>
                
                <div class="timer">
                    <i class="fa fa-clock-o"></i> Question <span id="questionNumber">1</span> / 10
                </div>
                
                <div class="question-card">
                    <h4 id="questionText" style="color: #333; margin-bottom: 30px;">Loading question...</h4>
                    <div id="optionsContainer"></div>
                </div>
                
                <div id="waitingForOpponent" style="display: none; color: #667eea;">
                    <i class="fa fa-clock-o"></i> Waiting for opponent to answer...
                </div>
            </div>
            
            <!-- Results Screen -->
            <div id="resultsScreen" style="display: none;">
                <div style="font-size: 80px;" id="resultEmoji">🎉</div>
                <h2 style="color: #667eea; margin: 20px 0;" id="resultTitle">Game Complete!</h2>
                
                <div class="score-display">
                    <div class="score-item">
                        <h3 id="finalMyScore">0</h3>
                        <p style="color: #666;">Your Score</p>
                    </div>
                    <div class="score-item">
                        <h3 id="finalOpponentScore">0</h3>
                        <p style="color: #666;">Opponent Score</p>
                    </div>
                </div>
                
                <div style="margin: 30px 0;">
                    <p style="color: #666; font-size: 16px;" id="matchInfo">You matched on <strong id="matchCount">0</strong> out of 10 questions!</p>
                </div>
                
                <div id="compatibleMatch" style="display: none; background: #e8f5e9; padding: 20px; border-radius: 10px; margin: 20px 0;">
                    <h4 style="color: #2e7d32;">
                        <i class="fa fa-heart"></i> Great Compatibility!
                    </h4>
                    <p style="color: #555;">You and <span id="matchedWith"></span> have similar interests. Want to connect?</p>
                    <button class="btn-primary-game" onclick="sendInterest()">
                        <i class="fa fa-handshake-o"></i> Send Interest
                    </button>
                </div>
                
                <button class="btn-primary-game" onclick="playAgain()">
                    <i class="fa fa-refresh"></i> Play Again
                </button>
                
                <a href="/dashboard" class="btn" style="display: inline-block; margin-top: 15px; color: #667eea; text-decoration: none;">
                    Back to Dashboard
                </a>
            </div>
        </div>
    </div>
    
    <script src="/js/jquery-3.6.0.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    
    <script>
        const API_BASE_URL = 'https://api.banjaramatch.com';
        const MY_USER_ID = '<%= user._id %>';
        const MY_NAME = '<%= user.full_name %>';
        
        let socket;
        let gameState = {
            gameId: null,
            opponentId: null,
            opponentName: '',
            currentQuestion: null,
            myScore: 0,
            opponentScore: 0,
            matchedAnswers: 0
        };
        
        // Initialize Socket Connection
        function initSocket() {
            socket = io(API_BASE_URL);
            
            socket.on('connect', () => {
                console.log('✅ Connected to game server');
                socket.emit('join', MY_USER_ID);
                updateQueueCount();
            });
            
            // Game Events
            socket.on('icebreaker_matched', (data) => {
                console.log('🎮 Matched with opponent:', data);
                gameState.gameId = data.gameId;
                gameState.opponentId = data.opponent.userId;
                gameState.opponentName = data.opponent.name;
                showScreen('gameScreen');
                $('#opponentName').text(data.opponent.name);
            });
            
            socket.on('icebreaker_question', (data) => {
                console.log('❓ New question:', data);
                gameState.currentQuestion = data;
                displayQuestion(data);
            });
            
            socket.on('icebreaker_answer_result', (data) => {
                console.log('📊 Answer result:', data);
                updateScores(data);
            });
            
            socket.on('icebreaker_game_complete', (data) => {
                console.log('🎉 Game complete:', data);
                showResults(data);
            });
            
            socket.on('icebreaker_opponent_left', () => {
                alert('Opponent left the game. Returning to lobby.');
                resetGame();
            });
            
            socket.on('icebreaker_queue_update', (data) => {
                $('#queueCount').text(data.queueSize);
            });
        }
        
        function joinGame() {
            showScreen('searchingScreen');
            socket.emit('icebreaker_join_queue', {
                userId: MY_USER_ID,
                name: MY_NAME,
                preferences: {}
            });
        }
        
        function cancelSearch() {
            socket.emit('icebreaker_leave_queue', { userId: MY_USER_ID });
            showScreen('waitingScreen');
        }
        
        function displayQuestion(questionData) {
            $('#questionNumber').text(questionData.questionNumber);
            $('#questionText').text(questionData.question.question);
            
            const optionsHtml = questionData.question.options.map((option, index) => `
                <button class="option-btn" onclick="selectAnswer(${index}, '${option}')" data-index="${index}">
                    ${option}
                </button>
            `).join('');
            
            $('#optionsContainer').html(optionsHtml);
            $('#waitingForOpponent').hide();
        }
        
        function selectAnswer(index, answer) {
            // Disable all buttons
            $('.option-btn').prop('disabled', true);
            $('.option-btn[data-index="' + index + '"]').addClass('selected');
            
            // Send answer to server
            socket.emit('icebreaker_answer', {
                gameId: gameState.gameId,
                userId: MY_USER_ID,
                answer: answer
            });
            
            $('#waitingForOpponent').show();
        }
        
        function updateScores(data) {
            gameState.myScore = data.player1.userId === MY_USER_ID ? data.player1.score : data.player2.score;
            gameState.opponentScore = data.player1.userId === MY_USER_ID ? data.player2.score : data.player1.score;
            
            $('#myScore').text(gameState.myScore);
            $('#opponentScore').text(gameState.opponentScore);
            
            if (data.bothMatched) {
                gameState.matchedAnswers++;
            }
        }
        
        function showResults(data) {
            showScreen('resultsScreen');
            
            const myFinalScore = data.player1.userId === MY_USER_ID ? data.player1.score : data.player2.score;
            const opponentFinalScore = data.player1.userId === MY_USER_ID ? data.player2.score : data.player1.score;
            
            $('#finalMyScore').text(myFinalScore);
            $('#finalOpponentScore').text(opponentFinalScore);
            $('#matchCount').text(gameState.matchedAnswers);
            
            if (myFinalScore > opponentFinalScore) {
                $('#resultEmoji').text('🏆');
                $('#resultTitle').text('You Win!');
            } else if (myFinalScore < opponentFinalScore) {
                $('#resultEmoji').text('😊');
                $('#resultTitle').text('Nice Try!');
            } else {
                $('#resultEmoji').text('🤝');
                $('#resultTitle').text("It's a Tie!");
            }
            
            // Show connect option if high compatibility (6+ matches)
            if (gameState.matchedAnswers >= 6) {
                $('#compatibleMatch').show();
                $('#matchedWith').text(gameState.opponentName);
            }
        }
        
        function sendInterest() {
            fetch(`${API_BASE_URL}/api/sendInterestRequest`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    my_user_id: MY_USER_ID,
                    user_id: gameState.opponentId
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.status) {
                    alert('Interest sent successfully! 💚');
                    $('#compatibleMatch').hide();
                } else {
                    alert(data.message || 'Unable to send interest');
                }
            })
            .catch(err => {
                console.error('Error sending interest:', err);
                alert('Error sending interest. Please try again.');
            });
        }
        
        function playAgain() {
            resetGame();
            joinGame();
        }
        
        function resetGame() {
            gameState = {
                gameId: null,
                opponentId: null,
                opponentName: '',
                currentQuestion: null,
                myScore: 0,
                opponentScore: 0,
                matchedAnswers: 0
            };
            showScreen('waitingScreen');
        }
        
        function showScreen(screenId) {
            $('#waitingScreen, #searchingScreen, #gameScreen, #resultsScreen').hide();
            $('#' + screenId).show();
        }
        
        function updateQueueCount() {
            fetch(`${API_BASE_URL}/api/getIcebreakerStats`)
                .then(res => res.json())
                .then(data => {
                    if (data.status) {
                        $('#queueCount').text(data.data.queuedPlayers || 0);
                    }
                })
                .catch(err => console.error('Error fetching stats:', err));
        }
        
        // Initialize on page load
        $(document).ready(() => {
            initSocket();
            setInterval(updateQueueCount, 5000);
        });
    </script>
</body>
</html>
