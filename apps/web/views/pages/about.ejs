<section>
  <div class="ab-faq" id="faq">
    <div class="container">
      <div class="row">
        <!-- SUB TITLE -->
        <div class="sub-tit-caps">
          <h2>BanjaraMatch <span class="animate animate__animated" data-ani="animate__flipInX" data-dely="0.1">FAQs</span></h2>
          <p>Your questions answered about the Banjara matrimony platform.</p>
        </div>

        <!-- BACKGROUND SHAPES -->
        <div class="wedd-shap">
