<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<%
    const stateName = typeof page.state === 'object' ? page.state.name : page.state;
    const defaultTitle = `Banjara Matrimony in ${stateName} - Free Lambani Matches Across the State`;
    // Normalize legacy flat fields against the real nested schema (heroSection/introSection/faqSection)
    // so real CMS content renders instead of always falling back to generic boilerplate.
    const heroTitle = page.heroTitle || (page.heroSection && page.heroSection.title);
    const heroSubtitle = page.heroSubtitle || (page.heroSection && page.heroSection.subtitle);
    const introHeading = page.introHeading || (page.introSection && page.introSection.heading);
    const introContent = page.introContent || (page.introSection && page.introSection.content);
    const pageFaqs = (page.faqs && page.faqs.length > 0) ? page.faqs : ((page.faqSection && page.faqSection.faqs) || []);
    %>
</head>

<body>
    <%- include('../partials/header') %>

    <%- include('../partials/breadcrumb') %>

    <!-- BANNER & SEARCH -->
    <section style="position: relative; z-index: 2;">
        <div class="str">
            <div class="hom-head" style="display: flex; justify-content: center; align-items: center; height: auto; min-height: auto;">
                <div class="container">
                    <div class="row" style="justify-content: center;">
                        <div class="hom-ban" style="display: flex; flex-direction: column; align-items: center;">
                            <div class="ban-tit">
                                <span><i class="no1">#1</i> <%= stateName %> Banjara Matrimony</span>
                                <h1>
                                    <% if (heroTitle) { %>
                                        <%= heroTitle %>
                                    <% } else { %>
                                        India's First <strong>Free</strong> <b>Banjara Matrimony</b> in <%= stateName %>
                                    <% } %>
                                </h1>
                                <p>
                                    <% if (heroSubtitle) { %>
                                        <%= heroSubtitle %>
                                    <% } else { %>
                                        Connect with verified Banjara/Lambani/Gormati profiles across <%= stateName %>. Find your perfect life partner from all major cities in the Banjara community with <strong>100% Free matrimonial service</strong> - No hidden charges, completely free forever.
                                    <% } %>
                                </p>
                            </div>
                            <div class="ban-search chosenini">
                                <form action="<%= user ? '/all-profiles' : '/register' %>" method="GET" class="hero-search" data-guest="<%= user ? '0' : '1' %>">
                                    <% if (!user) { %><input type="hidden" name="intent" value="search"><% } %>
                                    <input type="hidden" name="state" value="<%= stateName %>">
                                    <ul>
                                        <li class="sr-look">
                                            <div class="form-group">
                                                <label>I'm looking for</label>
                                                <select class="chosen-select" name="gender">
                                                    <option value="">I'm looking for</option>
                                                    <option value="Male">Men</option>
                                                    <option value="Female">Women</option>
                                                </select>
                                            </div>
                                        </li>
                                        <li class="sr-age">
                                            <div class="form-group">
                                                <label>Age</label>
                                                <select class="chosen-select" name="age">
                                                    <option value="">Age</option>
                                                    <option value="18-25">18 to 25</option>
                                                    <option value="26-30">26 to 30</option>
                                                    <option value="31-35">31 to 35</option>
                                                    <option value="36-40">36 to 40</option>
                                                    <option value="41-50">41 to 50</option>
                                                    <option value="51-60">51 to 60</option>
                                                    <option value="61-70">61 to 70</option>
                                                </select>
                                            </div>
                                        </li>
                                        <li class="sr-reli">
                                            <div class="form-group">
                                                <label>Marital Status</label>
                                                <select class="chosen-select" name="maritalStatus">
                                                    <option value="">Marital Status</option>
                                                    <option value="Never Married">Never Married</option>
                                                    <option value="Divorced">Divorced</option>
                                                    <option value="Widowed">Widowed</option>
                                                    <option value="Awaiting Divorce">Awaiting Divorce</option>
                                                </select>
                                            </div>
                                        </li>
                                        <li class="sr-cit">
                                            <div class="form-group">
                                                <label>City</label>
                                                <select class="chosen-select" name="city">
                                                    <option value="">All Cities in <%= page.state.name %></option>
                                                    <% if (page.relatedCityPages && page.relatedCityPages.length > 0) { %>
                                                        <% page.relatedCityPages.forEach(cityPage => { 
                                                            const cpName = cityPage.city?.name || '';
                                                        %>
                                                            <option value="<%= cpName %>"><%= cpName %></option>
                                                        <% }); %>
                                                    <% } else if (page.nearbyCities && page.nearbyCities.length > 0) { %>
                                                        <% page.nearbyCities.forEach(nearbyCity => { 
                                                            const ncName = typeof nearbyCity === 'object' ? nearbyCity.name : nearbyCity;
                                                        %>
                                                            <option value="<%= ncName %>"><%= ncName %></option>
                                                        <% }); %>
                                                    <% } %>
                                                </select>
                                            </div>
                                        </li>
                                        <li class="sr-btn">
                                            <input type="submit" value="Search">
                                        </li>
                                    </ul>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- END -->

    <!-- BANNER SLIDER -->
    <section style="position: relative; z-index: 1;">
        <div class="hom-ban-sli">
            <div>
                <ul class="ban-sli">
                    <% if (page.bannerImages && page.bannerImages.length > 0) { %>
                        <% page.bannerImages.forEach(banner => { %>
                        <li>
                            <div class="image">
                                <img src="<%= banner.url %>" alt="<%= banner.alt || `${page.state.name} Banjara matrimony` %>" loading="lazy">
                            </div>
                        </li>
                        <% }); %>
                    <% } else { %>
                    <li>
                        <div class="image">
                            <img src="/images/ban-bg.jpg" alt="<%= page.state.name %> Banjara matrimony - Happy couple" loading="lazy">
                        </div>
                    </li>
                    <li>
                        <div class="image">
                            <img src="/images/banner.jpg" alt="BanjaraMatch <%= page.state.name %> - Free matrimony" loading="lazy">
                        </div>
                    </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </section>
    <!-- END -->

    <% if (page.stats && page.stats.totalMembers >= 25) { %>
    <!-- COUNTS START -->
    <section style="position: relative; z-index: 3;">
        <div class="ab-cont">
            <div class="container">
                <div class="row">
                    <ul>
                        <li>
                            <div class="ab-cont-po">
                                <i class="fa fa-users" aria-hidden="true"></i>
                                <div>
                                    <h4><%= page.stats.totalMembers %></h4>
                                    <span>Active Members</span>
                                </div>
                            </div>
                        </li>
                        <% if (page.stats.activeGrooms) { %>
                        <li>
                            <div class="ab-cont-po">
                                <i class="fa fa-male" aria-hidden="true"></i>
                                <div>
                                    <h4><%= page.stats.activeGrooms %></h4>
                                    <span>Verified Grooms</span>
                                </div>
                            </div>
                        </li>
                        <% } %>
                        <% if (page.stats.activeBrides) { %>
                        <li>
                            <div class="ab-cont-po">
                                <i class="fa fa-female" aria-hidden="true"></i>
                                <div>
                                    <h4><%= page.stats.activeBrides %></h4>
                                    <span>Verified Brides</span>
                                </div>
                            </div>
                        </li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <!-- END -->
    <% } %>

    <!-- QUICK ACCESS / OUR SERVICES -->
    <section style="position: relative; z-index: 4;">
        <div class="str home-acces-main">
            <div class="container">
                <div class="row">
                    <div class="wedd-shap">
                        <span class="abo-shap-1"></span>
                        <span class="abo-shap-4"></span>
                    </div>
                    <div class="home-tit">
                        <p>Quick Access</p>
                        <h2><span>Our Services in <%= stateName %></span></h2>
                        <span class="leaf1"></span>
                        <span class="tit-ani-"></span>
                    </div>
                    <div class="home-acces">
                        <ul class="hom-qui-acc-sli">
                            <li>
                                <div class="hacc hacc1">
                                    <div class="con">
                                        <img src="/images/icon/user.png" alt="Browse Profiles" loading="lazy">
                                        <h4>Browse Profiles</h4>
                                        <p>Profiles in <%= stateName %></p>
                                        <a href="/all-profiles?state=<%= stateName %>">View more</a>
                                    </div>
                                </div>
                            </li>
                            <li>
                                <div class="hacc hacc3">
                                    <div class="con">
                                        <img src="/images/icon/couple.png" alt="About Us" loading="lazy">
                                        <h4>About Us</h4>
                                        <p>Know our mission</p>
                                        <a href="/about">View more</a>
                                    </div>
                                </div>
                            </li>
                            <li>
                                <div class="hacc hacc4">
                                    <div class="con">
                                        <% if (typeof user !== 'undefined' && user) { %>
                                            <img src="/images/icon/hall.png" alt="My Dashboard" loading="lazy">
                                            <h4>My Dashboard</h4>
                                            <p>Manage profile</p>
                                            <a href="/dashboard">View more</a>
                                        <% } else { %>
                                            <img src="/images/icon/hall.png" alt="Join Now" loading="lazy">
                                            <h4>Join Now</h4>
                                            <p>Start for free</p>
                                            <a href="/register">Get started</a>
                                        <% } %>
                                    </div>
                                </div>
                            </li>
                            <li>
                                <div class="hacc hacc4">
                                    <div class="con">
                                        <img src="/images/icon/cake.png" alt="Blog & Articles" loading="lazy">
                                        <h4>Blog & Articles</h4>
                                        <p>Tips & stories</p>
                                        <a href="/blogs/culture">Read now</a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- END -->

    <!-- WHY CHOOSE US -->
    <section style="position: relative; z-index: 4;">
        <div class="ab-sec2">
            <div class="container">
                <div class="row">
                    <div class="home-tit">
                        <h2>Why Choose BanjaraMatch in <%= stateName %></h2>
                        <span class="leaf1"></span>
                        <span class="tit-ani-"></span>
                    </div>
                    <ul>
                        <li>
                            <div class="animate animate__animated animate__slower" data-ani="animate__flipInX" data-dely="0.1">
                                <img src="/images/icon/prize.png" alt="100% Free Service" loading="lazy">
                                <h4>100% Free & Verified Profiles</h4>
                                <p>Every profile in <%= stateName %> is manually verified to ensure genuine Banjara community users - no hidden costs, completely free forever.</p>
                            </div>
                        </li>
                        <li>
                            <div class="animate animate__animated animate__slower" data-ani="animate__flipInX" data-dely="0.3">
                                <img src="/images/icon/trust.png" alt="Trusted Platform" loading="lazy">
                                <h4>Trusted by <%= stateName %> Community</h4>
                                <p>The pioneering platform exclusively for the Banjara community, built for secure matchmaking in <%= stateName %>.</p>
                            </div>
                        </li>
                        <li>
                            <div class="animate animate__animated animate__slower" data-ani="animate__flipInX" data-dely="0.6">
                                <img src="/images/icon/rings.png" alt="Success Stories" loading="lazy">
                                <h4>Successful Weddings</h4>
                                <p>We've proudly helped Banjara couples from across <%= stateName %> start their love journey at no cost, preserving our cultural heritage.</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <!-- END -->

    <% if (introHeading || introContent) { %>
    <!-- INTRO SECTION -->
    <section style="position: relative; z-index: 4; padding: 60px 0; background: #fff;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="home-tit text-center">
                        <h2><%= introHeading || `Welcome to Banjara Matrimony in ${stateName}` %></h2>
                        <span class="leaf1"></span>
                        <span class="tit-ani-"></span>
                    </div>
                    <% if (introContent) { %>
                    <div style="max-width: 900px; margin: 30px auto 0 auto; font-size: 16px; line-height: 1.8; color: #555; text-align: center;">
                        <%- /* raw-ok: admin CMS HTML, sanitised on write (Track A sanitize-html) */ introContent.replace(/\n/g, '<br>') %>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>
    <!-- END -->
    <% } %>

    <% if (page.aboutHeading || page.aboutContent || (page.aboutSection && page.aboutSection.content)) { %>
    <!-- ABOUT SECTION -->
    <section style="position: relative; z-index: 4;">
        <div class="ab-wel">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="ab-wel-lhs">
                            <span class="ab-wel-3"></span>
                            <img src="/images/about/1.jpg" alt="Banjara couple <%= stateName %>" loading="lazy" class="ab-wel-1">
                            <img src="/images/couples/20.jpg" alt="Happy Banjara married couple <%= stateName %>" loading="lazy" class="ab-wel-2">
                            <span class="ab-wel-4"></span>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="ab-wel-rhs">
                            <div class="ab-wel-tit">
                                <h2>
                                    <%= page.aboutHeading || (page.aboutSection && page.aboutSection.title) || `About Banjara Matrimony in ${stateName}` %>
                                </h2>
                                <div style="font-size: 15px; line-height: 1.8; color: #666;">
                                    <% if (page.aboutContent) { %>
                                        <%- /* raw-ok: admin CMS HTML, sanitised on write (Track A sanitize-html) */ page.aboutContent.replace(/\n/g, '<br>') %>
                                    <% } else if (page.aboutSection && page.aboutSection.content) { %>
                                        <%- /* raw-ok: admin CMS HTML, sanitised on write (Track A sanitize-html) */ page.aboutSection.content %>
                                    <% } else { %>
                                        <p>BanjaraMatch is proud to serve the Banjara/Lambani/Gormati community across <%= stateName %>. Our platform connects verified profiles seeking matrimonial alliances within our community from all major cities in the state.</p>
                                        <p>Join thousands of <%= stateName %>-based Banjara members who have found their life partners through our 100% free matrimonial service. We preserve traditions while embracing modern matchmaking.</p>
                                    <% } %>
                                </div>
                                <div style="margin-top: 25px;">
                                    <a href="/register" class="cta" style="margin-right: 15px;">Register Free</a>
                                    <a href="/all-profiles?state=<%= stateName %>" class="cta-dark">Browse Profiles</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <% if (page.whyChooseSection && page.whyChooseSection.points && page.whyChooseSection.points.length > 0) { %>
    <!-- WHY CHOOSE US -->
    <section style="position: relative; z-index: 4;">
        <div class="ab-sec2">
            <div class="container">
                <div class="row">
                    <div class="home-tit">
                        <h2><%= page.whyChooseSection.title || `Why Choose BanjaraMatch in ${stateName}` %></h2>
                        <span class="leaf1"></span>
                        <span class="tit-ani-"></span>
                    </div>
                    <ul>
                        <% page.whyChooseSection.points.forEach((point, index) => { %>
                        <li>
                            <div class="animate animate__animated animate__slower" data-ani="animate__flipInX" data-dely="<%= 0.1 + (index * 0.2) %>">
                                <% if (point.icon) { %>
                                    <img src="<%= point.icon %>" alt="<%= point.title %>" loading="lazy">
                                <% } else { %>
                                    <img src="/images/icon/prize.png" alt="<%= point.title %>" loading="lazy">
                                <% } %>
                                <h4><%= point.title %></h4>
                                <p><%= point.description %></p>
                            </div>
                        </li>
                        <% }); %>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- MOBILE APP DOWNLOAD SECTION -->
    <section style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 80px 0; position: relative; overflow: hidden; z-index: 4;">
        <div style="position: absolute; top: -50px; right: -50px; width: 300px; height: 300px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
        <div style="position: absolute; bottom: -100px; left: -100px; width: 400px; height: 400px; background: rgba(255,255,255,0.05); border-radius: 50%;"></div>
        
        <div class="container" style="position: relative; z-index: 2;">
            <div class="row align-items-center">
                <div class="col-lg-6 text-center text-lg-left mb-4 mb-lg-0">
