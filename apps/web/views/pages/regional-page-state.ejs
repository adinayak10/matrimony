                        <span style="background: rgba(255,255,255,0.2); padding: 8px 20px; border-radius: 30px; font-size: 14px; display: inline-block; margin-bottom: 20px;">
                            <i class="fa fa-magic" style="font-size: 18px; margin-right: 8px;"></i>
                            AI-Powered Technology
                        </span>
                        <h2 style="font-size: 42px; font-weight: 700; margin-bottom: 20px; color: white;">
                            Find <%= stateName %> Matches on Mobile
                        </h2>
                        <p style="font-size: 18px; margin-bottom: 30px; color: rgba(255,255,255,0.9); line-height: 1.8;">
                            Connect with verified Banjara profiles in <%= stateName %> on-the-go! Download our AI-powered mobile app for smart matchmaking and instant notifications.
                        </p>
                        
                        <div style="margin-bottom: 25px;">
                            <div style="display: flex; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 15px;">
                                <div style="display: flex; align-items: center;">
                                    <i class="fa fa-check-circle" style="color: #4ade80; font-size: 24px; margin-right: 10px;"></i>
                                    <span style="font-size: 16px; color: white;">AI match suggestions</span>
                                </div>
                                <div style="display: flex; align-items: center;">
                                    <i class="fa fa-check-circle" style="color: #4ade80; font-size: 24px; margin-right: 10px;"></i>
                                    <span style="font-size: 16px; color: white;">100% free forever</span>
                                </div>
                            </div>
                        </div>
                        
                        <a href="https://api.banjaramatch.com/api/download-apk" class="btn" style="background: white; color: #667eea; padding: 15px 35px; border-radius: 50px; font-weight: 600; font-size: 16px; border: none; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                            <i class="fa fa-android" style="font-size: 24px;"></i>
                            <div style="text-align: left;">
                                <div style="font-size: 11px; opacity: 0.8;">Download for</div>
                                <div style="font-size: 16px; font-weight: 700;">Android APK</div>
                            </div>
                        </a>
                    </div>
                </div>
                
                <div class="col-lg-6 text-center">
                    <div style="position: relative; display: inline-block;">
                        <img src="/images/app-mockup.png" alt="BanjaraMatch Mobile App" 
                                onerror="this.src='/images/default-mobile-app.png'" 
                                style="max-width: 100%; height: auto; max-height: 500px; filter: drop-shadow(0 20px 60px rgba(0,0,0,0.5));">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SERVICE HIGHLIGHT SECTION -->
    <section style="background: linear-gradient(135deg, #f6af04 0%, #ff8c00 100%); padding: 60px 0; color: white; position: relative; z-index: 4;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <h2 style="font-size: 42px; margin-bottom: 20px; font-weight: 700;">🎉 Completely Free Forever!</h2>
                    <p style="font-size: 18px; margin-bottom: 30px; line-height: 1.6;">
                        Unlike other matrimonial sites that charge thousands, BanjaraMatch is 100% free for <%= stateName %> Banjara community
                    </p>
                    <div class="row" style="margin-top: 40px;">
                        <div class="col-md-3 mb-3">
                            <div class="free-feature">
                                <i class="fa fa-user-plus" style="font-size: 36px; margin-bottom: 15px;"></i>
                                <h4>Registration</h4>
                                <p style="margin: 0;">Create profile at zero cost</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="free-feature">
                                <i class="fa fa-search" style="font-size: 36px; margin-bottom: 15px;"></i>
                                <h4>Profile Search</h4>
                                <p style="margin: 0;">Browse unlimited profiles</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="free-feature">
                                <i class="fa fa-heart" style="font-size: 36px; margin-bottom: 15px;"></i>
                                <h4>Matchmaking</h4>
                                <p style="margin: 0;">Send unlimited interests</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="free-feature">
                                <i class="fa fa-comments" style="font-size: 36px; margin-bottom: 15px;"></i>
                                <h4>Communication</h4>
                                <p style="margin: 0;">Chat with matches</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BANJARA COMMUNITY INFO SECTION -->
    <section style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); padding: 80px 0; position: relative; z-index: 4;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="home-tit text-center">
                        <p>Heritage & Culture</p>
                        <h2><span>Banjara Community in <%= stateName %></span></h2>
                        <span class="leaf1"></span>
                        <span class="tit-ani-"></span>
                    </div>
                    
                    <div style="margin-top: 50px;">
                        <div class="row">
                            <div class="col-lg-12 text-center">
                                <p style="font-size: 16px; line-height: 1.7; color: #555; max-width: 900px; margin: 0 auto 30px;">
                                    The <strong>Banjara community</strong> in <%= stateName %>, also known as <strong>Lambani</strong> or <strong>Gormati</strong>, has a rich cultural heritage. Known for colorful traditional attire, unique embroidery work, and strong community bonds, Banjaras have preserved their distinct identity across generations.
                                </p>
                                <p style="font-size: 16px; line-height: 1.7; color: #555; max-width: 900px; margin: 0 auto;">
                                    BanjaraMatch honors these values by providing a platform where traditional matchmaking meets modern convenience - completely free for the <%= stateName %> Banjara community. Join verified profiles from <%= stateName %> today!
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BANJARA SUBCASTES SECTION -->
    <section style="background: #fff; padding: 80px 0; position: relative; z-index: 4;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="home-tit text-center">
                        <p>Community Diversity</p>
                        <h2><span>Banjara Sub-Communities in <%= stateName %></span></h2>
                        <span class="leaf1"></span>
                        <span class="tit-ani-"></span>
                    </div>
                    
                    <div style="margin-top: 50px;">
                        <div class="row">
                            <div class="col-lg-4 col-md-6 mb-4">
                                <div style="background: #f8f9fa; padding: 30px; border-radius: 15px; text-align: center; box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
