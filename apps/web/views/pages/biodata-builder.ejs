<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<script>
  // html2pdf (≈350 KB) is fetched on the first download click, not on page load (D4.36).
  // biodata-builder.js calls html2pdf().set(opt).from(el).save().then(...): the shim
  // records the chain, loads the library, then replays it.
  (function () {
    var SRC = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
    var loading = null;
    function load() {
      if (window.html2pdf && !window.html2pdf.__shim) return Promise.resolve(window.html2pdf);
      if (!loading) loading = new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = SRC; s.async = true;
        s.onload = function () { resolve(window.html2pdf); };
        s.onerror = function () { loading = null; reject(new Error('html2pdf failed to load')); };
        document.head.appendChild(s);
      });
      return loading;
    }
    function shim() {
      var ops = [];
      var w = {
        set: function (o) { ops.push(['set', o]); return w; },
        from: function (e) { ops.push(['from', e]); return w; },
        save: function (f) {
          return load().then(function (lib) {
            var real = lib();
            ops.forEach(function (op) { real = real[op[0]](op[1]); });
            return real.save(f);
          });
        }
      };
      return w;
    }
    shim.__shim = true;
    window.html2pdf = shim;
  })();
</script>
</head>

<body>
<%- include('../partials/header') %>
<%- include('../partials/breadcrumb') %>

  <!-- MAIN CONTENT -->
  <section>
    <div class="biodata-builder-section">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <div class="biodata-builder-header">
              <h1 class="animate__animated animate__fadeInDown">
                <i class="fa fa-file-text-o"></i> Marriage Biodata Builder
              </h1>
              <p class="animate__animated animate__fadeInUp">Create a professional biodata with our beautiful templates - Free & Instant PDF Download</p>
            </div>
          </div>
        </div>

        <!-- Template Selection -->
        <div class="row">
          <div class="col-md-12">
            <div class="template-selector animate__animated animate__fadeIn">
              <h3><i class="fa fa-magic"></i> Choose Your Template</h3>
              <div class="template-grid">
                <div class="template-card" data-template="classic" onclick="selectTemplate('classic')">
                  <div class="template-preview classic-preview">
                    <i class="fa fa-file-text-o"></i>
                    <span>CLASSIC</span>
                  </div>
                  <h4>Classic</h4>
                  <p>Traditional & elegant</p>
                </div>
                <div class="template-card" data-template="modern" onclick="selectTemplate('modern')">
                  <div class="template-preview modern-preview">
                    <i class="fa fa-file-text"></i>
                    <span>MODERN</span>
                  </div>
                  <h4>Modern</h4>
                  <p>Clean & contemporary</p>
                </div>
                <div class="template-card" data-template="elegant" onclick="selectTemplate('elegant')">
                  <div class="template-preview elegant-preview">
                    <i class="fa fa-heart-o"></i>
                    <span>ELEGANT</span>
                  </div>
                  <h4>Elegant</h4>
                  <p>Sophisticated design</p>
                </div>
                <div class="template-card" data-template="royal" onclick="selectTemplate('royal')">
                  <div class="template-preview royal-preview">
                    <i class="fa fa-star-o"></i>
                    <span>ROYAL</span>
                  </div>
                  <h4>Royal</h4>
                  <p>Premium & luxurious</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Form and Preview -->
        <div class="row">
          <!-- Form Section -->
          <div class="col-lg-6">
            <div class="biodata-form-container animate__animated animate__fadeInLeft">
              <h3><i class="fa fa-edit"></i> Enter Your Details</h3>
              <form id="biodataForm">
                <!-- Personal Information -->
                <div class="form-section">
                  <h4>Personal Information</h4>
                  
                  <div class="form-group">
                    <label>Full Name <span class="required">*</span></label>
                    <input type="text" class="form-control" id="fullName" required>
                  </div>

                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>Date of Birth <span class="required">*</span></label>
                        <input type="date" class="form-control" id="dob" required>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>Gender <span class="required">*</span></label>
                        <select class="form-control" id="gender" required>
                          <option value="">Select Gender</option>
                          <option value="Male">Male</option>
                          <option value="Female">Female</option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>Height</label>
                        <input type="text" class="form-control" id="height" placeholder="e.g., 5'8&quot;">
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>Marital Status <span class="required">*</span></label>
                        <select class="form-control" id="maritalStatus" required>
                          <option value="">Select Status</option>
                          <option value="Never Married">Never Married</option>
                          <option value="Divorced">Divorced</option>
                          <option value="Widowed">Widowed</option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Religion & Caste</label>
                    <input type="text" class="form-control" id="religion" placeholder="e.g., Hindu - Banjara">
                  </div>

                  <div class="form-group">
                    <label>Complexion</label>
                    <input type="text" class="form-control" id="complexion" placeholder="e.g., Fair, Wheatish, Dark">
                  </div>
                </div>

                <!-- Contact Information -->
                <div class="form-section">
                  <h4>Contact Information</h4>
                  
                  <div class="form-group">
                    <label>Address</label>
                    <textarea class="form-control" id="address" rows="2" placeholder="Current Address"></textarea>
                  </div>

                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>City</label>
                        <input type="text" class="form-control" id="city">
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>State</label>
                        <input type="text" class="form-control" id="state">
                      </div>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>Mobile Number <span class="required">*</span></label>
                        <input type="tel" class="form-control" id="mobile" required>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" class="form-control" id="email">
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Educational & Professional Details -->
                <div class="form-section">
                  <h4>Education & Career</h4>
                  
                  <div class="form-group">
                    <label>Highest Education</label>
                    <input type="text" class="form-control" id="education" placeholder="e.g., B.Tech, MBA, M.Sc">
                  </div>

                  <div class="form-group">
                    <label>Occupation</label>
                    <input type="text" class="form-control" id="occupation" placeholder="e.g., Software Engineer">
                  </div>

                  <div class="form-group">
                    <label>Annual Income</label>
                    <input type="text" class="form-control" id="income" placeholder="e.g., ₹5-7 Lakhs">
                  </div>

                  <div class="form-group">
                    <label>Working Location</label>
                    <input type="text" class="form-control" id="workLocation" placeholder="e.g., Bangalore">
                  </div>
                </div>

                <!-- Family Details -->
                <div class="form-section">
                  <h4>Family Information</h4>
                  
                  <div class="form-group">
                    <label>Father's Name</label>
                    <input type="text" class="form-control" id="fatherName">
                  </div>

                  <div class="form-group">
                    <label>Father's Occupation</label>
                    <input type="text" class="form-control" id="fatherOccupation">
                  </div>

                  <div class="form-group">
                    <label>Mother's Name</label>
                    <input type="text" class="form-control" id="motherName">
                  </div>

                  <div class="form-group">
                    <label>Mother's Occupation</label>
                    <input type="text" class="form-control" id="motherOccupation">
                  </div>

                  <div class="row">
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>Brothers</label>
                        <input type="text" class="form-control" id="brothers" placeholder="e.g., 1 (Married)">
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-group">
                        <label>Sisters</label>
                        <input type="text" class="form-control" id="sisters" placeholder="e.g., 1 (Unmarried)">
                      </div>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Family Type</label>
                    <select class="form-control" id="familyType">
                      <option value="">Select Type</option>
                      <option value="Joint Family">Joint Family</option>
                      <option value="Nuclear Family">Nuclear Family</option>
                    </select>
                  </div>
                </div>

                <!-- Partner Preferences -->
                <div class="form-section">
                  <h4>Partner Preferences</h4>
                  
                  <div class="form-group">
                    <label>Age Range</label>
                    <input type="text" class="form-control" id="partnerAge" placeholder="e.g., 25-30 years">
                  </div>

                  <div class="form-group">
                    <label>Height Range</label>
                    <input type="text" class="form-control" id="partnerHeight" placeholder="e.g., 5'4&quot; to 5'8&quot;">
                  </div>

                  <div class="form-group">
                    <label>Education Preference</label>
                    <input type="text" class="form-control" id="partnerEducation" placeholder="e.g., Graduate or above">
                  </div>

                  <div class="form-group">
                    <label>Location Preference</label>
                    <input type="text" class="form-control" id="partnerLocation" placeholder="e.g., Anywhere in India">
                  </div>

                  <div class="form-group">
                    <label>Additional Preferences</label>
                    <textarea class="form-control" id="additionalPreferences" rows="3" placeholder="Any specific requirements or preferences..."></textarea>
                  </div>
                </div>

                <!-- Photo Upload -->
                <div class="form-section">
                  <h4>Profile Photo</h4>
                  <div class="form-group">
                    <label>Upload Photo (Optional)</label>
                    <input type="file" class="form-control-file" id="photoUpload" accept="image/*">
                    <small class="form-text text-muted">For best results, use a passport-size photo (recommended)</small>
                  </div>
                  <div id="photoPreview" class="photo-preview-container" style="display: none;">
                    <img id="previewImage" src="" alt="Preview">
                  </div>
                </div>

                <!-- Action Buttons -->
                <div class="form-actions">
                  <button type="button" class="btn btn-primary btn-lg" onclick="previewBiodata()">
                    <i class="fa fa-eye"></i> Preview Biodata
                  </button>
                  <button type="button" class="btn btn-warning btn-lg" onclick="resetForm()">
                    <i class="fa fa-refresh"></i> Reset Form
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- Preview Section -->
          <div class="col-lg-6">
            <div class="biodata-preview-container animate__animated animate__fadeInRight">
              <div class="preview-header">
                <h3><i class="fa fa-eye"></i> Live Preview</h3>
                <button class="btn btn-success" onclick="downloadPDF()" id="downloadBtn" disabled>
                  <i class="fa fa-download"></i> Download PDF
                </button>
              </div>
              
              <div id="biodataPreview" class="biodata-preview">
                <div class="preview-placeholder">
                  <i class="fa fa-file-text-o fa-5x"></i>
                  <p>Fill in the form to see your biodata preview</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
