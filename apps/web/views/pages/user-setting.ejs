<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<style>
    .settings-card {
        background: #fff;
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .settings-card h4 {
        color: #f6af04;
        margin-bottom: 20px;
        font-size: 18px;
        font-weight: 600;
        border-bottom: 2px solid #f6af04;
        padding-bottom: 10px;
    }
    .setting-item {
        padding: 15px 0;
        border-bottom: 1px solid #f0f0f0;
    }
    .setting-item:last-child {
        border-bottom: none;
    }
    .setting-label {
        font-weight: 500;
        color: #333;
        margin-bottom: 5px;
    }
    .setting-description {
        font-size: 13px;
        color: #777;
        margin-bottom: 10px;
    }
    .form-switch {
        padding-left: 2.5em;
    }
    .form-switch .form-check-input {
        width: 3em;
        height: 1.5em;
        cursor: pointer;
    }
    .form-switch .form-check-input:checked {
        background-color: #f6af04;
        border-color: #f6af04;
    }
    .btn-save-settings {
        background: #f6af04;
        color: #fff;
        padding: 12px 40px;
        border: none;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }
    .btn-save-settings:hover {
        background: #e09f04;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(246, 175, 4, 0.3);
    }
    .blocked-users-list {
        max-height: 400px;
        overflow-y: auto;
    }
    .blocked-user-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px;
        background: #f9f9f9;
        border-radius: 6px;
        margin-bottom: 10px;
    }
    .blocked-user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .blocked-user-info img {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
    }
    </style>
<%- include('../partials/member-styles') %>
</head>

<body>
    <%- include('../partials/header') %>

    <!-- SETTINGS -->
    <section>
        <div class="db">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 col-lg-3">
                        <%- include('../partials/member-nav', { active: 'settings' }) %>
                    </div>
                    <div class="col-md-8 col-lg-9">
                        <h2 class="db-tit">Privacy & Settings</h2>

                        <!-- Account -->
                        <% const isGoogleLogin = Number(user?.login_type) === 3; const createdBy = String(user?.profileCreatedBy || 'self').toLowerCase(); %>
                        <div class="settings-card" id="accountCard">
                            <h4><i class="fa fa-user"></i> Account</h4>

                            <div class="setting-item">
                                <div class="setting-label">Profile verification
                                    <% if (user?.is_verified) { %><span class="bm-badge bm-badge-ok">Verified</span><% } else { %><span class="bm-badge bm-badge-none">Not verified</span><% } %>
                                </div>
                                <div class="setting-description"><% if (user?.is_verified) { %>Your profile shows a verified badge.<% } else { %>Verify your ID to add a verified badge to your profile.<% } %></div>
                                <a href="/verify-profile" class="bm-btn-sm"><%= user?.is_verified ? 'View status' : 'Verify profile' %></a>
                            </div>

                            <div class="setting-item">
                                <div class="setting-label">Profile created by</div>
                                <div class="setting-description">Who manages this profile. Saved with the button at the bottom of the page.</div>
                                <select class="form-select" id="profileCreatedBy">
                                    <% [['self','Self'],['parent','Parent'],['sibling','Sibling'],['relative','Relative'],['friend','Friend']].forEach(function (o) { %>
                                    <option value="<%= o[0] %>" <%= createdBy === o[0] ? 'selected' : '' %>><%= o[1] %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="setting-item">
                                <div class="setting-label">Change password</div>
                                <% if (isGoogleLogin) { %>
                                <div class="setting-description">You sign in with Google, so your password is managed by Google.</div>
                                <% } else { %>
                                <div class="setting-description">We will email a password reset link to <b><%= user?.email || 'your email address' %></b>.</div>
                                <div class="bm-alert" id="pwMsg" role="status"></div>
                                <button type="button" class="bm-btn-sm" id="pwResetBtn"<% if (!user?.email) { %> disabled<% } %>>Send reset link</button>
                                <% } %>
                            </div>

                            <div class="setting-item">
                                <div class="setting-label">Delete account</div>
                                <div class="setting-description">Permanently deletes your profile, photos, interests and messages. This cannot be undone.</div>
                                <div class="bm-alert" id="delMsg" role="alert"></div>
                                <div id="delConfirm" style="display:none; margin-bottom:8px;">
                                    <label for="delInput" style="font-size:13px;">Type <b>DELETE</b> to confirm</label>
                                    <input type="text" class="form-control" id="delInput" autocomplete="off" style="max-width:220px;">
                                </div>
                                <div class="bm-btn-row">
                                    <button type="button" class="bm-btn-sm bm-btn-danger" id="delStartBtn">Delete my account</button>
                                    <button type="button" class="bm-btn-sm bm-btn-danger" id="delGoBtn" style="display:none;" disabled>Permanently delete</button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Privacy Settings -->
                        <div class="settings-card">
                            <h4><i class="fa fa-lock"></i> Privacy Settings</h4>
                            
                            <div class="setting-item">
                                <div class="setting-label">Show My Location</div>
                                <div class="setting-description">Allow others to see your city and state</div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="showLocation" <%= user?.settings?.showLocation ? 'checked' : '' %>>
                                </div>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Show My Income</div>
                                <div class="setting-description">Display income range on your profile</div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="showIncome" <%= user?.settings?.showIncome ? 'checked' : '' %>>
                                </div>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Profile Picture Visibility</div>
                                <div class="setting-description">Who can see your profile picture</div>
                                <select class="form-select" id="profilePicVisibility">
                                    <option value="everyone" <%= user?.settings?.profilePicVisibility === 'everyone' ? 'selected' : '' %>>Everyone</option>
                                    <option value="onlyAccepted" <%= user?.settings?.profilePicVisibility === 'onlyAccepted' ? 'selected' : '' %>>Only Accepted Connections</option>
                                    <option value="nobody" <%= user?.settings?.profilePicVisibility === 'nobody' ? 'selected' : '' %>>Nobody (Private)</option>
                                </select>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Profile Picture Request Required</div>
                                <div class="setting-description">Users need to request to view your profile picture</div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="profilePicRequestRequired" <%= user?.settings?.profilePicRequestRequired ? 'checked' : '' %>>
                                </div>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Allow Connections From</div>
                                <div class="setting-description">Who can send you interest requests</div>
                                <select class="form-select" id="allowConnections">
                                    <option value="everyone" <%= user?.settings?.allowConnections === 'everyone' ? 'selected' : '' %>>Everyone</option>
                                    <option value="onlyAccepted" <%= user?.settings?.allowConnections === 'onlyAccepted' ? 'selected' : '' %>>Only Accepted Connections</option>
                                    <option value="nobody" <%= user?.settings?.allowConnections === 'nobody' ? 'selected' : '' %>>Nobody</option>
                                </select>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Allow Messages From</div>
                                <div class="setting-description">Who can send you messages</div>
                                <select class="form-select" id="allowMessages">
                                    <option value="everyone" <%= user?.settings?.allowMessages === 'everyone' ? 'selected' : '' %>>Everyone</option>
                                    <option value="onlyAccepted" <%= user?.settings?.allowMessages === 'onlyAccepted' ? 'selected' : '' %>>Only Accepted Connections</option>
                                    <option value="nobody" <%= user?.settings?.allowMessages === 'nobody' ? 'selected' : '' %>>Nobody</option>
                                </select>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Email Visibility</div>
                                <div class="setting-description">Control who can see your email address</div>
                                <select class="form-select" id="emailVisibility">
                                    <option value="private" <%= user?.settings?.emailVisibility === 'private' ? 'selected' : '' %>>Private (Hidden)</option>
                                    <option value="public" <%= user?.settings?.emailVisibility === 'public' ? 'selected' : '' %>>Public (Visible to all)</option>
                                </select>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Mobile Number Visibility</div>
                                <div class="setting-description">Control who can see your mobile number</div>
                                <select class="form-select" id="mobileVisibility">
                                    <option value="private" <%= user?.settings?.mobileVisibility === 'private' ? 'selected' : '' %>>Private (Hidden)</option>
                                    <option value="public" <%= user?.settings?.mobileVisibility === 'public' ? 'selected' : '' %>>Public (Visible to all)</option>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Notification Settings -->
                        <div class="settings-card">
                            <h4><i class="fa fa-bell"></i> Notification Settings</h4>
                            
                            <div class="setting-item">
                                <div class="setting-label">Enable Notifications</div>
                                <div class="setting-description">Master switch for all notifications</div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="allowNotifications" <%= user?.settings?.allowNotifications ? 'checked' : '' %>>
                                </div>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Interest Request Notifications</div>
                                <div class="setting-description">Get notified when someone sends you an interest</div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="notifyOnInterest" <%= user?.settings?.notifyOnInterest ? 'checked' : '' %>>
                                </div>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Message Notifications</div>
                                <div class="setting-description">Get notified for new messages</div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="notifyOnMessage" <%= user?.settings?.notifyOnMessage ? 'checked' : '' %>>
                                </div>
                            </div>
                            
                            <div class="setting-item">
                                <div class="setting-label">Profile Visit Notifications</div>
                                <div class="setting-description">Get notified when someone views your profile</div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="notifyOnProfileVisit" <%= user?.settings?.notifyOnProfileVisit ? 'checked' : '' %>>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Blocked Users -->
                        <div class="settings-card">
                            <h4><i class="fa fa-ban"></i> Blocked Users</h4>
                            <p class="text-muted" style="margin-bottom: 15px;">Manage the profiles you've blocked from a dedicated page.</p>
                            <a href="/blocked-users" class="btn-save-settings" style="display:inline-block; text-decoration:none;">
                                <i class="fa fa-list"></i> View Blocked Users
                            </a>
                        </div>
                        
                        <!-- Save Button -->
                        <div class="text-center mb-4">
                            <button type="button" class="btn-save-settings" id="saveSettingsBtn">
                                <i class="fa fa-save"></i> Save Settings
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- END -->

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

    <!-- END -->
    
    <!-- JavaScript -->
    
    <%- include('../partials/scripts') %>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const API_BASE_URL = '/api'; // same-origin proxy (middleware/apiProxy.js) injects the session Bearer
    const MY_USER_ID = '<%= user?._id %>';


    // Save settings
    $('#saveSettingsBtn').on('click', async function() {
        const btn = $(this);
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

        const settings = {
            showLocation: $('#showLocation').is(':checked'),
            showIncome: $('#showIncome').is(':checked'),
            profilePicVisibility: $('#profilePicVisibility').val(),
            profilePicRequestRequired: $('#profilePicRequestRequired').is(':checked'),
            allowConnections: $('#allowConnections').val(),
            allowMessages: $('#allowMessages').val(),
            emailVisibility: $('#emailVisibility').val(),
            mobileVisibility: $('#mobileVisibility').val(),
            allowNotifications: $('#allowNotifications').is(':checked'),
            notifyOnInterest: $('#notifyOnInterest').is(':checked'),
            notifyOnMessage: $('#notifyOnMessage').is(':checked'),
            notifyOnProfileVisit: $('#notifyOnProfileVisit').is(':checked')
        };

        try {
            const response = await fetch(`${API_BASE_URL}/editProfile`, {
                credentials: 'same-origin',
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    user_id: MY_USER_ID,
                    settings: settings,
                    profileCreatedBy: $('#profileCreatedBy').val()
                })
            });

            const data = await response.json();

            if (data.status) {
                alert('Settings saved successfully!');
                setTimeout(() => location.reload(), 1000);
            } else {
                alert(data.message || 'Failed to save settings');
                btn.prop('disabled', false).html('<i class="fa fa-save"></i> Save Settings');
            }
        } catch (error) {
            console.error('Error saving settings:', error);
            alert('An error occurred. Please try again.');
            btn.prop('disabled', false).html('<i class="fa fa-save"></i> Save Settings');
        }
    });

    // Change password: Firebase sends the reset email (same flow as /forgot-password).
    const pwBtn = document.getElementById('pwResetBtn');
    if (pwBtn) {
        pwBtn.addEventListener('click', async function () {
            const box = document.getElementById('pwMsg');
            pwBtn.disabled = true;
            try {
                if (typeof firebase === 'undefined') throw new Error('Firebase not loaded');
                if (!firebase.apps.length) {
                    firebase.initializeApp({
                        apiKey: "AIzaSyBEQVygTdSOOUczWmUezTt0CyoGm4l5Qe8",
                        authDomain: "socialmedia-dcdd8.firebaseapp.com",
                        projectId: "socialmedia-dcdd8",
                        storageBucket: "socialmedia-dcdd8.firebasestorage.app",
                        messagingSenderId: "799990198329",
                        appId: "1:799990198329:web:ee65ff58d4992177a21de8"
                    });
                }
                await firebase.auth().sendPasswordResetEmail(<%- safeJson(user?.email || '') %>, {
                    url: 'https://www.banjaramatch.com/reset-password',
                    handleCodeInApp: false
                });
                box.textContent = 'Reset link sent. Please check your inbox and spam folder.';
                box.className = 'bm-alert show bm-alert-ok';
            } catch (err) {
                console.error('Password reset failed', err);
                box.textContent = 'The reset email could not be sent. Please try again later.';
                box.className = 'bm-alert show bm-alert-err';
                pwBtn.disabled = false;
            }
        });
    }

    // Delete account: typed confirmation, then POST /api/deleteUser and log out.
    const delStart = document.getElementById('delStartBtn');
    const delGo = document.getElementById('delGoBtn');
    const delInput = document.getElementById('delInput');
    delStart.addEventListener('click', function () {
        document.getElementById('delConfirm').style.display = '';
        delStart.style.display = 'none';
        delGo.style.display = '';
        delInput.focus();
    });
    delInput.addEventListener('input', function () {
        delGo.disabled = delInput.value.trim() !== 'DELETE';
    });
    delGo.addEventListener('click', async function () {
        if (delInput.value.trim() !== 'DELETE') return;
        const box = document.getElementById('delMsg');
        delGo.disabled = true;
        try {
            const res = await fetch(`${API_BASE_URL}/deleteUser`, {
                credentials: 'same-origin',
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: MY_USER_ID })
            });
            let data = {};
            try { data = await res.json(); } catch (e) { data = {}; }
            if (res.ok && data.status) {
                // /logout clears the web session (POST /auth/logout) and the Firebase session.
                window.location.href = '/logout';
                return;
            }
            box.textContent = data.message || 'Your account could not be deleted. Please try again.';
            box.className = 'bm-alert show bm-alert-err';
        } catch (err) {
            box.textContent = 'An error occurred. Please try again.';
            box.className = 'bm-alert show bm-alert-err';
        }
        delGo.disabled = false;
    });

    // Logout confirmation
    $('a[href="/logout"]').on('click', function(e) {
        if (!confirm('Are you sure you want to log out?')) {
            e.preventDefault();
        }
    });
});
    </script>
</body>
</html>
