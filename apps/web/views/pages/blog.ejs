<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<style>
        /* Active category styling */
        .blog-rhs-cate ul li.active a {
            background: #f6af04;
            color: white;
            font-weight: 600;
        }
        .blog-rhs-cate ul li.active a span {
            background: white;
            color: #f6af04;
        }
        /* Category badge hover */
        .blog-cate:hover {
            opacity: 0.8;
            transform: scale(1.05);
            transition: all 0.3s ease;
        }
    </style>
</head>

<body>
<%- include('../partials/header') %>
<%- include('../partials/breadcrumb') %>

<!-- START -->
<section>
    <div class="inn-ban">
        <div class="container">
            <div class="row">
                <h1>Blog & Articles</h1>
                <p>Stories, guides &amp; advice for the Banjara community — from wedding traditions to finding the right match</p>
            </div>
        </div>
    </div>
</section>
<!-- END -->

<!-- START -->
<section>
    <div class="blog-main">
        <div class="container">
            <div class="row">
                <div class="inn">
                    <div class="lhs">
                        <div class="blog-com-tit">
                            <h2>
                                <% if (typeof category !== 'undefined' && category) { %>
                                    <%= category %> Articles
                                <% } else { %>
                                    Latest & Popular
                                <% } %>
                            </h2>
                            <% if (typeof category !== 'undefined' && category) { %>
                                <a href="/blogs" style="display: inline-block; margin-top: 10px; padding: 8px 16px; background: #f6af04; color: white; border-radius: 5px; text-decoration: none; font-size: 14px;">
                                    <i class="fa fa-arrow-left"></i> View All Articles
                                </a>
                            <% } %>
                        </div>
                        
                        <% if (posts && posts.length > 0) { %>
                            <% posts.forEach(blog => { %>
                                <!--BIG POST START-->
                                <div class="blog-home-box">
                                    <div class="im">
                                        <img src="<%= blog.featuredImage || '/images/couples/9.jpg' %>" alt="<%= blog.title %>" loading="lazy">
                                        <span class="blog-date"><%= new Date(blog.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                        <div class="shar-1">
                                            <i class="fa fa-share-alt" aria-hidden="true"></i>
                                            <ul>
                                                <li><a href="#!"><i class="fa fa-facebook" aria-hidden="true"></i></a></li>
                                                <li><a href="#!"><i class="fa fa-twitter" aria-hidden="true"></i></a></li>
                                                <li><a href="#!"><i class="fa fa-whatsapp" aria-hidden="true"></i></a></li>
                                                <li><span><i class="fa fa-link" aria-hidden="true"></i></span></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="txt">
                                        <a href="/blogs/<%= blog.category.toLowerCase() %>" style="text-decoration: none;">
                                            <span class="blog-cate" style="cursor: pointer;"><%= blog.category %></span>
                                        </a>
                                        <% if (blog.tags && blog.tags.length > 0) { %>
                                            <% blog.tags.slice(0, 2).forEach(tag => { %>
                                                <span class="blog-cate"><%= tag %></span>
                                            <% }) %>
                                        <% } %>
                                        <h2><%= blog.title %></h2>
                                        <p><%= blog.description %></p>
                                        <div class="blog-info">
                                            <div class="blog-pro-info">
                                                <img src="<%= blog.author.image || '/images/user/2.jpg' %>" alt="<%= blog.author.name %>" loading="lazy">
                                                <h5><%= blog.author.name %> <span><%= blog.author.role %></span></h5>
                                            </div>
                                        </div>
                                        <a href="/blogs/<%= blog.category.toLowerCase() %>/<%= blog.slug %>" class="fclick"></a>
                                    </div>
                                </div>
                                <!--END BIG POST START-->
                            <% }) %>
                        <% } else { %>
                            <div style="text-align: center; padding: 40px; background: white; border-radius: 8px;">
                                <p>No blog posts available at the moment. Check back soon!</p>
                            </div>
                        <% } %>
                        
                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                            <% 
                                const baseUrl = category ? `/blogs/${category.toLowerCase()}` : '/blogs';
                                const searchParam = (typeof search !== 'undefined' && search) ? `&search=${encodeURIComponent(search)}` : '';
                            %>
                            <div class="page-nation">
                                <ul class="pagination pagination-sm">
                                    <% if (currentPage > 1) { %>
                                        <li class="page-item"><a class="page-link" href="<%= baseUrl %>?page=<%= currentPage - 1 %><%= searchParam %>">Previous</a></li>
                                    <% } %>
                                    
                                    <% for (let i = 1; i <= totalPages; i++) { %>
                                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                            <a class="page-link" href="<%= baseUrl %>?page=<%= i %><%= searchParam %>"><%= i %></a>
                                        </li>
                                    <% } %>
                                    
                                    <% if (currentPage < totalPages) { %>
                                        <li class="page-item"><a class="page-link" href="<%= baseUrl %>?page=<%= currentPage + 1 %><%= searchParam %>">Next</a></li>
                                    <% } %>
                                </ul>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="rhs">
                        <div class="blog-com-rhs">
                            <!-- SOCIAL MEDIA START-->
                            <div class="blog-soci">
                                <h4>Social media</h4>
                                <ul>
                                    <li><a target="_blank" href="#!" class="sm-fb-big"><b>3k</b> Facebook</a></li>
                                    <li><a target="_blank" href="#!" class="sm-tw-big"><b>10K</b> Twitter</a></li>
                                    <li><a target="_blank" href="#!" class="sm-li-big"><b>1k</b> Linkedin</a></li>
                                    <li><a target="_blank" href="#!" class="sm-yt-big"><b>100K</b> Youtube</a></li>
                                </ul>
                            </div>
                            <!-- SOCIAL MEDIA END-->
                            
                            <!-- CATEGORY START-->
                            <div class="blog-rhs-cate">
                                <h4>Category</h4>
                                <ul>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'wedding') ? 'active' : '' %>">
                                        <a href="/blogs/wedding"><span>1</span><b>Wedding Planning</b></a>
                                    </li>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'relationship') ? 'active' : '' %>">
                                        <a href="/blogs/relationship"><span>2</span><b>Relationship</b></a>
                                    </li>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'culture') ? 'active' : '' %>">
                                        <a href="/blogs/culture"><span>3</span><b>Culture</b></a>
                                    </li>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'decoration') ? 'active' : '' %>">
                                        <a href="/blogs/decoration"><span>4</span><b>Wedding Decorations</b></a>
                                    </li>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'events') ? 'active' : '' %>">
                                        <a href="/blogs/events"><span>5</span><b>Events</b></a>
                                    </li>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'tradition') ? 'active' : '' %>">
                                        <a href="/blogs/tradition"><span>6</span><b>Tradition</b></a>
                                    </li>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'tips') ? 'active' : '' %>">
                                        <a href="/blogs/tips"><span>7</span><b>Tips</b></a>
                                    </li>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'stories') ? 'active' : '' %>">
                                        <a href="/blogs/stories"><span>8</span><b>Stories</b></a>
                                    </li>
                                    <li class="<%= (typeof category !== 'undefined' && category && category.toLowerCase() === 'community') ? 'active' : '' %>">
                                        <a href="/blogs/community"><span>9</span><b>Community</b></a>
                                    </li>
                                    <li class="<%= !category || category === '' ? 'active' : '' %>">
                                        <a href="/blogs"><span><i class="fa fa-th"></i></span><b>All Categories</b></a>
                                    </li>
                                </ul>
                            </div>
                            <!-- CATEGORY END-->
                            
                            <!--TOP POSTS-->
                            <div class="hot-page2-hom-pre blog-rhs-trends">
                                <h4>Trending Posts</h4>
                                <ul>
                                    <% if (trending && trending.length > 0) { %>
                                        <% trending.forEach(blog => { %>
                                            <li>
                                                <div class="hot-page2-hom-pre-1">
                                                    <img src="<%= blog.featuredImage || '/images/couples/8.jpg' %>" alt="<%= blog.title %>" loading="lazy">
                                                </div>
                                                <div class="hot-page2-hom-pre-2">
                                                    <h5><%= blog.title %></h5>
                                                </div>
                                                <a href="/blogs/<%= blog.category.toLowerCase() %>/<%= blog.slug %>" class="fclick"></a>
                                            </li>
                                        <% }) %>
                                    <% } else { %>
                                        <li>
                                            <div class="hot-page2-hom-pre-1">
                                                <img src="/images/couples/8.jpg" alt="Banjara wedding couple" loading="lazy">
                                            </div>
                                            <div class="hot-page2-hom-pre-2">
                                                <h5>No trending posts yet</h5>
                                            </div>
                                        </li>
                                    <% } %>
                                </ul>
                            </div>
                            <!--TOP POSTS-->
                            
                            <!-- SUBSCRIBE START-->
                            <div class="blog-subsc">
                                <div class="ud-rhs-poin1">
                                    <img src="https://cdn-icons-png.flaticon.com/512/6349/6349282.png" alt="Love and marriage icon" loading="lazy">
                                    <h5>Subscribe <b>Newsletter</b></h5>
                                </div>
                                <form name="news_newsletter_subscribe_form" id="news_newsletter_subscribe_form">
                                    <ul>
                                        <li><input type="text" name="news_newsletter_subscribe_name" placeholder="Enter Email Id*" class="form-control" required=""></li>
                                        <li><input type="submit" id="news_newsletter_subscribe_submit" name="news_newsletter_subscribe_submit" class="form-control"></li>
                                    </ul>
                                </form>
                            </div>
                            <!-- SUBSCRIBE END-->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END -->

<%- include('../partials/footer') %>


<!-- JavaScript -->
<%- include('../partials/scripts') %>
</body>
</html>

