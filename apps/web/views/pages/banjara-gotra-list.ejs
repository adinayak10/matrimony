  <%- include('../partials/scripts') %>
<script>
    var currentView = 'clan', currentLetter = 'ALL';

    function switchView(v) {
      currentView = v;
      document.getElementById('viewClan').style.display = v === 'clan' ? 'block' : 'none';
      document.getElementById('viewAz').style.display   = v === 'az'   ? 'block' : 'none';
      document.getElementById('btnClan').classList.toggle('active', v === 'clan');
      document.getElementById('btnAz').classList.toggle('active', v === 'az');
      glSearch(document.getElementById('glSearch').value);
    }

    function toggleClan(id) {
      var el = document.getElementById('clan-' + id);
      if (el) el.classList.toggle('open');
    }

    function azFilter(letter) {
      currentLetter = letter;
      document.querySelectorAll('.az-btn').forEach(function(b) {
        b.classList.toggle('active', b.textContent.trim() === letter || (letter === 'ALL' && b.textContent.trim() === 'All'));
      });
      applyAzFilters(document.getElementById('glSearch').value.toLowerCase().trim(), letter);
    }

    function glSearch(q) {
      q = (q || '').toLowerCase().trim();
      if (currentView === 'clan') searchClanView(q);
      else applyAzFilters(q, currentLetter);
    }

    function searchClanView(q) {
      var cards = document.querySelectorAll('.clan-card');
      var visible = 0;
      cards.forEach(function(card) {
        if (!q) { card.style.display = ''; visible++; return; }
        var hit = (card.dataset.clanName || '').includes(q) || (card.dataset.gotraNames || '').includes(q);
        card.style.display = hit ? '' : 'none';
        if (hit) { visible++; if (!card.classList.contains('open')) card.classList.add('open'); }
      });
      document.getElementById('glCount').textContent = visible + ' clan' + (visible!==1?'s':'') + (q?' found':'');
    }

    function applyAzFilters(q, letter) {
      var total = 0;
      document.querySelectorAll('.gl-letter-section').forEach(function(sec) {
        var secLetter = sec.dataset.letter;
        var secVis = 0;
        sec.querySelectorAll('.gl-gotra-card').forEach(function(card) {
          var nameOk = !q || card.dataset.name.includes(q) || card.dataset.clan.includes(q) || (card.dataset.alts||'').includes(q);
          var letOk  = letter === 'ALL' || secLetter === letter;
          card.style.display = (nameOk && letOk) ? '' : 'none';
          if (nameOk && letOk) secVis++;
        });
        sec.style.display = secVis ? '' : 'none';
        total += secVis;
      });
      var nr = document.getElementById('azNoResults');
      if (nr) nr.style.display = total ? 'none' : '';
      document.getElementById('glCount').textContent = total + ' gotra' + (total!==1?'s':'') + (q?' found':'');
    }

    function glfaq(btn) {
      var item = btn.closest('.gl-faq-item');
      var wasOpen = item.classList.contains('open');
      document.querySelectorAll('.gl-faq-item.open').forEach(function(el){ el.classList.remove('open'); });
      if (!wasOpen) item.classList.add('open');
    }
  </script>
