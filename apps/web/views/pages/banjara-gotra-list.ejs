          <button class="gl-faq-btn" onclick="glfaq(this)"><span><%= item[0] %></span><span class="gl-faq-icon">+</span></button>
          <div class="gl-faq-body"><p><%= item[1] %></p></div>
        </div>
        <% }); %>
      </div>
