<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<style>
    .gl-hero{background:linear-gradient(135deg,#0a0500,#2a0e00,#5a2000);padding:70px 0 55px;position:relative;overflow:hidden;}
    .gl-hero::before{content:'';position:absolute;inset:0;background:url('<%= img.cssUrl('/images/ban-bg.jpg') %>') center/cover no-repeat;opacity:.07;}
    .gl-hero .container{position:relative;z-index:2;}
    .gl-hero h1{color:#fff;font-size:34px;font-weight:800;line-height:1.3;margin-bottom:16px;}
    .gl-hero h1 span{color:#f6af04;}
    .gl-hero p{color:rgba(255,255,255,.8);font-size:16px;line-height:1.8;max-width:700px;}
    .gl-stat-row{display:flex;flex-wrap:wrap;gap:16px;margin-top:24px;}
    .gl-stat{text-align:center;background:rgba(255,255,255,.07);border:1px solid rgba(246,175,4,.25);border-radius:12px;padding:14px 20px;min-width:80px;}
    .gl-stat-num{font-size:26px;font-weight:800;color:#f6af04;line-height:1;}
    .gl-stat-label{font-size:10px;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:.8px;margin-top:4px;}

    .gl-controls{background:#fff;border-bottom:1px solid #f0e8d0;padding:14px 0;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.06);}
    .gl-search{width:100%;max-width:340px;padding:9px 14px 9px 36px;border:1.5px solid #e8dcc8;border-radius:30px;font-size:13px;outline:none;}
    .gl-search:focus{border-color:#f6af04;}
    .gl-search-wrap{position:relative;}
    .gl-search-wrap i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#a05000;font-size:13px;}
    .gl-view-btn{padding:7px 16px;border-radius:20px;border:1.5px solid #e8dcc8;background:#fff;font-size:13px;font-weight:600;color:#666;cursor:pointer;transition:.15s;}
    .gl-view-btn.active{background:#f6af04;border-color:#f6af04;color:#1a1a1a;}
    .gl-view-btn:hover:not(.active){border-color:#f6af04;color:#a05000;}

    .az-strip{display:flex;flex-wrap:wrap;gap:4px;margin:16px 0 22px;}
    .az-btn{min-width:30px;height:30px;border-radius:6px;border:1.5px solid #e8dcc8;background:#fff;font-size:12px;font-weight:600;color:#666;cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;}
    .az-btn.active{background:#f6af04;border-color:#f6af04;color:#1a1a1a;}
    .az-btn:hover:not(.active):not(.empty){border-color:#f6af04;color:#a05000;}
    .az-btn.empty{opacity:.28;cursor:default;}

    .gl-letter-section{margin-bottom:26px;}
    .gl-letter-head{font-size:20px;font-weight:800;color:#3b1a00;border-bottom:2px solid #f6af04;display:inline-block;padding-bottom:3px;margin-bottom:12px;}
    .gl-gotra-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:9px;}
    .gl-gotra-card{background:#fff;border:1.5px solid #f0e8d0;border-radius:10px;padding:11px 13px;transition:.15s;}
    .gl-gotra-card:hover{border-color:#f6af04;box-shadow:0 3px 10px rgba(0,0,0,.07);}
    .gl-gotra-name{font-size:13px;font-weight:700;color:#3b1a00;margin-bottom:4px;}
    .gl-clan-badge{display:inline-block;background:#fff7e8;color:#a05000;font-size:10px;font-weight:600;padding:2px 7px;border-radius:10px;border:1px solid #f6af04;}
    .gl-alts{font-size:11px;color:#aaa;margin-top:4px;line-height:1.4;}
    .gl-state-pills{display:flex;flex-wrap:wrap;gap:3px;margin-top:5px;}
    .gl-state-pill{font-size:10px;background:#f0f7ff;color:#336;padding:1px 6px;border-radius:8px;border:1px solid #d0e0f0;}

    .clan-card{background:#fff;border:1.5px solid #f0e8d0;border-radius:18px;margin-bottom:16px;overflow:hidden;}
    .clan-header{padding:18px 22px;cursor:pointer;display:flex;align-items:center;gap:14px;background:#fffbf5;border-bottom:1px solid transparent;user-select:none;}
    .clan-header:hover{background:#fff7e8;}
    .clan-card.open .clan-header{border-bottom-color:#f0e8d0;}
    .clan-icon{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#f6af04,#c87800);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
    .clan-title{font-size:17px;font-weight:800;color:#3b1a00;}
    .clan-subtitle{font-size:12px;color:#888;margin-top:2px;}
    .clan-count-badge{margin-left:auto;background:#f6af04;color:#1a1a1a;font-size:11px;font-weight:700;padding:3px 11px;border-radius:20px;white-space:nowrap;flex-shrink:0;}
    .clan-chevron{color:#a05000;font-size:16px;transition:transform .2s;flex-shrink:0;}
    .clan-card.open .clan-chevron{transform:rotate(180deg);}
    .clan-body{display:none;padding:18px 22px;}
    .clan-card.open .clan-body{display:block;}
    .clan-state-table{width:100%;border-collapse:collapse;margin-bottom:14px;font-size:12px;}
    .clan-state-table th{background:#f6af04;color:#1a1a1a;padding:7px 11px;text-align:left;font-weight:700;}
    .clan-state-table th:first-child{border-radius:6px 0 0 0;}
    .clan-state-table th:last-child{border-radius:0 6px 0 0;}
    .clan-state-table td{padding:7px 11px;border-bottom:1px solid #f0e8d0;}
    .clan-state-table tr:last-child td{border-bottom:none;}
    .clan-state-table tr:nth-child(even) td{background:#fdfaf5;}
    .clan-gotras-label{font-size:11px;font-weight:700;color:#a05000;text-transform:uppercase;letter-spacing:.7px;margin-bottom:7px;}
    .clan-gotra-chips{display:flex;flex-wrap:wrap;gap:5px;}
    .clan-gotra-chip{background:#fff;border:1.5px solid #e8dcc8;border-radius:7px;padding:4px 11px;font-size:12px;font-weight:600;color:#3b1a00;}
    .chip-alt{font-size:10.5px;color:#a05000;font-weight:500;margin-left:2px;}
    .clan-gotra-chip:hover{border-color:#f6af04;background:#fff7e8;}

    .hierarchy-flow{display:flex;align-items:stretch;gap:0;margin-bottom:26px;flex-wrap:wrap;}
    .hierarchy-step{background:#fff;border:1.5px solid #f0e8d0;border-radius:14px;padding:16px 14px;flex:1;min-width:140px;text-align:center;}
    .hierarchy-step-num{width:24px;height:24px;border-radius:50%;background:#f6af04;color:#1a1a1a;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 8px;}
    .hierarchy-step-title{font-size:13px;font-weight:800;color:#3b1a00;margin-bottom:4px;}
    .hierarchy-step-desc{font-size:11.5px;color:#777;line-height:1.5;margin-bottom:6px;}
    .hierarchy-step-eg{font-size:10.5px;color:#a05000;font-weight:700;background:#fff7e8;border-radius:6px;padding:2px 8px;display:inline-block;}
    .hierarchy-arrow{display:flex;align-items:center;justify-content:center;color:#e0c068;font-size:20px;padding:0 6px;flex:0 0 auto;}

    .disputed-note{background:#fff7e8;border:1px solid #f6af04;border-radius:8px;padding:8px 12px;font-size:11.5px;color:#a05000;line-height:1.6;margin-bottom:12px;}
    .clan-quickfacts{font-size:12.5px;color:#666;margin-bottom:14px;line-height:1.7;}
    .clan-quickfacts strong{color:#a05000;}


    .rule-box{background:linear-gradient(135deg,#1a0800,#3b1000);border-radius:16px;padding:24px 22px;color:#fff;margin:28px 0;}
    .rule-box h3{color:#f6af04;font-size:17px;font-weight:700;margin-bottom:14px;}
    .rule-list{list-style:none;padding:0;margin:0;}
    .rule-list li{display:flex;gap:10px;margin-bottom:11px;font-size:13px;color:rgba(255,255,255,.82);line-height:1.65;}
    .rule-list li::before{content:'✦';color:#f6af04;flex-shrink:0;margin-top:1px;}

    .gl-faq-item{border:1px solid #e8dcc8;border-radius:11px;margin-bottom:9px;overflow:hidden;}
    .gl-faq-btn{width:100%;background:#fff;border:none;padding:14px 18px;text-align:left;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:14px;color:#3b1a00;}
    .gl-faq-btn:hover{background:#fffbf0;}
    .gl-faq-icon{font-size:18px;color:#a05000;transition:transform .2s;flex-shrink:0;}
    .gl-faq-item.open .gl-faq-icon{transform:rotate(45deg);}
    .gl-faq-body{display:none;padding:0 18px 14px;font-size:13px;color:#555;line-height:1.8;}
    .gl-faq-item.open .gl-faq-body{display:block;}

    .no-results{text-align:center;padding:50px 20px;color:#888;}
    .eyebrow{font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#a05000;margin-bottom:6px;}

    @media(max-width:767px){
      .gl-hero h1{font-size:21px;}
      .gl-stat-row{gap:8px;}
      .gl-stat{padding:10px 12px;}
      .clan-header{padding:12px 14px;gap:10px;}
      .clan-body{padding:12px 14px;}
      .gl-controls .d-flex{flex-wrap:wrap;gap:8px;}
    }
  </style>
</head>

<body>
  <%- include('../partials/header') %>
<%- include('../partials/breadcrumb') %>

  <section style="background:#fdfaf5;padding:10px 0;border-bottom:1px solid #f0e8d0;">
    <div class="container">
      <div style="display:flex;align-items:center;font-size:13px;color:#666;flex-wrap:wrap;gap:4px;">
        <a href="/" style="color:#a05000;text-decoration:none;">Home</a>
        <span style="margin:0 6px;">›</span>
        <a href="/banjara-community-history" style="color:#a05000;text-decoration:none;">Banjara Community</a>
        <span style="margin:0 6px;">›</span>
        <span style="color:#333;font-weight:600;">Banjara Gotra List</span>
      </div>
    </div>
  </section>

  <section class="gl-hero">
    <div class="container">
      <div class="row">
        <div class="col-lg-9">
          <div style="display:inline-block;background:rgba(246,175,4,.15);border:1px solid rgba(246,175,4,.4);color:#f6af04;padding:4px 14px;border-radius:20px;font-size:11px;font-weight:700;margin-bottom:16px;letter-spacing:.5px;">📚 COMPLETE BANJARA GOTRA REFERENCE</div>
          <h1>Complete Banjara <span>Gotra List</span> — <%= gotras.length %> Gotras &amp; Clans</h1>
          <p>Every documented Banjara gotra organised by major clan (Gor Samuh), with state-wise name variations across Telangana, Andhra Pradesh, Maharashtra, Karnataka, Rajasthan, Gujarat &amp; Madhya Pradesh.</p>
          <div class="gl-stat-row">
            <div class="gl-stat"><div class="gl-stat-num"><%= gotras.length %></div><div class="gl-stat-label">Total Gotras</div></div>
            <div class="gl-stat"><div class="gl-stat-num"><%= clans.length %></div><div class="gl-stat-label">Major Clans</div></div>
            <div class="gl-stat"><div class="gl-stat-num"><%= gotras.filter(g => g.clan).length %></div><div class="gl-stat-label">Clan-Mapped</div></div>
            <div class="gl-stat"><div class="gl-stat-num">7+</div><div class="gl-stat-label">States</div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STICKY CONTROLS -->
  <div class="gl-controls">
    <div class="container">
      <div class="d-flex align-items-center" style="gap:10px;flex-wrap:wrap;">
        <div class="gl-search-wrap">
          <i class="fa fa-search"></i>
          <input type="text" class="gl-search" id="glSearch" placeholder="Search gotra or clan…" oninput="glSearch(this.value)" autocomplete="off">
        </div>
        <div style="display:flex;gap:6px;">
          <button class="gl-view-btn active" id="btnClan" onclick="switchView('clan')">🏛 By Clan</button>
          <button class="gl-view-btn" id="btnAz" onclick="switchView('az')">A–Z</button>
        </div>
        <span style="font-size:13px;color:#888;margin-left:auto;" id="glCount"><%= gotras.length %> gotras</span>
      </div>
    </div>
  </div>

  <div class="container" style="padding-top:30px;padding-bottom:60px;">

    <!-- ── CLAN VIEW ─────────────────────────────────────────────── -->
    <div id="viewClan">

      <div class="rule-box">
        <h3>⚖️ Banjara Gotra Marriage Rules</h3>
        <ul class="rule-list">
          <li>Same-gotra marriage is <strong>strictly forbidden</strong> — people sharing a gotra are considered siblings (bhai-behen) regardless of actual blood distance.</li>
          <li>Same-clan marriage is also generally avoided — gotras within one clan share common ancestry.</li>
          <li>The Tanda Panchayat verifies gotra compatibility before approving marriages.</li>
          <li>On BanjaraMatch, gotra filtering is built in — you only see gotra-compatible profiles.</li>
          <li>Cross-cousin marriage (mama-bhanji) is accepted in some regional Banjara traditions but differs by Tanda.</li>
        </ul>
      </div>

      <div class="eyebrow">Major Banjara Clans (Gor Samuh)</div>
      <h2 style="font-size:22px;font-weight:800;color:#3b1a00;margin-bottom:6px;"><%= clans.length %> Major Banjara Clans — Gotras Grouped by Lineage</h2>
      <p style="color:#666;font-size:14px;line-height:1.7;margin-bottom:20px;max-width:760px;">Banjara lineage is organised in 3 levels. Understand these once and every gotra/clan on this page makes sense:</p>

      <div class="hierarchy-flow">
        <div class="hierarchy-step">
          <div class="hierarchy-step-num">1</div>
          <div class="hierarchy-step-title">Clan (Gor Samuh)</div>
          <div class="hierarchy-step-desc">The oldest, broadest lineage group. Only 4–6 exist in the whole community.</div>
          <span class="hierarchy-step-eg">e.g. Rathod</span>
        </div>
        <div class="hierarchy-arrow">→</div>
        <div class="hierarchy-step">
          <div class="hierarchy-step-num">2</div>
          <div class="hierarchy-step-title">Gotra / Jaath</div>
          <div class="hierarchy-step-desc">A sub-lineage within a clan, descended from one ancestor. This is what <strong>marriage rules</strong> actually check.</div>
          <span class="hierarchy-step-eg">e.g. Ramavath</span>
        </div>
        <div class="hierarchy-arrow">→</div>
        <div class="hierarchy-step">
          <div class="hierarchy-step-num">3</div>
          <div class="hierarchy-step-title">You</div>
          <div class="hierarchy-step-desc">You inherit your gotra from your father. You cannot marry within the same gotra.</div>
          <span class="hierarchy-step-eg">Gotra ≠ Gotra to marry</span>
        </div>
      </div>

      <p style="color:#666;font-size:13px;line-height:1.7;margin-bottom:22px;max-width:760px;">📌 Most sources count <strong>4 major clans</strong> — Rathod, Pawar, Chavan, Jadhav. Banoth and Turi are commonly classified as sub-divisions (gotras) within the Rathod lineage, though this is not universally accepted — some communities and regional records consider them independent clans in their own right. Click any clan below to see its gotras.</p>

      <%
        const gotrasByClanMap = {};
        clans.forEach(c => { gotrasByClanMap[c._id.toString()] = []; });
        const unassigned = [];
        gotras.forEach(g => {
          const cid = g.clan ? g.clan._id.toString() : null;
          if (cid && gotrasByClanMap[cid] !== undefined) {
            gotrasByClanMap[cid].push(g);
          } else {
            unassigned.push(g);
          }
        });
        const clanIcons = ['🦁','⚔️','🌊','🏔️','🌿','🔱','🌄','🌸','🌾','🌀','🏺','🍃','🧂','☁️','👑'];
      %>

      <% clans.forEach((clan, idx) => { %>
      <% const clanGotras = gotrasByClanMap[clan._id.toString()] || []; %>
      <div class="clan-card" id="clan-<%= clan._id %>"
           data-clan-name="<%= clan.name.toLowerCase() %> <%= (clan.displayName||'').toLowerCase() %> <%= (clan.alternateNames||[]).join(' ').toLowerCase() %>"
           data-gotra-names="<%= clanGotras.map(g=>[g.name].concat(g.alternateNames||[]).join('|')).join('|').toLowerCase() %>">
        <div class="clan-header" onclick="toggleClan('<%= clan._id %>')">
          <div class="clan-icon"><%= clanIcons[idx] || '🔆' %></div>
          <div style="flex:1;min-width:0;">
            <div class="clan-title"><%= clan.displayName || clan.name + ' Gor' %></div>
            <div class="clan-subtitle">
              <% if(clan.origin){ %><i class="fa fa-map-marker" style="color:#a05000;font-size:10px;"></i> <%= clan.origin %><% } %>
            </div>
          </div>
          <div class="clan-count-badge"><%= clanGotras.length %> gotra<%= clanGotras.length!==1?'s':'' %></div>
          <i class="fa fa-chevron-down clan-chevron"></i>
        </div>
        <div class="clan-body">

          <div class="clan-quickfacts">
            <% if(clan.origin){ %><strong>Origin:</strong> <%= clan.origin %> &nbsp;·&nbsp; <% } %>
            <strong><%= clanGotras.length %></strong> gotra<%= clanGotras.length!==1?'s':'' %> in this clan
            <% if(clan.alternateNames && clan.alternateNames.length){ %><br><strong>Also known as:</strong> <%= clan.alternateNames.join(', ') %><% } %>
          </div>

          <% if(clan.disputedStatus){ %>
          <div class="disputed-note">⚖️ <strong>Debated:</strong> <%= clan.disputedStatus %></div>
          <% } %>

          <% if(clan.statePresence && clan.statePresence.length){ %>
          <div style="margin-bottom:14px;">
            <div style="font-size:11px;font-weight:700;color:#a05000;text-transform:uppercase;letter-spacing:.7px;margin-bottom:7px;">📍 Where this clan lives today</div>
            <div style="overflow-x:auto;">
              <table class="clan-state-table">
                <thead><tr><th>State</th><th>Local Name</th><th>Stronghold Districts</th></tr></thead>
                <tbody>
                  <% clan.statePresence.forEach(sp => { %>
                  <tr>
                    <td style="font-weight:600;color:#3b1a00;"><%= sp.state %></td>
                    <td><%= sp.localName || clan.name %></td>
                    <td style="color:#888;"><%= (sp.strongholdDistricts||[]).slice(0,3).join(', ')||'—' %></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
          <% } %>

          <% if(clanGotras.length){ %>
          <div class="clan-gotras-label">Gotras in this clan</div>
          <div class="clan-gotra-chips">
            <% clanGotras.forEach(g => { %>
            <div class="clan-gotra-chip">
              <%= g.name %>
              <% if(g.alternateNames&&g.alternateNames.length){ %><span class="chip-alt">· <%= g.alternateNames.join(', ') %></span><% } %>
              <% if(g.statePresence&&g.statePresence.length){ %><span style="color:#f6af04;font-size:9px;margin-left:2px;" title="Has state data">●</span><% } %>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <div style="color:#bbb;font-size:13px;font-style:italic;">No gotras assigned yet — assign via admin panel.</div>
          <% } %>

        </div>
      </div>
      <% }); %>

      <% if(unassigned.length){ %>
      <div class="clan-card" id="clan-unassigned"
           data-clan-name="unassigned other"
           data-gotra-names="<%= unassigned.map(g=>[g.name].concat(g.alternateNames||[]).join('|')).join('|').toLowerCase() %>">
        <div class="clan-header" onclick="toggleClan('unassigned')">
          <div class="clan-icon" style="background:linear-gradient(135deg,#888,#444);">📋</div>
          <div style="flex:1;">
            <div class="clan-title" style="color:#666;">Other Gotras</div>
            <div class="clan-subtitle">Not yet assigned to a major clan</div>
          </div>
          <div class="clan-count-badge" style="background:#888;"><%= unassigned.length %> gotras</div>
          <i class="fa fa-chevron-down clan-chevron"></i>
        </div>
        <div class="clan-body">
          <p style="font-size:13px;color:#888;margin-bottom:12px;">These gotras exist in the BanjaraMatch database but have not yet been classified under a major clan. Clan assignment is done via the admin panel based on ongoing community research.</p>
          <div class="clan-gotra-chips">
            <% unassigned.forEach(g => { %><div class="clan-gotra-chip"><%= g.name %></div><% }); %>
          </div>
        </div>
      </div>
      <% } %>

    </div><!-- /viewClan -->

    <!-- ── A–Z VIEW ──────────────────────────────────────────────── -->
    <div id="viewAz" style="display:none;">
      <%
        const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
        const gotrasByLetter = {};
        letters.forEach(l => { gotrasByLetter[l] = []; });
        gotras.forEach(g => {
          const fl = (g.name[0]||'A').toUpperCase();
          if(!gotrasByLetter[fl]) gotrasByLetter[fl] = [];
          gotrasByLetter[fl].push(g);
        });
      %>
      <div class="az-strip">
        <button class="az-btn active" onclick="azFilter('ALL')">All</button>
        <% letters.forEach(l => { %>
        <button class="az-btn <%= !gotrasByLetter[l]||!gotrasByLetter[l].length ? 'empty' : '' %>"
          onclick="<%= gotrasByLetter[l]&&gotrasByLetter[l].length ? 'azFilter(\''+l+'\')' : 'return false' %>"><%= l %></button>
        <% }); %>
      </div>
      <div id="azGroups">
        <% letters.forEach(l => { %>
        <% if(gotrasByLetter[l] && gotrasByLetter[l].length){ %>
        <div class="gl-letter-section" data-letter="<%= l %>">
          <div class="gl-letter-head"><%= l %> <span style="font-size:13px;font-weight:400;color:#a05000;margin-left:6px;"><%= gotrasByLetter[l].length %></span></div>
          <div class="gl-gotra-grid">
            <% gotrasByLetter[l].forEach(g => { %>
            <div class="gl-gotra-card"
                 data-name="<%= g.name.toLowerCase() %>"
                 data-alts="<%= (g.alternateNames||[]).join(' ').toLowerCase() %>"
                 data-clan="<%= g.clan ? g.clan.name.toLowerCase() : '' %>">
              <div class="gl-gotra-name"><%= g.name %></div>
              <% if(g.clan){ %><span class="gl-clan-badge"><%= g.clan.displayName||g.clan.name %></span><% } %>
              <% if(g.alternateNames&&g.alternateNames.length){ %><div class="gl-alts">Also: <%= g.alternateNames.join(', ') %></div><% } %>
              <% if(g.statePresence&&g.statePresence.length){ %>
              <div class="gl-state-pills">
