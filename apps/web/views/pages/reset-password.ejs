<!doctype html>
<html lang="en">

<head>
    <title>Reset Password - Banjara Matrimony | BanjaraMatch.com</title>

    <!-- META TAGS -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta name="theme-color" content="#f6af04">

    <meta name="description" content="Set a new password for your BanjaraMatch account.">
    <meta name="keywords" content="Banjara Matrimony, BanjaraMatch, Reset Password">

    <meta name="author" content="Banjaramatch.com">
    <link rel="canonical" href="https://www.banjaramatch.com/reset-password">

    <!-- Favicon -->
    <link rel="shortcut icon" href="/images/fav.ico" type="image/x-icon">

    <!-- Google Analytics -->
    <%- include('../partials/analytics', { pageCategory: 'reset-password' }) %>

    <!-- CSS Files -->
    <link rel="stylesheet" href="css/bootstrap.css">
    <link rel="stylesheet" href="css/font-awesome.min.css">
    <link rel="stylesheet" href="css/animate.min.css">
    <link rel="stylesheet" href="css/style.min.css">

    <style>
        .loading-spinner {
            display: none;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #f6af04;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }

        .loading-spinner.active {
            display: block;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .back-btn {
            color: #666;
            cursor: pointer;
            margin-top: 15px;
            display: inline-block;
            text-decoration: none;
        }

        .back-btn:hover {
            color: #f6af04;
        }

        .error-message {
            color: #dc3545;
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .success-message {
            color: #155724;
            background: #d4edda;
            border: 1px solid #c3e6cb;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .password-strength {
            height: 5px;
            border-radius: 3px;
            margin-top: 5px;
            transition: all 0.3s;
        }

        .password-strength.weak { background: #dc3545; width: 33%; }
        .password-strength.medium { background: #ffc107; width: 66%; }
        .password-strength.strong { background: #28a745; width: 100%; }
    </style>

    <!--[if lt IE 9]>
      <script src="js/html5shiv.min.js"></script>
      <script src="js/respond.min.js"></script>
    <![endif]-->
</head>

<body>
    <%- include('../partials/header') %>

    <!-- RESET PASSWORD SECTION -->
    <section class="login">
        <div class="container">
            <div class="row">
                <div class="inn">
                    <!-- LEFT SIDE INFO -->
                    <div class="lhs">
                        <div class="tit">
                            <h2>Create Your <b>New Password</b><br> Secure Your Account</h2>
                        </div>
                        <div class="im">
                            <img src="images/login-couple.png" alt="Banjara couple image">
                        </div>
                        <div class="log-bg">&nbsp;</div>
                    </div>

                    <!-- RIGHT SIDE FORM -->
                    <div class="rhs">
                        <div>
                            <div class="form-tit">
                                <h4>Set New Password</h4>
                                <h1>Reset Your Password</h1>
                                <p id="emailDisplay"></p>
                            </div>

                            <!-- Error Message -->
                            <div id="errorContainer" style="display: none;" class="error-message">
                                <i class="fa fa-exclamation-circle"></i>
                                <span id="errorMessage"></span>
                            </div>

                            <!-- Success Message -->
                            <div id="successContainer" style="display: none;" class="success-message">
                                <i class="fa fa-check-circle"></i>
                                <span id="successMessage"></span>
                            </div>

                            <div class="form-login" id="resetForm">
                                <form id="newPasswordForm">
                                    <div class="form-group">
                                        <label class="lb">New Password:</label>
                                        <input type="password" class="form-control" id="newPassword" 
                                               placeholder="Enter new password (min 6 characters)" required minlength="6">
                                        <div class="password-strength" id="strengthBar"></div>
                                        <small id="strengthText" style="color: #666;"></small>
                                    </div>
                                    <div class="form-group">
                                        <label class="lb">Confirm Password:</label>
                                        <input type="password" class="form-control" id="confirmPassword" 
                                               placeholder="Re-enter your password" required minlength="6">
                                    </div>
                                    <div class="loading-spinner" id="reset-spinner"></div>
                                    <button type="submit" class="btn btn-primary" id="resetBtn">Reset Password</button>
                                    <div style="text-align: center; margin-top: 15px;">
                                        <a href="/login" class="back-btn">
                                            <i class="fa fa-arrow-left"></i> Back to Login
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <!-- END RIGHT -->
                </div>
            </div>
        </div>
    </section>
    <!-- END -->

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

    <!-- END -->
    <!-- END -->

    <!-- Optional JavaScript -->
    <script src="js/jquery.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/select-opt.min.js"></script>
    <script src="js/custom.min.js"></script>

    <script>
        const API_URL = 'https://api.banjaramatch.com';
        
        // Get oobCode from URL
        const urlParams = new URLSearchParams(window.location.search);
        const oobCode = urlParams.get('oobCode');
        const mode = urlParams.get('mode');

        console.log('🔐 Reset Password Page Loaded');
        console.log('Mode:', mode);
        console.log('OOB Code:', oobCode ? 'Present' : 'Missing');

        function showError(message) {
            document.getElementById('errorMessage').textContent = message;
            document.getElementById('errorContainer').style.display = 'block';
            document.getElementById('successContainer').style.display = 'none';
        }

        function showSuccess(message) {
            document.getElementById('successMessage').textContent = message;
            document.getElementById('successContainer').style.display = 'block';
            document.getElementById('errorContainer').style.display = 'none';
        }

        function checkPasswordStrength(password) {
            const strengthBar = document.getElementById('strengthBar');
            const strengthText = document.getElementById('strengthText');
            
            let strength = 0;
            if (password.length >= 6) strength++;
            if (password.length >= 10) strength++;
            if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
            if (/\d/.test(password)) strength++;
            if (/[^a-zA-Z\d]/.test(password)) strength++;

            strengthBar.className = 'password-strength';
            if (strength <= 2) {
                strengthBar.classList.add('weak');
                strengthText.textContent = 'Weak password';
            } else if (strength <= 3) {
                strengthBar.classList.add('medium');
                strengthText.textContent = 'Medium password';
            } else {
                strengthBar.classList.add('strong');
                strengthText.textContent = 'Strong password';
            }
        }

        // Password strength checker
        document.getElementById('newPassword').addEventListener('input', (e) => {
            checkPasswordStrength(e.target.value);
        });

        // Verify reset code on page load
        async function verifyResetCode() {
            if (!oobCode || mode !== 'resetPassword') {
                showError('Invalid or missing reset link. Please request a new password reset.');
                document.getElementById('resetForm').style.display = 'none';
                return;
            }

            try {
                console.log('📧 Verifying reset code...');
                console.log('API URL:', API_URL);
                console.log('OOB Code:', oobCode);
                
                const response = await fetch(`${API_URL}/api/auth/verify-password-reset-code`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ oobCode })
                });

                console.log('Response status:', response.status);
                const data = await response.json();
                console.log('Response data:', data);

                if (response.ok && data.status) {
                    console.log('✅ Reset code verified');
                    if (data.email) {
                        document.getElementById('emailDisplay').textContent = 
                            'Resetting password for: ' + data.email;
                    } else {
                        document.getElementById('emailDisplay').textContent = 
                            'Enter your new password below';
                    }
                } else {
                    console.error('❌ Verification failed:', data);
                    showError(data.message || 'Invalid reset link');
                    document.getElementById('resetForm').style.display = 'none';
                }
            } catch (error) {
                console.error('❌ Verification error:', error);
                console.error('Error details:', error.message);
                showError('Network error. Please check your connection and try again.');
                document.getElementById('resetForm').style.display = 'none';
            }
        }

        // Reset password form handler
        document.getElementById('newPasswordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            // Validate passwords match
            if (newPassword !== confirmPassword) {
                showError('Passwords do not match');
                return;
            }

            // Validate password length
            if (newPassword.length < 6) {
                showError('Password must be at least 6 characters');
                return;
            }

            document.getElementById('reset-spinner').classList.add('active');
            document.getElementById('resetBtn').disabled = true;

            try {
                console.log('🔐 Resetting password...');
                console.log('OOB Code:', oobCode);
                
                const response = await fetch(`${API_URL}/api/auth/confirm-password-reset`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ 
                        oobCode,
                        newPassword 
                    })
                });

                console.log('Response status:', response.status);
                const data = await response.json();
                console.log('Response data:', data);

                if (response.ok && data.status) {
                    console.log('✅ Password reset successful');
                    showSuccess(data.message);
                    document.getElementById('resetForm').style.display = 'none';
                    
                    // Track event
                    if (typeof gtag !== 'undefined') {
                        gtag('event', 'password_reset_complete', {
                            'event_category': 'authentication'
                        });
                    }
                    
                    // Redirect to login after 3 seconds
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 3000);
                } else {
                    console.error('❌ Reset failed:', data);
                    showError(data.message || 'Failed to reset password');
                    document.getElementById('reset-spinner').classList.remove('active');
                    document.getElementById('resetBtn').disabled = false;
                }
            } catch (error) {
                console.error('❌ Reset error:', error);
                console.error('Error details:', error.message);
                showError('Network error. Please check your connection and try again.');
                document.getElementById('reset-spinner').classList.remove('active');
                document.getElementById('resetBtn').disabled = false;
            }
        });

        // Verify code on page load
        verifyResetCode();
    </script>
</body>

</html>
