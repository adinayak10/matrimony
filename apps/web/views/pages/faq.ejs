<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<style>
    .fq-hero { background: linear-gradient(135deg, #2a1500, #5a2a00, #8b4500); padding: 70px 0 55px; position: relative; overflow: hidden; }
    .fq-hero::before { content:''; position:absolute; inset:0; background:url('/images/ban-bg.jpg') center/cover no-repeat; opacity:.08; }
    .fq-hero .container { position:relative; z-index:2; }
    .fq-hero h1 { color:#fff; font-size:34px; font-weight:800; line-height:1.3; margin-bottom:14px; }
    .fq-hero h1 span { color:#f6af04; }
    .fq-hero p { color:rgba(255,255,255,.85); font-size:16px; line-height:1.75; max-width:680px; }

    .fq-section { padding:60px 0; }
    .fq-cat-title { font-size:22px; font-weight:800; color:#3a1d00; margin:40px 0 18px; }
    .fq-cat-title:first-child { margin-top:0; }
    .fq-wrap { max-width:820px; margin:0 auto; }
    .fq-item { border:1px solid #f0e0c8; border-radius:12px; margin-bottom:12px; overflow:hidden; }
    .fq-btn { width:100%; background:#fff; border:none; padding:18px 20px; text-align:left; cursor:pointer; display:flex; justify-content:space-between; align-items:center; font-weight:600; font-size:15px; color:#3a1d00; }
    .fq-btn:hover { background:#fdf8f0; }
    .fq-icon { font-size:20px; color:#f6af04; transition:transform .2s; flex-shrink:0; margin-left:12px; }
    .fq-item.open .fq-icon { transform:rotate(45deg); }
    .fq-body { display:none; padding:0 20px 18px; font-size:14.5px; color:#555; line-height:1.75; }
    .fq-item.open .fq-body { display:block; }

    .fq-cta-banner { background:linear-gradient(135deg,#8b4500,#5a2a00); padding:55px 0; text-align:center; }
    .fq-cta-banner h2 { color:#fff; font-size:28px; font-weight:800; margin-bottom:12px; }
    .fq-cta-banner p { color:rgba(255,255,255,.85); font-size:16px; margin-bottom:26px; }
    .fq-cta-yellow { background:#f6af04; color:#000; padding:14px 32px; border-radius:8px; font-weight:700; font-size:15px; text-decoration:none; display:inline-block; }
    .fq-cta-yellow:hover { background:#e09e00; color:#000; text-decoration:none; }

    @media(max-width:767px){ .fq-hero h1{font-size:24px;} .fq-cat-title{font-size:19px;} }
  </style>
</head>

<body>
  <%- include('../partials/header') %>
<%- include('../partials/breadcrumb') %>

  <section class="fq-hero">
    <div class="container">
      <h1>Frequently Asked <span>Questions</span></h1>
      <p>Everything you need to know about gotra matching, verification, safety, and how BanjaraMatch works — in one place.</p>
    </div>
  </section>

  <section class="fq-section">
    <div class="container">
      <div class="fq-wrap">

        <h2 class="fq-cat-title">Getting Started</h2>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">Is BanjaraMatch really free?<span class="fq-icon">+</span></button>
          <div class="fq-body">Yes. Registration, browsing profiles, sending interests, chatting, and video calls are all completely free, with no hidden charges or premium paywall — unlike most matrimony platforms that charge for contact details or messaging.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">Who can register on BanjaraMatch?<span class="fq-icon">+</span></button>
          <div class="fq-body">BanjaraMatch is built for the Banjara community and its regional identities — Lambadi, Lambani, Gormati, Gor Banjara, Sugali, and Vanjara — across India and abroad. Registration is open to adults 18 and above seeking a marriage partner.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">Can I use BanjaraMatch on mobile?<span class="fq-icon">+</span></button>
          <div class="fq-body">Yes. BanjaraMatch has a free <a href="/banjara-matrimony-app">mobile app</a> for Android and iOS with the same AI matching, chat, and video call features as the website.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">How do I create a biodata for BanjaraMatch?<span class="fq-icon">+</span></button>
          <div class="fq-body">You can use our free <a href="/biodata-builder">Biodata Builder</a> to create a professional marriage biodata with multiple templates and download it as a PDF, in addition to your BanjaraMatch profile.</div>
        </div>

        <h2 class="fq-cat-title">Gotra &amp; Community Matching</h2>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">What is a Banjara gotra, and why does it matter?<span class="fq-icon">+</span></button>
          <div class="fq-body">A gotra is a patrilineal clan identifier, inherited from your father. In Banjara tradition, marriage within your own gotra is considered forbidden (gotra exogamy), so confirming gotra compatibility is one of the first steps in any match. See our full <a href="/banjara-gotra-list">Banjara Gotra List</a> for details.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">Can two people from the same gotra marry?<span class="fq-icon">+</span></button>
          <div class="fq-body">No. Same-gotra marriage is not permitted under traditional Banjara custom, since people sharing a gotra are considered to share ancestry. This rule is enforced strongly across most Banjara sub-communities and tanda panchayats.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">Can I search for matches by gotra and sub-community?<span class="fq-icon">+</span></button>
          <div class="fq-body">Yes. Every profile on BanjaraMatch includes gotra and sub-community details (Lambadi, Gormati, Lambani, Gor Banjara, Sugali), and you can filter your search by these fields alongside location, age, education, and profession.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">What's the difference between Banjara, Lambadi, Lambani, Gormati, and Sugali?<span class="fq-icon">+</span></button>
          <div class="fq-body">These are regional names for the same broader nomadic community. Lambadi/Lambada/Sugali is common in Telangana and Andhra Pradesh, Lambani in Karnataka, Gormati mainly in Maharashtra, Vanjara in Gujarat, and Banjara is used widely across Rajasthan and North India. BanjaraMatch serves all of these together.</div>
        </div>

        <h2 class="fq-cat-title">Verification, Safety &amp; Privacy</h2>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">How are profiles verified on BanjaraMatch?<span class="fq-icon">+</span></button>
          <div class="fq-body">Every profile goes through a manual verification process before it becomes visible to other members, helping ensure authenticity and reduce fake or duplicate profiles. Report tools are also available if you encounter suspicious behavior.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">Is my data and privacy safe on BanjaraMatch?<span class="fq-icon">+</span></button>
          <div class="fq-body">Yes. Data is encrypted, you control who can view your contact details, and profiles are not indexed or exposed publicly outside the platform. See our <a href="/privacy-policy">Privacy Policy</a> and <a href="/child-safety-policy">Child Safety Policy</a> for full details.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">How do I report a fake or suspicious profile?<span class="fq-icon">+</span></button>
          <div class="fq-body">You can report any profile directly from its page. Our team manually reviews reports and takes action, including removal, for profiles that violate our safety or authenticity standards.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">Can I delete my account and data?<span class="fq-icon">+</span></button>
          <div class="fq-body">Yes. You can request full account and data deletion at any time. See our <a href="/account-deletion">Account &amp; Data Deletion</a> page for the process.</div>
        </div>

        <h2 class="fq-cat-title">Matching &amp; Coverage</h2>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">How does AI matching work on BanjaraMatch?<span class="fq-icon">+</span></button>
          <div class="fq-body">BanjaraMatch uses AI-assisted compatibility scoring that factors in gotra and sub-community compatibility, location, age preferences, education, profession, and stated preferences, to surface more relevant matches instead of an unfiltered list of every profile. Read more on our <a href="/features">Features</a> page.</div>
        </div>
        <div class="fq-item">
          <button class="fq-btn" onclick="fqToggle(this)">Does BanjaraMatch cover my state or city?<span class="fq-icon">+</span></button>
          <div class="fq-body">BanjaraMatch covers Banjara communities across Telangana, Andhra Pradesh, Maharashtra, Karnataka, Rajasthan, Gujarat, Madhya Pradesh, Delhi NCR, and other states with a Banjara population. Check our <a href="/sitemap">Site Map</a> for the full list of regional pages.</div>
        </div>

      </div>
    </div>
  </section>

  <section class="fq-cta-banner">
    <div class="container">
      <h2>Still have a question?</h2>
      <p>Our support team is happy to help — or just dive in and start browsing verified profiles today.</p>
      <a href="/contact" class="fq-cta-yellow">Contact Support →</a>
    </div>
  </section>

  <% if (featuredBlogs && featuredBlogs.length > 0) { %>
  <section class="fq-section">
    <div class="container">
      <h2 class="fq-cat-title" style="text-align:center;">Related Articles</h2>
      <div class="row">
        <% featuredBlogs.forEach(blog => { %>
        <div class="col-md-4 mb-4">
          <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.08);height:100%;border:1px solid #f0e0c8;">
            <% if (blog.featuredImage) { %><img src="/<%= blog.featuredImage %>" alt="<%= blog.title %>" style="width:100%;height:180px;object-fit:cover;" loading="lazy"><% } %>
            <div style="padding:20px;">
              <span style="background:#fdf0d8;color:#a05000;padding:3px 10px;border-radius:12px;font-size:12px;font-weight:600;"><%= blog.category %></span>
              <h4 style="font-size:16px;font-weight:700;margin:12px 0 8px;color:#3a1d00;line-height:1.4;"><%= blog.title %></h4>
              <a href="/blogs/<%= blog.category.toLowerCase() %>/<%= blog.slug %>" style="color:#a05000;font-weight:600;font-size:13px;text-decoration:none;">Read More &rarr;</a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
<script>
    function fqToggle(btn) {
      const item = btn.closest('.fq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.fq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }
  </script>
</body>
</html>
