<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<style>
        .loading-spinner {
            display: none;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #f6af04;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }

        .loading-spinner.active {
            display: block;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .back-btn {
            color: #666;
            cursor: pointer;
            margin-top: 15px;
            display: inline-block;
            text-decoration: none;
        }

        .back-btn:hover {
            color: #f6af04;
        }
    </style>
</head>

<body>
    <%- include('../partials/header') %>

    <!-- FORGOT PASSWORD SECTION -->
    <section class="login">
        <div class="container">
            <div class="row">
                <div class="inn">
                    <!-- LEFT SIDE INFO -->
                    <div class="lhs">
                        <div class="tit">
                            <h2>Reset Your <b>Password</b><br> Simple & Secure</h2>
                        </div>
                        <div class="im">
                            <img src="/images/login-couple.png" alt="Banjara couple image">
                        </div>
                        <div class="log-bg">&nbsp;</div>
                    </div>

                    <!-- RIGHT SIDE FORM -->
                    <div class="rhs">
                        <div>
                            <div class="form-tit">
                                <h4>Forgot Your Password?</h4>
                                <h1>Reset Password</h1>
                                <p>Enter your email to receive reset instructions</p>
                            </div>

                            <div class="form-login">
                                <form id="forgotPasswordForm">
                                    <div class="form-group">
                                        <label class="lb">Email Address:</label>
                                        <input type="email" class="form-control" id="email" placeholder="Enter your registered email" required>
                                    </div>
                                    <div class="loading-spinner" id="forgot-spinner"></div>
                                    <button type="submit" class="btn btn-primary" id="forgotBtn">Send Reset Link</button>
                                    <div style="text-align: center; margin-top: 15px;">
                                        <a href="/login" class="back-btn">
                                            <i class="fa fa-arrow-left"></i> Back to Login
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <!-- END RIGHT -->
                </div>
            </div>
        </div>
    </section>
    <!-- END -->

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

    <!-- END -->
    <!-- END -->

    <!-- Optional JavaScript -->

    <%- include('../partials/scripts') %>
<script>
// Deferred bundle (partials/scripts.ejs): page code runs once the DOM and the deferred scripts are ready.
document.addEventListener('DOMContentLoaded', function () {
        // Firebase Configuration
        const firebaseConfig = {
            apiKey: "AIzaSyBEQVygTdSOOUczWmUezTt0CyoGm4l5Qe8",
            authDomain: "socialmedia-dcdd8.firebaseapp.com",
            databaseURL: "https://socialmedia-dcdd8-default-rtdb.firebaseio.com",
            projectId: "socialmedia-dcdd8",
            storageBucket: "socialmedia-dcdd8.firebasestorage.app",
            messagingSenderId: "799990198329",
            appId: "1:799990198329:web:ee65ff58d4992177a21de8",
            measurementId: "G-3RE8KG7MXG"
        };

        // Initialize Firebase only if not already initialized
        try {
            if (!firebase.apps.length) {
                firebase.initializeApp(firebaseConfig);
                console.log('✅ Firebase initialized successfully');
            } else {
                console.log('ℹ️ Firebase already initialized');
            }
        } catch (error) {
            console.error('❌ Firebase initialization error:', error);
        }

        // Forgot Password Form Handler
        document.getElementById('forgotPasswordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            console.log('=== FORGOT PASSWORD: START ===');
            const email = document.getElementById('email').value.trim();
            
            if (!email) {
                alert('Please enter your email address');
                return;
            }

            document.getElementById('forgot-spinner').classList.add('active');
            document.getElementById('forgotBtn').disabled = true;

            try {
                console.log('📧 Sending password reset email to:', email);
                
                const auth = firebase.auth();
                
                // Configure action code settings to use custom domain
                const actionCodeSettings = {
                    url: 'https://www.banjaramatch.com/reset-password',
                    handleCodeInApp: false
                };
                
                await auth.sendPasswordResetEmail(email, actionCodeSettings);
                
                console.log('✅ Password reset email sent');
                
                alert('Password reset link sent to your email. Please check your inbox and spam folder.');
                
                // Track event
                if (typeof gtag !== 'undefined') {
                    gtag('event', 'password_reset_request', {
                        'event_category': 'authentication'
                    });
                }
                
                // Redirect to login after 2 seconds
                setTimeout(() => {
                    window.location.href = '/login';
                }, 2000);
                
            } catch (error) {
                console.error('=== FORGOT PASSWORD: FAILED ===');
                console.error('❌ Error:', error);
                console.error('❌ Error code:', error.code);
                console.error('❌ Error message:', error.message);
                
                document.getElementById('forgot-spinner').classList.remove('active');
                document.getElementById('forgotBtn').disabled = false;
                
                let errorMsg = 'Failed to send reset email. ';
                if (error.code === 'auth/user-not-found') {
                    errorMsg = 'No account found with this email.';
                } else if (error.code === 'auth/invalid-email') {
                    errorMsg = 'Invalid email format.';
                } else if (error.code === 'auth/too-many-requests') {
                    errorMsg = 'Too many requests. Please try again later.';
                } else {
                    errorMsg += error.message || 'Please try again.';
                }
                
                alert(errorMsg);
            }
        });
    });
</script>
</body>

</html>
