            <h3 style="color: #f6af04; font-size: 18px; margin-bottom: 20px; border-bottom: 2px solid #f6af04; padding-bottom: 10px;">
              <i class="fa fa-home"></i> Main Pages
            </h3>
            <nav aria-label="Main Pages">
              <ul style="list-style: none; padding: 0; margin: 0;">
                <li style="margin-bottom: 10px;"><a href="/" style="color: #667eea; text-decoration: none; transition: color 0.3s;"><i class="fa fa-angle-right"></i> Home</a></li>
                <li style="margin-bottom: 10px;"><a href="/features" style="color: #667eea; text-decoration: none;"><i class="fa fa-angle-right"></i> Platform Features</a></li>
