// Form submission
$('#profileForm').on('submit', async function(e) {
    e.preventDefault();
    
    const submitBtn = $('#submitBtn');
    const originalText = submitBtn.html();
    submitBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Updating...');
    
    try {
        const formData = new FormData(this);

        // Horoscope fields (Guna Milan) — sent as a JSON string, same
        // pattern as `settings`, since multer doesn't parse bracket keys.
        const horoscope = {
            rashi: document.getElementById('horoscopeRashi')?.value || '',
            nakshatra: document.getElementById('horoscopeNakshatra')?.value || '',
            birthTime: document.getElementById('horoscopeBirthTime')?.value || '',
            birthPlace: document.getElementById('horoscopeBirthPlace')?.value || '',
        };
        if (horoscope.rashi || horoscope.nakshatra || horoscope.birthTime || horoscope.birthPlace) {
            formData.append('horoscope', JSON.stringify(horoscope));
        }

        // Transform nested field names for API compatibility
        // Location fields: location_country -> location[country]
        if (formData.has('location_country')) {
            formData.append('location[country]', formData.get('location_country'));
            formData.delete('location_country');
        }
        if (formData.has('location_state')) {
            formData.append('location[state]', formData.get('location_state'));
            formData.delete('location_state');
        }
        if (formData.has('location_city')) {
            formData.append('location[city]', formData.get('location_city'));
            formData.delete('location_city');
        }
        
        // Family fields
        const familyFields = [
            'family_father_profession', 'family_mother_profession',
            'family_brothers_total', 'family_sisters_total',
            'family_familyType', 'family_familyStatus', 'family_familyValues'
        ];
        
        familyFields.forEach(field => {
            if (formData.has(field)) {
                const value = formData.get(field);
                const fieldName = field.replace('family_', '');
                
                // Handle nested family fields
                if (fieldName === 'father_profession') {
                    formData.append('family[father][profession]', value);
                } else if (fieldName === 'mother_profession') {
                    formData.append('family[mother][profession]', value);
                } else if (fieldName === 'brothers_total') {
                    formData.append('family[brothers][total]', value);
                } else if (fieldName === 'sisters_total') {
                    formData.append('family[sisters][total]', value);
                } else {
                    formData.append(`family[${fieldName}]`, value);
                }
                
                formData.delete(field);
            }
        });
        
        const response = await fetch(`${API_BASE_URL}/editProfile`, {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
            },
            body: formData
        });
        
        const data = await response.json();
        
        if (data.status) {
            $('#updateMessage')
                .removeClass('alert-danger')
                .addClass('alert alert-success')
                .text('Profile updated successfully!')
                .show();
            
            setTimeout(() => {
                window.location.href = '/dashboard';
            }, 2000);
        } else {
            $('#updateMessage')
                .removeClass('alert-success')
                .addClass('alert alert-danger')
                .text(data.message || 'Failed to update profile')
                .show();
            submitBtn.prop('disabled', false).html(originalText);
        }
    } catch (error) {
        console.error('Error updating profile:', error);
        $('#updateMessage')
            .removeClass('alert-success')
            .addClass('alert alert-danger')
            .text('An error occurred. Please try again.')
            .show();
        submitBtn.prop('disabled', false).html(originalText);
    }
    
    // Scroll to message
    $('html, body').animate({
        scrollTop: $('#updateMessage').offset().top - 100
    }, 500);
});

// Load all dropdowns on page load
$(document).ready(async function() {
