  <script>
    function lfaq(btn) {
      const item = btn.closest('.lm-faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.lm-faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }
