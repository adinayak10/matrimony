<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<style>
    .settings-card {
        background: #fff;
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .notif-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }
    .notif-item {
        display: flex;
        gap: 14px;
        padding: 14px 10px;
        border-bottom: 1px solid #f0f0f0;
        align-items: flex-start;
    }
    .notif-item:last-child { border-bottom: none; }
    .notif-item.unread { background: #fff8e1; border-radius: 6px; }
    .notif-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        background: #f6af04;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 16px;
    }
    .notif-icon img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
    .notif-content { flex: 1; }
    .notif-time { font-size: 12px; color: #999; margin-top: 3px; }
    .notif-pagination { text-align: center; margin-top: 20px; }
    .notif-pagination button { margin: 0 4px; }
    .notif-tabs { display:flex; gap:6px; margin-bottom:14px; border-bottom:1px solid #eee; }
    .notif-tabs button { background:none; border:none; border-bottom:3px solid transparent; padding:8px 14px; font-weight:600; color:#666; cursor:pointer; }
    .notif-tabs button[aria-selected="true"] { color:#222; border-bottom-color:#f6af04; }
    .ann-item { padding:14px 10px; border-bottom:1px solid #f0f0f0; }
    .ann-item:last-child { border-bottom:none; }
    .ann-item h5 { font-size:15px; font-weight:700; margin:0 0 4px; }
    .ann-type { display:inline-block; font-size:11px; text-transform:capitalize; background:#eef2f7; color:#456; border-radius:9px; padding:1px 8px; margin-left:6px; vertical-align:middle; }
    .ann-body { color:#444; font-size:14px; white-space:pre-line; }
    </style>
</head>

<body>
    <%- include('../partials/header') %>

    <section>
        <div class="db">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 col-lg-3">
                        <%- include('../partials/member-nav', { active: 'notifications' }) %>
                    </div>
                    <div class="col-md-8 col-lg-9">
                        <div class="notif-header">
                            <h2 class="db-tit" style="margin:0;"><i class="fa fa-bell"></i> Notifications</h2>
                            <button class="btn btn-sm btn-outline-secondary" id="markAllReadBtn">Mark all as read</button>
                        </div>

                        <div class="notif-tabs" role="tablist">
                            <button type="button" role="tab" id="tabActivity" aria-controls="panelActivity" aria-selected="true">Activity</button>
                            <button type="button" role="tab" id="tabAnnouncements" aria-controls="panelAnnouncements" aria-selected="false">Announcements</button>
                        </div>

                        <div class="settings-card" id="panelActivity" role="tabpanel" aria-labelledby="tabActivity">
                            <div id="notifList">
                                <p class="text-center text-muted">Loading notifications...</p>
                            </div>
                            <div class="notif-pagination" id="notifPagination"></div>
                        </div>

                        <div class="settings-card" id="panelAnnouncements" role="tabpanel" aria-labelledby="tabAnnouncements" hidden>
                            <div id="annList">
                                <p class="text-center text-muted">Loading announcements...</p>
                            </div>
                            <div class="notif-pagination"><button type="button" class="btn btn-sm btn-outline-secondary" id="annMore" style="display:none;">Load more</button></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>


    <%- include('../partials/scripts') %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const API_BASE_URL = '/api'; // same-origin proxy (middleware/apiProxy.js) injects the session Bearer
        const MY_USER_ID = '<%= user?._id %>';
        let currentPage = 1;


        const TYPE_ICONS = {
            chat_accepted: 'fa-comments',
            chat_declined: 'fa-comment-slash',
            interest_request: 'fa-heart',
            friend_accept: 'fa-user-plus',
            interest_accept: 'fa-heart',
            interest_detected: 'fa-eye',
            profile_search_alert: 'fa-search',
            profile_updated: 'fa-user',
            add_to_gallery: 'fa-image'
        };

        function timeAgo(dateStr) {
            const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
            if (diff < 60) return 'just now';
            if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
            if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
            if (diff < 2592000) return Math.floor(diff / 86400) + 'd ago';
            return new Date(dateStr).toLocaleDateString();
        }

        async function loadNotifications(page) {
            currentPage = page;
            const list = document.getElementById('notifList');
            list.innerHTML = '<p class="text-center text-muted">Loading notifications...</p>';
            try {
                const res = await fetch(`${API_BASE_URL}/fetchUserNotification`, {
                    credentials: 'same-origin',
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ my_user_id: MY_USER_ID, page, limit: 20 })
                });
                const data = await res.json();

                if (data.status && data.data && data.data.length > 0) {
                    list.innerHTML = data.data.map(n => {
                        const icon = TYPE_ICONS[n.type] || 'fa-bell';
                        const avatarImg = n.fromUser?.profile
                            ? `<img src="${esc(n.fromUser.profile.startsWith('http') ? n.fromUser.profile : 'https://api.banjaramatch.com/' + n.fromUser.profile)}" onerror="this.style.display='none'">`
                            : `<i class="fa ${icon}"></i>`;
                        return `
                            <div class="notif-item ${n.isRead ? '' : 'unread'}">
                                <div class="notif-icon">${avatarImg}</div>
                                <div class="notif-content">
                                    <div>${esc(n.content)}</div>
                                    <div class="notif-time">${timeAgo(n.createdAt)}</div>
                                </div>
                            </div>
                        `;
                    }).join('');

                    const pag = document.getElementById('notifPagination');
                    if (data.totalPages > 1) {
                        let html = '';
                        for (let i = 1; i <= data.totalPages; i++) {
                            html += `<button class="btn btn-sm ${i === page ? 'btn-warning' : 'btn-outline-secondary'}" onclick="window.__loadNotifPage(${i})">${i}</button>`;
                        }
                        pag.innerHTML = html;
                    } else {
                        pag.innerHTML = '';
                    }
                } else {
                    list.innerHTML = '<p class="text-center text-muted py-5">No notifications yet.</p>';
                    document.getElementById('notifPagination').innerHTML = '';
                }
            } catch (error) {
                console.error('Error loading notifications:', error);
                list.innerHTML = '<p class="text-center text-danger">Failed to load notifications</p>';
            }
        }
        window.__loadNotifPage = loadNotifications;

        document.getElementById('markAllReadBtn').addEventListener('click', async function() {
            const btn = this;
            btn.disabled = true;
            try {
                await fetch(`${API_BASE_URL}/markNotificationsRead`, {
                    credentials: 'same-origin',
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ my_user_id: MY_USER_ID })
                });
                loadNotifications(currentPage);
            } catch (error) {
                console.error('Error marking notifications read:', error);
            } finally {
                btn.disabled = false;
            }
        });

        loadNotifications(1);

        // ---- Announcements: POST /api/fetchPlatformNotification {start (0-based offset), limit} ----
        const ANN_LIMIT = 20;
        let annStart = 0;
        let annLoaded = false;
        // Only http(s) URLs and same-site paths become links (no javascript:, no //host).
        const safeLink = (u) => (typeof u === 'string' && /^(https?:\/\/|\/(?!\/))/i.test(u.trim()) ? u.trim() : '');

        function renderAnnouncement(a) {
            const link = safeLink(a.linkUrl);
            const external = /^https?:/i.test(link);
            return `
                <div class="ann-item">
                    <h5>${esc(a.title || 'Announcement')}${a.type && a.type !== 'announcement' ? `<span class="ann-type">${esc(a.type)}</span>` : ''}</h5>
                    <div class="ann-body">${esc(a.content || a.body || '')}</div>
                    ${link ? `<div style="margin-top:6px;"><a href="${esc(link)}"${external ? ' target="_blank" rel="noopener noreferrer"' : ''}>Learn more</a></div>` : ''}
                    <div class="notif-time">${esc(a.createdAt ? timeAgo(a.createdAt) : '')}</div>
                </div>`;
        }

        async function loadAnnouncements(reset) {
            const list = document.getElementById('annList');
            const more = document.getElementById('annMore');
            if (reset) { annStart = 0; list.innerHTML = '<p class="text-center text-muted">Loading announcements...</p>'; }
            more.disabled = true;
            try {
                const res = await fetch(`${API_BASE_URL}/fetchPlatformNotification`, {
                    credentials: 'same-origin',
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ start: annStart, limit: ANN_LIMIT })
                });
                const data = await res.json();
                const rows = data && data.status && Array.isArray(data.data) ? data.data : [];
                if (reset) list.innerHTML = '';
                if (!rows.length && annStart === 0) {
                    list.innerHTML = '<p class="text-center text-muted py-5">No announcements right now.</p>';
                } else {
                    // raw-ok: renderAnnouncement() passes every field through esc()
                    list.insertAdjacentHTML('beforeend', rows.map(renderAnnouncement).join(''));
                }
                annStart += rows.length;
                more.style.display = rows.length === ANN_LIMIT ? '' : 'none';
                annLoaded = true;
            } catch (error) {
                console.error('Error loading announcements:', error);
                if (reset) list.innerHTML = '<p class="text-center text-danger">Failed to load announcements</p>';
            } finally {
                more.disabled = false;
            }
        }
        document.getElementById('annMore').addEventListener('click', function () { loadAnnouncements(false); });

        function selectTab(name) {
            const ann = name === 'announcements';
            document.getElementById('tabActivity').setAttribute('aria-selected', String(!ann));
            document.getElementById('tabAnnouncements').setAttribute('aria-selected', String(ann));
            document.getElementById('panelActivity').hidden = ann;
            document.getElementById('panelAnnouncements').hidden = !ann;
            document.getElementById('markAllReadBtn').style.visibility = ann ? 'hidden' : '';
            if (ann && !annLoaded) loadAnnouncements(true);
            if (history.replaceState) history.replaceState(null, '', ann ? '#announcements' : window.location.pathname);
        }
        document.getElementById('tabActivity').addEventListener('click', function () { selectTab('activity'); });
        document.getElementById('tabAnnouncements').addEventListener('click', function () { selectTab('announcements'); });
        if (window.location.hash === '#announcements') selectTab('announcements');
    });
    </script>
</body>
</html>
