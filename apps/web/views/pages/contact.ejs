    <!-- END -->
    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    
    <!-- Contact Form Script -->
    <%- include('../partials/scripts') %>
<script>
// Deferred bundle (partials/scripts.ejs): page code runs once the DOM and the deferred scripts are ready.
document.addEventListener('DOMContentLoaded', function () {
    $(document).ready(function() {
        const API_URL = 'https://api.banjaramatch.com';
        
        $('#contactForm').on('submit', async function(e) {
            e.preventDefault();
            
            const submitBtn = $('#submitBtn');
            const alertDiv = $('#contactAlert');
            
            // Honeypot (D5.42): bots fill the hidden "website" field; show success and send nothing.
            if ($('#contactWebsite').val()) {
                showAlert('Thank you! Your enquiry has been submitted successfully.', 'success');
                $('#contactForm')[0].reset();
                return;
            }

            // Get form data
            const formData = {
                name: $('#name').val().trim(),
                email: $('#email').val().trim(),
                phone: $('#phone').val().trim(),
                message: $('#message').val().trim(),
                website: ''
            };
            
            // Validation
            if (!formData.name || !formData.email || !formData.phone || !formData.message) {
                showAlert('Please fill in all fields', 'danger');
                return;
            }
            
            // Email validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(formData.email)) {
                showAlert('Please enter a valid email address', 'danger');
                return;
            }
            
            // Phone validation (10 digits)
            const cleanPhone = formData.phone.replace(/\D/g, '');
            if (cleanPhone.length !== 10) {
                showAlert('Please enter a valid 10-digit phone number', 'danger');
                return;
            }
            
            // Disable submit button
            submitBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Sending...');
            
            try {
                const response = await fetch(`${API_URL}/api/contact/submit`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showAlert(data.message || 'Thank you! Your enquiry has been submitted successfully. We will contact you soon.', 'success');
                    $('#contactForm')[0].reset();
                    
                    // Track with Google Analytics
                    if (typeof gtag !== 'undefined') {
                        gtag('event', 'contact_form_submission', {
                            'event_category': 'engagement',
                            'event_label': 'contact_form'
                        });
                    }
                } else {
                    showAlert(data.message || 'Failed to submit enquiry. Please try again.', 'danger');
                }
            } catch (error) {
                console.error('Contact form error:', error);
                showAlert('Something went wrong. Please try again later.', 'danger');
            } finally {
                submitBtn.prop('disabled', false).html('<i class="fa fa-paper-plane"></i> Send Enquiry');
            }
        });
        
        function showAlert(message, type) {
            const alertDiv = $('#contactAlert');
            alertDiv.removeClass('alert-success alert-danger alert-warning');
            alertDiv.addClass(`alert-${type}`);
            alertDiv.html(message);
            alertDiv.fadeIn();
            
            setTimeout(() => {
                alertDiv.fadeOut();
            }, 5000);
        }
    });
    
  window.showAlert = showAlert;
});
</script>
</body>


</html>