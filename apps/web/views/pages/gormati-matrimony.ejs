          <button class="gm-faq-btn" onclick="gfaq(this)"><span>How are gotra rules handled in Gormati matrimony?</span><span class="gm-faq-icon">+</span></button>
          <div class="gm-faq-body"><p>In Gormati/Banjara tradition, marriage within the same gotra is strictly prohibited. BanjaraMatch includes gotra as a mandatory profile field and matching filter. <a href="/banjara-gotra-list" style="color:#2e8b57;">See our complete Banjara gotra list and marriage rules.</a></p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="gm-cta-banner">
    <div class="container">
      <h2>Ready to Find Your Gormati Life Partner?</h2>
      <p>Join thousands of Gormati/Banjara community members on BanjaraMatch — free forever.</p>
      <a href="/register" class="gm-cta-yellow">Register Free Now →</a>
    </div>
  </section>

  <% if (featuredBlogs && featuredBlogs.length > 0) { %>
  <section class="gm-section">
    <div class="container">
      <div class="text-center mb-4">
        <div class="gm-eyebrow">Articles</div>
        <h2 class="gm-heading" style="text-align:center;">Banjara &amp; Gormati Community Blog</h2>
      </div>
      <div class="row">
        <% featuredBlogs.forEach(blog => { %>
        <div class="col-md-4 mb-4">
          <div style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.08);height:100%;">
            <% if (blog.image) { %><img src="<%= blog.image %>" alt="<%= blog.title %>" style="width:100%;height:180px;object-fit:cover;" loading="lazy"><% } %>
            <div style="padding:20px;">
              <span style="background:#edf8f0;color:#2e8b57;padding:3px 10px;border-radius:12px;font-size:12px;font-weight:600;"><%= blog.category %></span>
              <h4 style="font-size:16px;font-weight:700;margin:12px 0 8px;color:#0c3a1a;line-height:1.4;"><%= blog.title %></h4>
              <p style="font-size:13px;color:#777;line-height:1.6;margin-bottom:14px;"><%= (blog.excerpt || '').substring(0,100) %>...</p>
              <a href="/blogs/<%= blog.category.toLowerCase() %>/<%= blog.slug %>" style="color:#2e8b57;font-weight:600;font-size:13px;text-decoration:none;">Read More →</a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <div class="text-center mt-2"><a href="/blogs" style="color:#2e8b57;font-weight:600;font-size:15px;text-decoration:none;">View All Articles →</a></div>
    </div>
  </section>
  <% } %>

  <%- include('../partials/footer') %>
  <script defer src="/js/jquery.min.js"></script>
  <script defer src="/js/popper.min.js"></script>
  <script defer src="/js/bootstrap.min.js"></script>
  <script defer src="/js/select-opt.min.js"></script>
  <script defer src="/js/slick.min.js"></script>
  <script defer src="/js/custom.min.js"></script>
  <script>
    function gfaq(btn) {
      const item = btn.closest('.gm-faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.gm-faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }
  </script>
</body>
</html>
