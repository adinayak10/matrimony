<!doctype html>
<html lang="<%= site.lang %>">
<head>
<%- include('../partials/head') %>
<%
  // Locals (routes/biodata.js /biodata-maker/s/:token): shared ({title, expiresAt, lang} or null
  // for a bad, expired or turned-off link), token, srcdoc (the kit preview document).
  // The biodata renders in a sandboxed iframe (scripts on, opaque origin: no cookies, no access
  // to this page); srcdoc is escaped as an attribute value, so no raw output is needed.
  const _exp = shared && shared.expiresAt ? new Date(shared.expiresAt) : null;
  const _expText = _exp && !isNaN(_exp) ? _exp.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
%>
</head>

<body class="bdp-body">
  <%- include('../partials/header') %>
  <%- include('../partials/breadcrumb') %>

  <main class="bdp">
    <section class="bdp-section is-tight">
      <div class="bdp-wrap" style="max-width:940px">
        <% if (shared) { %>
        <div class="bdp-share-bar" data-bdp-share-view>
          <div>
            <h1><%= shared.title %></h1>
            <p>Shared privately<%= _expText ? ' · link valid until ' + _expText : '' %></p>
          </div>
          <div class="bdp-btns">
            <a class="bdp-btn bdp-btn-primary bdp-btn-sm" href="/api/biodata/shared/<%= token %>/pdf" data-action="pdf" download><i class="fa fa-download" aria-hidden="true"></i> Download PDF</a>
            <button type="button" class="bdp-btn bdp-btn-outline bdp-btn-sm" data-action="print"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
          </div>
        </div>
        <div class="bdp-paper">
          <iframe id="bdpShareFrame" title="Marriage biodata: <%= shared.title %>" sandbox="allow-scripts allow-modals" referrerpolicy="no-referrer" loading="eager" srcdoc="<%= srcdoc %>"></iframe>
        </div>
        <% } else { %>
        <div class="bdp-empty">
          <i class="fa fa-chain-broken" aria-hidden="true"></i>
          <h1 style="font-size:24px;margin:0 0 8px">This biodata link is not available</h1>
          <p>The link may have expired, been turned off by its owner, or been typed incorrectly. Ask the person who sent it for a new link.</p>
        </div>
        <% } %>

        <div class="bdp-made">
          <div>
            <b>Made with the BanjaraMatch Biodata Maker</b>
            <p>Free marriage biodata templates with live preview and PDF download.</p>
          </div>
          <a class="bdp-btn bdp-btn-primary bdp-btn-sm" href="/biodata-maker">Make your own biodata</a>
        </div>
      </div>
    </section>
    <div class="bdp-toast" id="bdpToast" role="status" aria-live="polite"></div>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
