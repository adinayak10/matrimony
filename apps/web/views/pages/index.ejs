        document.addEventListener('DOMContentLoaded', function() {
            var track = document.getElementById('featTrack');
            var wrap = track && track.parentElement;
            if (!track || !wrap) return;

            if (track.dataset.carouselReady === 'true') return;
            track.dataset.carouselReady = 'true';

            var originalCards = track.innerHTML;
            track.innerHTML += originalCards;

            var speed = window.innerWidth < 768 ? 0.35 : 0.6;
            var pos = 0;
            var totalW = 0;
            var isDragging = false;
            var dragStartX = 0;
            var dragStartPos = 0;
            var animFrame;

            function measure() {
                totalW = track.scrollWidth / 2;
            }

            function paint() {
                track.style.transform = 'translateX(-' + pos + 'px)';
            }

            function autoScroll() {
                if (!totalW) measure();
                if (!isDragging && totalW > 0) {
                    pos += speed;
                    if (pos >= totalW) pos -= totalW;
                    paint();
                }
                animFrame = requestAnimationFrame(autoScroll);
            }

            requestAnimationFrame(function() {
                measure();
                paint();
                animFrame = requestAnimationFrame(autoScroll);
            });

            track.addEventListener('mousedown', function(e) {
                isDragging = true;
                dragStartX = e.clientX;
                dragStartPos = pos;
                track.style.cursor = 'grabbing';
            });

            document.addEventListener('mousemove', function(e) {
                if (!isDragging || !totalW) return;
                var dx = dragStartX - e.clientX;
                pos = dragStartPos + dx;
                while (pos < 0) pos += totalW;
                while (pos >= totalW) pos -= totalW;
                paint();
            });

            document.addEventListener('mouseup', function() {
                isDragging = false;
                track.style.cursor = 'grab';
            });

            track.addEventListener('touchstart', function(e) {
                isDragging = true;
                dragStartX = e.touches[0].clientX;
                dragStartPos = pos;
            }, { passive: true });

            track.addEventListener('touchmove', function(e) {
                if (!isDragging || !totalW) return;
                var dx = dragStartX - e.touches[0].clientX;
                pos = dragStartPos + dx;
                while (pos < 0) pos += totalW;
                while (pos >= totalW) pos -= totalW;
                paint();
            }, { passive: true });

            track.addEventListener('touchend', function() {
                isDragging = false;
            });

            window.addEventListener('resize', function() {
                speed = window.innerWidth < 768 ? 0.35 : 0.6;
                measure();
                if (totalW > 0 && pos >= totalW) pos = pos % totalW;
                paint();
            });
        });
  </script>
</section>
<%# END AI FEATURES CAROUSEL %>


