    <%# Optional JavaScript - Optimized Loading %>
    <%# jQuery first, then Popper.js, then Bootstrap JS %>
    
    <%# Preconnect Optimization %>
    <%- include('../partials/scripts') %>
<script>
      // Guests: the hero search goes to /register?next=<encoded /all-profiles?...> (D5.41).
      (function () {
        var form = document.querySelector('form.hero-search[data-guest="1"]');
        if (!form) return;
        form.addEventListener('submit', function (e) {
          var qs = new URLSearchParams();
          ['gender', 'age', 'maritalStatus', 'city', 'state'].forEach(function (name) {
            var el = form.elements[name];
            if (el && el.value) qs.set(name, el.value);
          });
          var next = '/all-profiles' + (qs.toString() ? '?' + qs.toString() : '');
          e.preventDefault();
          location.href = '/register?next=' + encodeURIComponent(next);
        });
      })();
      // Defer non-critical resource loading
      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() {
          // Lazy load non-critical images
          var lazyImages = document.querySelectorAll('img[loading="lazy"]');
          if ('IntersectionObserver' in window) {
            var imageObserver = new IntersectionObserver(function(entries) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                  var img = entry.target;
                  if (img.dataset.src) {
                    img.src = img.dataset.src;
                    img.removeAttribute('data-src');
                  }
                  imageObserver.unobserve(img);
                }
              });
            });
            lazyImages.forEach(function(img) { imageObserver.observe(img); });
          }
        });
      }
    </script>

    <%# Dynamic City Loading for Better User Engagement %>
        <script>
// Deferred bundle (partials/scripts.ejs): page code runs once the DOM and the deferred scripts are ready.
document.addEventListener('DOMContentLoaded', function () {
            window.addEventListener('load', function() {
                var loadCities = function() {
        // Fetch cities via same-origin proxy to avoid CORS issues
        fetch('/api/proxy/cities', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            search: '',
            limit: 1000,
            page: 1
          })
        })
        .then(response => response.json())
        .then(result => {
          if (result.status && result.data && result.data.length > 0) {
            const citySelect = document.querySelector('select[name="city"]');
            if (citySelect) {
              // Keep the default options
              const defaultOptions = `
                <option value="">Any location</option>
              `;
              
              // Add all cities from API
              const cityOptions = result.data
                .sort((a, b) => a.name.localeCompare(b.name))
                .map(city => `<option value="${esc(city.name)}">${esc(city.name)}</option>`)
                .join('');
              
              citySelect.innerHTML = defaultOptions + cityOptions;
              
              // Reinitialize chosen plugin if it exists
              if (typeof jQuery !== 'undefined' && jQuery(citySelect).data('chosen')) {
                jQuery(citySelect).trigger('chosen:updated');
              }
              
              console.log(`✓ Loaded ${result.data.length} cities for location search`);
            }
          }
        })
        .catch(error => {
          console.error('Error loading cities:', error);
          // Keep default cities if API fails
        });

                };

                if ('requestIdleCallback' in window) {
                    requestIdleCallback(loadCities, { timeout: 2500 });
                } else {
                    setTimeout(loadCities, 1500);
                }
      });
    });
</script>
