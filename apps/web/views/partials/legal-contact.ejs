<%#
  The one contact block for the legal pages (D2.23): privacy-policy,
  terms-conditions, child-safety-policy, account-deletion. Facts come from
  config/site.js; nothing is printed that the owner has not supplied. No phone.
    include('../partials/legal-contact')
%>
<% const _lc = (typeof site !== 'undefined' && site) || {}; const _email = _lc.supportEmail || 'info@banjaramatch.com'; %>
<address class="legal-contact" style="font-style:normal">
  <p><strong>Contact:</strong> <a href="mailto:<%= _email %>"><%= _email %></a></p>
  <% if (_lc.legalEntity) { %><p><strong>Operated by:</strong> <%= _lc.legalEntity %></p><% } %>
  <% if (_lc.address) { %><p><strong>Registered address:</strong> <%= _lc.address %></p><% } %>
  <% if (_lc.grievanceOfficer && _lc.grievanceOfficer.name) { %>
  <p><strong>Grievance Officer (IT Rules 2021):</strong> <%= _lc.grievanceOfficer.name %><% if (_lc.grievanceOfficer.email) { %>, <a href="mailto:<%= _lc.grievanceOfficer.email %>"><%= _lc.grievanceOfficer.email %></a><% } %></p>
  <% } else { %>
  <p><strong>Grievance Officer:</strong> to be appointed. Until then, write to <a href="mailto:<%= _email %>"><%= _email %></a> with "Grievance" in the subject line.</p>
  <% } %>
  <p>Account and data deletion requests: <a href="/account-deletion">/account-deletion</a> or email <a href="mailto:<%= _email %>"><%= _email %></a>.</p>
</address>
