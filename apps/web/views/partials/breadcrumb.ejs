<%#
  Breadcrumb trail + BreadcrumbList JSON-LD (D3.25). Include with
  `breadcrumbs: [{ name, url }, ...]` from the route; Home is prepended here,
  so a route (or the regional API's page.breadcrumbs) that already starts with
  Home is not listed twice. Renders nothing without crumbs. The JSON-LD is the
  only BreadcrumbList on a page: templates carry no copies of their own.
  Styles live in public/css/style.css (.breadcrumb-section).
%>
<%
  const _given = Array.isArray(locals.breadcrumbs) ? locals.breadcrumbs.filter((c) => c && c.name) : [];
  const _crumbs = _given.length && _given[0].url === '/' ? _given.slice(1) : _given;
  const _siteUrl = (typeof site !== 'undefined' && site && site.url) || 'https://www.banjaramatch.com';
  const _absUrl = (u) => (!u ? '' : /^https?:\/\//i.test(u) ? u : _siteUrl + (String(u).startsWith('/') ? u : '/' + u));
%>
<% if (_crumbs.length) { %>
<section class="breadcrumb-section">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><i class="fa fa-home" aria-hidden="true"></i> Home</a></li>
        <% _crumbs.forEach((crumb, index) => { const last = index === _crumbs.length - 1; %>
        <li class="breadcrumb-item<%= last ? ' active' : '' %>"<% if (last) { %> aria-current="page"<% } %>>
          <% if (last || !crumb.url) { %><span><%= crumb.name %></span><% } else { %><a href="<%= crumb.url %>"><%= crumb.name %></a><% } %>
        </li>
        <% }); %>
      </ol>
    </nav>
  </div>
</section>
<%- jsonLd({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: _siteUrl + '/' },
    ..._crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: crumb.name,
      ...(crumb.url ? { item: _absUrl(crumb.url) } : {}),
    })),
  ],
}) %>
<% } %>
