<!-- BREADCRUMB NAVIGATION (SEO & UX) -->
<% 
// Breadcrumb configuration based on page type
const breadcrumbs = locals.breadcrumbs || [];
const showBreadcrumbs = breadcrumbs && breadcrumbs.length > 0;
%>

<% if (showBreadcrumbs) { %>
<section class="breadcrumb-section" style="background: #f8f9fa; padding: 15px 0; border-bottom: 1px solid #e9ecef;">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb" style="background: transparent; margin-bottom: 0; padding: 0; font-size: 14px;" itemscope itemtype="https://schema.org/BreadcrumbList">
            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="/" itemprop="item" style="color: #667eea; text-decoration: none;">
                <i class="fa fa-home" aria-hidden="true"></i>
                <span itemprop="name">Home</span>
              </a>
              <meta itemprop="position" content="1" />
            </li>
            
            <% breadcrumbs.forEach((crumb, index) => { %>
              <li class="breadcrumb-item <%= index === breadcrumbs.length - 1 ? 'active' : '' %>" 
                  itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"
                  <%= index === breadcrumbs.length - 1 ? 'aria-current="page"' : '' %>>
                <% if (index === breadcrumbs.length - 1) { %>
                  <span itemprop="name" style="color: #6c757d;"><%= crumb.name %></span>
                <% } else { %>
                  <a href="<%= crumb.url %>" itemprop="item" style="color: #667eea; text-decoration: none;">
                    <span itemprop="name"><%= crumb.name %></span>
                  </a>
                <% } %>
                <meta itemprop="position" content="<%= index + 2 %>" />
              </li>
            <% }) %>
          </ol>
        </nav>
      </div>
    </div>
  </div>
</section>

<!-- Schema.org BreadcrumbList JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.banjaramatch.com/"
    }<% breadcrumbs.forEach((crumb, index) => { %>,
    {
      "@type": "ListItem",
      "position": <%= index + 2 %>,
      "name": "<%= crumb.name %>",
      "item": "https://www.banjaramatch.com<%= crumb.url %>"
    }<% }) %>
  ]
}
</script>
<% } %>

<style>
.breadcrumb-item + .breadcrumb-item::before {
  content: "›";
  color: #999;
  padding: 0 8px;
}
.breadcrumb-item a:hover {
  color: #f6af04 !important;
  text-decoration: underline;
}
.breadcrumb-item.active {
  color: #6c757d;
}
</style>
