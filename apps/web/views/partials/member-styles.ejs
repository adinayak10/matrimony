<%# Shared styles for the member pages: match chips, verify CTA, status badges, small cards. Include inside <head> after head.ejs. %>
<style>
    .bm-match-chip { display:inline-block; background:#fff4d6; color:#8a5a00; border:1px solid #f6d27a; font-size:11px; font-weight:700; padding:1px 8px; border-radius:10px; margin-top:4px; }
    .bm-matched-on { display:flex; flex-wrap:wrap; gap:4px; margin-top:4px; }
    .bm-matched-on span { background:#eef6ee; color:#2e6b30; font-size:10.5px; padding:1px 7px; border-radius:9px; text-transform:capitalize; }
    .bm-verify-cta { display:flex; align-items:center; gap:12px; background:#eef7ff; border:1px solid #cfe3f7; color:#1d4f7a; border-radius:10px; padding:12px 14px; margin-bottom:16px; text-decoration:none; }
    .bm-verify-cta:hover { background:#e2f0fd; color:#163e60; text-decoration:none; }
    .bm-verify-cta .fa { font-size:22px; }
    .bm-verify-cta small { color:#4d6f8c; }
    .bm-badge { display:inline-flex; align-items:center; gap:4px; font-size:12px; font-weight:600; padding:2px 10px; border-radius:12px; }
    .bm-badge-ok { background:#e8f5e9; color:#2e7d32; }
    .bm-badge-wait { background:#fff8e1; color:#8d6e00; }
    .bm-badge-bad { background:#fdecea; color:#b3261e; }
    .bm-badge-none { background:#f1f1f1; color:#555; }
    .bm-card { background:#fff; border:1px solid #eee; border-radius:10px; padding:18px 20px; margin-bottom:18px; box-shadow:0 1px 4px rgba(0,0,0,.04); }
    .bm-card h3 { font-size:17px; font-weight:700; margin:0 0 10px; }
    .bm-muted { color:#777; font-size:13px; }
    .bm-empty { text-align:center; padding:50px 20px; color:#777; }
    .bm-empty .fa { font-size:44px; color:#ddd; display:block; margin-bottom:12px; }
    .bm-form .form-group { margin-bottom:14px; }
    .bm-form label { font-weight:600; font-size:13px; margin-bottom:4px; display:block; }
    .bm-alert { border-radius:8px; padding:10px 14px; margin-bottom:14px; font-size:14px; display:none; }
    .bm-alert.show { display:block; }
    .bm-alert-ok { background:#e8f5e9; color:#1b5e20; }
    .bm-alert-err { background:#fdecea; color:#8c1d18; }
    .bm-switch { display:inline-flex; align-items:center; gap:6px; cursor:pointer; font-size:13px; }
    .bm-btn-row { display:flex; flex-wrap:wrap; gap:8px; }
    .bm-btn-sm { font-size:12.5px; padding:5px 12px; border-radius:6px; border:1px solid #ddd; background:#fff; cursor:pointer; color:#333; text-decoration:none; }
    .bm-btn-sm:hover { background:#f6f6f6; color:#111; text-decoration:none; }
    .bm-btn-primary { background:#f6af04; border-color:#f6af04; color:#000; font-weight:600; }
    .bm-btn-primary:hover { background:#e09e00; color:#000; }
    .bm-btn-danger { color:#b3261e; border-color:#f1c4c0; }
</style>
