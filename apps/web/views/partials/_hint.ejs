<%# One resource hint from meta.hints: { rel: 'preload', href, as, type, crossorigin, fetchpriority, imagesrcset, imagesizes } %>
<link rel="<%= h.rel || 'preload' %>" href="<%= h.href %>"<% if (h.as) { %> as="<%= h.as %>"<% } %><% if (h.type) { %> type="<%= h.type %>"<% } %><% if (h.crossorigin) { %> crossorigin<% } %><% if (h.fetchpriority) { %> fetchpriority="<%= h.fetchpriority %>"<% } %><% if (h.imagesrcset) { %> imagesrcset="<%= h.imagesrcset %>"<% } %><% if (h.imagesizes) { %> imagesizes="<%= h.imagesizes %>"<% } %>>
