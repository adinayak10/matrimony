<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-XXXXXXX');</script>
-->

<% } else { %>
<!-- Google Analytics NOT Enabled -->
<!-- 
  Reasons:
  1. Not in production environment (NODE_ENV !== 'production')
  2. GA4_MEASUREMENT_ID not configured (still set to placeholder)
  
  To enable:
  1. Set environment variable: GA4_MEASUREMENT_ID=G-YOUR-ACTUAL-ID
  2. Or set: ENABLE_ANALYTICS=true (for testing)
  3. Deploy to production
-->
<% if (DEBUG_MODE) { %>
<script>
  console.warn('⚠️ Google Analytics disabled');
  console.warn('Set GA4_MEASUREMENT_ID environment variable to enable');
  
  // Mock tracking functions for development
  window.trackEvent = function(eventName, eventParams) {
    console.log('[DEV] Track Event:', eventName, eventParams);
  };
  window.trackCTA = function(ctaName, ctaLocation) {
    console.log('[DEV] Track CTA:', ctaName, ctaLocation);
  };
  window.trackProfileView = function(profileId, profileGender) {
    console.log('[DEV] Track Profile View:', profileId, profileGender);
  };
  window.trackInterestSent = function(profileId) {
    console.log('[DEV] Track Interest:', profileId);
  };
  window.trackShare = function(platform, url) {
    console.log('[DEV] Track Share:', platform, url);
  };
  window.trackSearch = function(searchTerm, searchCategory) {
    console.log('[DEV] Track Search:', searchTerm, searchCategory);
  };
  window.trackFormSubmit = function(formName, formSuccess) {
    console.log('[DEV] Track Form:', formName, formSuccess);
  };
  window.trackOutboundLink = function(url, linkText) {
    console.log('[DEV] Track Outbound:', url, linkText);
  };
  window.trackDownload = function(fileName, fileType) {
    console.log('[DEV] Track Download:', fileName, fileType);
  };
  window.trackError = function(errorType, errorMessage) {
    console.log('[DEV] Track Error:', errorType, errorMessage);
  };
  window.trackVideoPlay = function(videoTitle, videoUrl) {
    console.log('[DEV] Track Video:', videoTitle, videoUrl);
  };
  window.trackProductView = function(productId, productName, productPrice) {
    console.log('[DEV] Track Product View:', productId, productName, productPrice);
  };
  window.trackPurchase = function(transactionId, value, items) {
    console.log('[DEV] Track Purchase:', transactionId, value, items);
  };
</script>
<% } %>
<% } %>

