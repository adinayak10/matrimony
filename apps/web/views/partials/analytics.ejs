<%#
  Google Analytics 4 + Google Ads conversion tag (config/site.js -> site.analytics).
  Loaded async, after the Consent Mode defaults that partials/head.ejs sets
  (denied until accepted when REQUIRE_COOKIE_CONSENT=1). Rendered only in
  production (or ENABLE_ANALYTICS=true) with a real GA4_MEASUREMENT_ID;
  ENABLE_ANALYTICS=false switches it off everywhere.
  The privacy policy (section "Analytics and advertising") describes exactly
  what this file sends: keep the two in step.
%>
<%
  const _an = ((typeof site !== 'undefined' && site) || {}).analytics || {};
  const _debug = process.env.NODE_ENV !== 'production';
%>
<% if (_an.enabled) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= _an.ga4Id %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', <%- safeJson(_an.ga4Id) %>, {
    'anonymize_ip': true,
    'cookie_flags': 'SameSite=None;Secure',
    'send_page_view': true,
    'linker': { 'domains': ['www.banjaramatch.com', 'banjaramatch.com', 'api.banjaramatch.com'] },
    <% if (_debug) { %>'debug_mode': true,<% } %>
    'custom_map': { 'dimension1': 'user_type', 'dimension2': 'page_category' }
  });
  <% if (_an.adsId) { %>
  gtag('config', <%- safeJson(_an.adsId) %>, { 'allow_enhanced_conversions': true });
  <% } %>
  <% if (typeof user !== 'undefined' && user) { %>
  gtag('set', 'user_properties', { 'user_type': 'logged_in', 'user_id': <%- safeJson(String(user._id || '')) %> });
  <% } else { %>
  gtag('set', 'user_properties', { 'user_type': 'guest' });
  <% } %>
  <% if (typeof locals.pageCategory !== 'undefined' && locals.pageCategory) { %>
  gtag('event', 'page_view', { 'page_category': <%- safeJson(String(locals.pageCategory)) %> });
  <% } %>
  window.trackEvent = function(eventName, eventParams) { gtag('event', eventName, eventParams || {}); };
  window.trackShare = function(platform, url) {
    window.trackEvent('share', { 'event_category': 'social', 'method': platform, 'content_type': 'page', 'item_id': url || window.location.href });
  };
  window.trackError = function(errorType, errorMessage) {
    window.trackEvent('exception', { 'description': errorMessage, 'error_type': errorType, 'fatal': false });
  };
</script>
<% } else if (_debug) { %>
<script>
  window.trackEvent = function(n, p) { console.log('[DEV] Track Event:', n, p); };
  window.trackShare = function(platform, url) { console.log('[DEV] Track Share:', platform, url); };
  window.trackError = function(t, m) { console.log('[DEV] Track Error:', t, m); };
</script>
<% } %>
