<!-- Google Analytics 4 (GA4) -->
<!-- 
  IMPORTANT: Replace 'G-XXXXXXXXXX' with your actual GA4 Measurement ID
  Get your ID from: https://analytics.google.com/
  Format: G-XXXXXXXXXX (for GA4) or UA-XXXXXXXX-X (for Universal Analytics - legacy)
-->

<%
// Configuration - UPDATE THESE VALUES
const GA4_MEASUREMENT_ID = process.env.GA4_MEASUREMENT_ID || 'G-XXXXXXXXXX'; // TODO: Replace with actual ID
const ENABLE_ANALYTICS = process.env.NODE_ENV === 'production' || process.env.ENABLE_ANALYTICS === 'true';
const DEBUG_MODE = process.env.NODE_ENV !== 'production';
%>

<% if (ENABLE_ANALYTICS && GA4_MEASUREMENT_ID !== 'G-XXXXXXXXXX') { %>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= GA4_MEASUREMENT_ID %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  // Configure GA4
  gtag('config', '<%= GA4_MEASUREMENT_ID %>', {
    'anonymize_ip': true, // GDPR compliance - anonymize IP addresses
    'cookie_flags': 'SameSite=None;Secure', // Cookie security
    'send_page_view': true, // Automatic page view tracking
    'linker': {
      'domains': ['www.banjaramatch.com', 'banjaramatch.com', 'api.banjaramatch.com']
    },
    <% if (DEBUG_MODE) { %>
    'debug_mode': true, // Enable debug mode in development
    <% } %>
    // Custom dimensions (optional)
    'custom_map': {
      'dimension1': 'user_type', // Logged in vs Guest
      'dimension2': 'page_category' // Blog, Profile, Regional, etc.
    }
  });

  // Configure Google Ads
  gtag('config', 'AW-357336842', {
    'allow_enhanced_conversions': true
  });

  // Track user type (logged in or guest)
  <% if (typeof user !== 'undefined' && user) { %>
    gtag('set', 'user_properties', {
      'user_type': 'logged_in',
      'user_id': '<%= user._id %>' // User ID for cross-device tracking
    });
  <% } else { %>
    gtag('set', 'user_properties', {
      'user_type': 'guest'
    });
  <% } %>

  // Track page category for better segmentation
  <% if (typeof locals.pageCategory !== 'undefined') { %>
    gtag('event', 'page_view', {
      'page_category': '<%= locals.pageCategory %>'
    });
  <% } %>

  // Google Ads Conversion Tracking Function
  window.gtag_report_conversion = function(url) {
    var callback = function () {
      if (typeof(url) != 'undefined') {
        window.location = url;
      }
    };
    gtag('event', 'conversion', {
        'send_to': 'AW-357336842/3N9aCIbm68obEIqOsqoB',
        'event_callback': callback
    });
    return false;
  };

  // Helper function to track registration conversion
  window.trackRegistrationConversion = function() {
    // Send to Google Ads - First conversion action (Other conversion)
    gtag('event', 'conversion', {
      'send_to': 'AW-357336842/3N9aCIbm68obEIqOsqoB'
    });
    
    // Send to Google Ads - Form submission conversion action
    gtag('event', 'conversion', {
      'send_to': 'AW-357336842/q-YJCIvsq8obEIqOsqoB'
    });
    
    // Send to GA4 as form submission event
    gtag('event', 'generate_lead', {
      'event_category': 'form',
      'event_label': 'registration',
      'value': 1,
      'currency': 'INR'
    });
    
    // Also send as sign-up event for GA4
    gtag('event', 'sign_up', {
      'method': 'email'
    });
    
    console.log('✅ Registration conversion tracked (2 Google Ads + 2 GA4 events)');
  };
  
  // Custom event tracking functions (for use throughout the site)
  window.trackEvent = function(eventName, eventParams) {
    if (typeof gtag !== 'undefined') {
      gtag('event', eventName, eventParams || {});
      <% if (DEBUG_MODE) { %>
      console.log('GA Event:', eventName, eventParams);
      <% } %>
    }
  };

  // Track CTA clicks (Call-to-Action)
  window.trackCTA = function(ctaName, ctaLocation) {
    window.trackEvent('cta_click', {
      'event_category': 'engagement',
      'event_label': ctaName,
      'cta_location': ctaLocation
    });
  };

  // Track profile views
  window.trackProfileView = function(profileId, profileGender) {
    window.trackEvent('profile_view', {
      'event_category': 'profiles',
      'profile_id': profileId,
      'profile_gender': profileGender
    });
  };

  // Track interest/request sent
  window.trackInterestSent = function(profileId) {
    window.trackEvent('interest_sent', {
      'event_category': 'conversion',
      'profile_id': profileId,
      'value': 1 // Value for conversion tracking
    });
  };

  // Track social shares (already integrated in social-share.ejs)
  window.trackShare = function(platform, url) {
    window.trackEvent('share', {
      'event_category': 'social',
      'method': platform,
      'content_type': 'page',
      'item_id': url || window.location.href
    });
  };

  // Track search queries
  window.trackSearch = function(searchTerm, searchCategory) {
    window.trackEvent('search', {
      'event_category': 'engagement',
      'search_term': searchTerm,
      'search_category': searchCategory || 'general'
    });
  };

  // Track form submissions
  window.trackFormSubmit = function(formName, formSuccess) {
    window.trackEvent('form_submit', {
      'event_category': 'forms',
      'form_name': formName,
      'success': formSuccess
    });
  };

  // Track outbound links (external sites)
  window.trackOutboundLink = function(url, linkText) {
    window.trackEvent('click', {
      'event_category': 'outbound',
      'event_label': linkText,
      'transport_type': 'beacon',
      'target_url': url
    });
  };

  // Track downloads (PDFs, images, etc.)
  window.trackDownload = function(fileName, fileType) {
    window.trackEvent('file_download', {
      'event_category': 'downloads',
      'file_name': fileName,
      'file_type': fileType
    });
  };

  // Track errors (404, 500, etc.)
  window.trackError = function(errorType, errorMessage) {
    window.trackEvent('exception', {
      'description': errorMessage,
      'error_type': errorType,
      'fatal': false
    });
  };

  // Track video plays (if you add video content)
  window.trackVideoPlay = function(videoTitle, videoUrl) {
    window.trackEvent('video_play', {
      'event_category': 'engagement',
      'video_title': videoTitle,
      'video_url': videoUrl
    });
  };

  // Enhanced eCommerce tracking (for premium plans - future use)
  window.trackProductView = function(productId, productName, productPrice) {
    window.trackEvent('view_item', {
      'event_category': 'ecommerce',
      'items': [{
        'item_id': productId,
        'item_name': productName,
        'price': productPrice,
        'currency': 'INR'
      }]
    });
  };

  window.trackPurchase = function(transactionId, value, items) {
    window.trackEvent('purchase', {
      'event_category': 'ecommerce',
      'transaction_id': transactionId,
      'value': value,
      'currency': 'INR',
      'items': items
    });
  };

  <% if (DEBUG_MODE) { %>
  console.log('✅ Google Analytics initialized:', '<%= GA4_MEASUREMENT_ID %>');
  console.log('User Type:', '<%= typeof user !== "undefined" && user ? "Logged In" : "Guest" %>');
  <% } %>
</script>

<!-- Google Tag Manager (Optional - for advanced tracking) -->
