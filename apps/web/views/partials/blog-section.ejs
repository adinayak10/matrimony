<%#
  Blog cards for the content pages (D5.45). Include with
    include('../partials/blog-section', { sectionTitle: 'Latest Articles', blogs: featuredBlogs || [] })
  `blogs` come from GET /api/blogs/featured (featuredImage, description, author.name,
  category, slug). Nothing renders when there are no posts: no placeholder cards.
%>
<%
  const _posts = (Array.isArray(blogs) ? blogs : []).filter((b) => b && b.slug && b.title).slice(0, 3);
  const _img = (p) => (!p ? '' : /^https?:\/\//.test(p) ? p : '/' + String(p).replace(/^\/+/, ''));
  const _text = (b) => String(b.description || b.excerpt || '').replace(/<[^>]*>/g, '').trim();
%>
<% if (_posts.length) { %>
<section class="blog-section" style="padding: 60px 0; background: #f8f9fa;">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="head">
                    <h2><span><%= (typeof sectionTitle !== 'undefined' && sectionTitle) || 'Blog & Articles' %></span></h2>
                    <span class="leaf1"></span>
                    <span class="tit-ani-"></span>
                </div>
                <div class="blog">
                    <ul>
                        <% _posts.forEach((blog) => { const href = '/blogs/' + String(blog.category || 'general').toLowerCase() + '/' + blog.slug; %>
                            <li>
                                <div class="blog-box">
                                    <% if (blog.featuredImage || blog.image) { %>
                                    <a href="<%= href %>"><img src="<%= _img(blog.featuredImage || blog.image) %>" alt="<%= blog.title %>" loading="lazy" width="400" height="250"></a>
                                    <% } %>
                                    <span><%= blog.category || 'Blog' %><% if (blog.author && blog.author.name) { %> - <%= blog.author.name %><% } %></span>
                                    <h2><a href="<%= href %>"><%= blog.title %></a></h2>
                                    <% if (_text(blog)) { %><p><%= _text(blog).length > 140 ? _text(blog).slice(0, 140) + '…' : _text(blog) %></p><% } %>
                                    <a href="<%= href %>" class="cta-dark"><span>Read more</span></a>
                                </div>
                            </li>
                        <% }); %>
                    </ul>
                </div>
                <div class="cta-full-wid" style="text-align: center; margin-top: 30px;">
                    <a href="/blogs" class="cta">View all articles</a>
                </div>
            </div>
        </div>
    </div>
</section>
<% } %>
