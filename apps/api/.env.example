# apps/api - copy to .env for local runs. In production apps/api/.env is a
# symlink to /var/www/banjaramatch-shared/env/api.env (written by deploy.sh link_shared).

# Port the API listens on (pm2 sets 4002).
PORT=4002
# Bind address; keep loopback, nginx proxies to it. Always 127.0.0.1, never "localhost" (Node 22 resolves it to ::1).
HOST=127.0.0.1
# production | development | test (development echoes OTPs in responses).
NODE_ENV=production
# Mongo connection string; the db name is taken from the path.
MONGODB_URI=mongodb://127.0.0.1:27017/aasd
# Signs user and admin JWTs. 32+ random chars; identical value in apps/web/.env, never in admin.
JWT_SECRET=change-me-to-a-long-random-string
# Nodemailer transport (services/emailService.js).
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password
# Display name on outgoing mail.
EMAIL_FROM_NAME=Banjara Match
# Groq (AI gotra/clan suggestions in the admin panel). Empty disables the feature.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Agora voice/video call tokens (controllers/CallController.js).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Absolute path to the Firebase service-account JSON (mode 600, outside git).
FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/banjaramatch-shared/secrets/serviceAccountKey.json
# Directory the admin blog editor writes featured images into (served by www as /images/blog/*).
BLOG_IMAGE_DIR=/var/www/banjaramatch-shared/blog-images
# Web app base for server-side calls (services/sitemapService.js). Loopback in production.
FRONTEND_URL=http://127.0.0.1:4000
# Full URL the admin constants/AI-gotra controllers POST to after master-data changes.
SITEMAP_REGEN_URL=http://127.0.0.1:4000/api/regenerate-sitemap
# Git sha of the running release; set by deploy.sh/pm2, reported by GET /health.
RELEASE_SHA=
# comma-separated browser origins allowed by CORS
CORS_ORIGINS=https://www.banjaramatch.com,https://banjaramatch.com,https://admin.banjaramatch.com
# Firebase Web API key (Identity Toolkit) used by confirm-password-reset
FIREBASE_WEB_API_KEY=
# max interests a user may send per 24h
INTEREST_DAILY_CAP=20
# shared with web.env; sent as X-Sitemap-Secret on /api/regenerate-sitemap
SITEMAP_REGEN_SECRET=
# uploads root (defaults to <api>/uploads)
UPLOADS_DIR=
# tests only
MONGODB_URI_TEST=
RATE_LIMIT_TEST=
# set to false to skip index builds at boot (use until tools/cleanup/* have been applied)
MONGOOSE_AUTO_INDEX=true
# recipient of child-safety report alerts
SAFETY_ALERT_EMAIL=
SUPPORT_EMAIL=info@banjaramatch.com
UNSUBSCRIBE_URL=https://www.banjaramatch.com/contact
