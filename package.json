{
  "name": "banjaramatch",
  "version": "1.0.0",
  "private": true,
  "description": "banjaramatch.com monorepo: web (EJS), api (Express + socket.io), admin, Flutter app, deploy tooling",
  "workspaces": [
    "packages/shared",
    "apps/web",
    "apps/api",
    "apps/admin"
  ],
  "engines": {
    "node": ">=22.19 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -n web,api,admin -c blue,green,magenta \"npm:dev -w apps/web\" \"npm:dev -w apps/api\" \"npm:dev -w apps/admin\"",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:env": "node deploy/check-env.js",
    "check:urls": "bash deploy/check-urls.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9"
  }
}
